<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens: every colour the app uses, defined once per theme. Views and styles refer
       to these keys with DynamicResource only, so a theme switch repaints everything.
       Both dictionaries must define the same keys. -->
  <!-- Idle scrollbars: the thumb shrinks to this share of the bar until hovered. Fluent's
       default left a hairline; half the bar is visible without being heavy. -->
  <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.5)</TransformOperations>
  <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.5)</TransformOperations>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="SystemAccentColor">#3B5BDB</Color>
      <Color x:Key="SystemAccentColorDark1">#3451C7</Color>
      <Color x:Key="SystemAccentColorDark2">#2C46B0</Color>
      <Color x:Key="SystemAccentColorLight1">#4C6BE3</Color>
      <Color x:Key="SystemAccentColorLight2">#6681EA</Color>
      <SolidColorBrush x:Key="AccentFill" Color="#3B5BDB" />

      <SolidColorBrush x:Key="WindowBg" Color="#F3F4F6" />
      <SolidColorBrush x:Key="SidebarBg" Color="#E9EBEF" />
      <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
      <!-- Plain (secondary) buttons: the card's fill with a border, so they read as buttons, not as switched off. -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F1F3F6" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E6E9EE" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C9CED6" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#AEB5BF" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#AEB5BF" />
      <SolidColorBrush x:Key="CardBorder" Color="#D9DDE3" />
      <SolidColorBrush x:Key="Divider" Color="#E6E8EC" />
      <SolidColorBrush x:Key="SubtleBg" Color="#F6F7F9" />

      <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
      <SolidColorBrush x:Key="TextSecondary" Color="#4E5763" />
      <SolidColorBrush x:Key="TextMuted" Color="#6A737D" />
      <SolidColorBrush x:Key="Accent" Color="#3B5BDB" />
      <SolidColorBrush x:Key="LinkText" Color="#2343B8" />
      <!-- Drag to reorder: the slot a dragged row will land in, and the lifted copy's shadow. -->
      <SolidColorBrush x:Key="DropSlotBg" Color="#E6EBFD" />
      <BoxShadows x:Key="DragShadow">0 10 28 0 #33101828, 0 2 6 0 #1F101828</BoxShadows>

      <SolidColorBrush x:Key="NavHoverBg" Color="#DDE1E7" />
      <SolidColorBrush x:Key="NavSelectedBg" Color="#DCE3FB" />
      <!-- A value that just changed in Microsoft 365: a soft accent wash that fades (never a warning colour). -->
      <SolidColorBrush x:Key="FreshBg" Color="#D6E0FF" />
      <SolidColorBrush x:Key="NavSelectedFg" Color="#1E3A8A" />

      <SolidColorBrush x:Key="AvatarBg" Color="#DCE3FB" />
      <SolidColorBrush x:Key="AvatarFg" Color="#1E3A8A" />

      <SolidColorBrush x:Key="BadgeNeutralBg" Color="#E8EAED" />
      <SolidColorBrush x:Key="BadgeNeutralFg" Color="#3D4651" />
      <SolidColorBrush x:Key="BadgeInfoBg" Color="#E0EAFF" />
      <SolidColorBrush x:Key="BadgeInfoFg" Color="#1D46B8" />
      <SolidColorBrush x:Key="BadgeSuccessBg" Color="#DCF3E3" />
      <SolidColorBrush x:Key="BadgeSuccessFg" Color="#17602F" />
      <SolidColorBrush x:Key="BadgeWarningBg" Color="#FFF0D1" />
      <SolidColorBrush x:Key="BadgeWarningFg" Color="#7A4A00" />
      <SolidColorBrush x:Key="BadgeDangerBg" Color="#FDE2E1" />
      <SolidColorBrush x:Key="BadgeDangerFg" Color="#9F1C1C" />

      <SolidColorBrush x:Key="BannerErrorBg" Color="#FDE2E1" />
      <SolidColorBrush x:Key="BannerInfoBg" Color="#FFF5DB" />
      <SolidColorBrush x:Key="DangerFill" Color="#C42B1C" />

      <!-- Selected list rows: a soft tint, so link-coloured names stay readable on them. -->
      <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#DCE3FB" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#D0D9FA" />
      <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#E4E9FC" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#D7DFFA" />
      <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>

      <SolidColorBrush x:Key="ScrollThumb" Color="#B9BFC8" />
      <SolidColorBrush x:Key="ScrollThumbHover" Color="#8D95A1" />
      <SolidColorBrush x:Key="ScrollTrack" Color="#EEF0F3" />
      <x:Double x:Key="ScrollBarSize">10</x:Double>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- Filled accent surfaces (buttons, the logo tile) carry white text, so this is darker
           than the accent used for icons and links; white on it stays above 4.5:1. -->
      <Color x:Key="SystemAccentColor">#4A66D9</Color>
      <Color x:Key="SystemAccentColorDark1">#4560D0</Color>
      <Color x:Key="SystemAccentColorDark2">#3E58C2</Color>
      <Color x:Key="SystemAccentColorLight1">#4A66D9</Color>
      <Color x:Key="SystemAccentColorLight2">#4560D0</Color>
      <SolidColorBrush x:Key="AccentFill" Color="#4A66D9" />

      <SolidColorBrush x:Key="WindowBg" Color="#18191C" />
      <SolidColorBrush x:Key="SidebarBg" Color="#1F2024" />
      <SolidColorBrush x:Key="CardBg" Color="#24262B" />
      <!-- Plain (secondary) buttons: the card's fill with a border, so they read as buttons, not as switched off. -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#2B2E34" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33363D" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A3E46" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#454952" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5A5F6A" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5A5F6A" />
      <SolidColorBrush x:Key="CardBorder" Color="#363940" />
      <SolidColorBrush x:Key="Divider" Color="#2E3137" />
      <SolidColorBrush x:Key="SubtleBg" Color="#1D1F23" />

      <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED" />
      <SolidColorBrush x:Key="TextSecondary" Color="#B4BBC4" />
      <SolidColorBrush x:Key="TextMuted" Color="#959DA8" />
      <SolidColorBrush x:Key="Accent" Color="#7F9BFF" />
      <SolidColorBrush x:Key="LinkText" Color="#A8BCFF" />
      <SolidColorBrush x:Key="DropSlotBg" Color="#262E48" />
      <BoxShadows x:Key="DragShadow">0 12 32 0 #8C000000, 0 2 6 0 #66000000</BoxShadows>

      <SolidColorBrush x:Key="NavHoverBg" Color="#2A2C32" />
      <SolidColorBrush x:Key="NavSelectedBg" Color="#2D3755" />
      <SolidColorBrush x:Key="FreshBg" Color="#30406E" />
      <SolidColorBrush x:Key="NavSelectedFg" Color="#D0DBFF" />

      <SolidColorBrush x:Key="AvatarBg" Color="#34416A" />
      <SolidColorBrush x:Key="AvatarFg" Color="#E4EAFF" />

      <SolidColorBrush x:Key="BadgeNeutralBg" Color="#33363D" />
      <SolidColorBrush x:Key="BadgeNeutralFg" Color="#CDD2D9" />
      <SolidColorBrush x:Key="BadgeInfoBg" Color="#1F2D52" />
      <SolidColorBrush x:Key="BadgeInfoFg" Color="#A9C1FF" />
      <SolidColorBrush x:Key="BadgeSuccessBg" Color="#173A26" />
      <SolidColorBrush x:Key="BadgeSuccessFg" Color="#86E0A6" />
      <SolidColorBrush x:Key="BadgeWarningBg" Color="#3E2F10" />
      <SolidColorBrush x:Key="BadgeWarningFg" Color="#F4C46E" />
      <SolidColorBrush x:Key="BadgeDangerBg" Color="#47191C" />
      <SolidColorBrush x:Key="BadgeDangerFg" Color="#FFA3A3" />

      <SolidColorBrush x:Key="BannerErrorBg" Color="#47191C" />
      <SolidColorBrush x:Key="BannerInfoBg" Color="#3A2F14" />
      <SolidColorBrush x:Key="DangerFill" Color="#C42B1C" />

      <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#2B3552" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#323D5E" />
      <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#283048" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#2F3956" />
      <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>

      <SolidColorBrush x:Key="ScrollThumb" Color="#4A4F58" />
      <SolidColorBrush x:Key="ScrollThumbHover" Color="#6B717C" />
      <SolidColorBrush x:Key="ScrollTrack" Color="#202226" />
      <x:Double x:Key="ScrollBarSize">10</x:Double>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
