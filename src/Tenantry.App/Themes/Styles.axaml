<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Tenantry.App.Controls"
        xmlns:ic="using:FluentIcons.Avalonia">

  <Styles.Resources>
    <!-- The stock header reserves a slot for its own sort icon even when hidden. Sorting is drawn
         by our header content, so the slot only stole width and clipped the sort indicators. -->
    <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>

    <!-- The app's horizontal-scroll standard: the bar sits ABOVE what it scrolls, in its own
         row (never over the content), thin until hovered, and the row is only there when the
         content actually overflows. Same as the table's top scrollbar. Based on the Fluent
         ScrollViewer template (Avalonia 12.1.4); only the row order differs, and the content is
         never spanned under the bars. -->
    <ControlTheme x:Key="TopScrollViewer" TargetType="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
            <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4" />
            <ScrollContentPresenter Name="PART_ContentPresenter"
                                    Grid.Row="1" Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
              <ScrollContentPresenter.GestureRecognizers>
                <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                         CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                         IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"
                                         Offset="{Binding Offset, ElementName=PART_ContentPresenter}"
                                         Viewport="{Binding Viewport, ElementName=PART_ContentPresenter}"
                                         Extent="{Binding Extent, ElementName=PART_ContentPresenter}" />
              </ScrollContentPresenter.GestureRecognizers>
            </ScrollContentPresenter>
            <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Row="1" Grid.Column="1" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- One half of a two-part switch (inside Border.segmented). -->
    <ControlTheme x:Key="SegmentButton" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Segment" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style Selector="^:checked /template/ Border#Segment">
        <Setter Property="BoxShadow" Value="0 1 3 0 #26000000" />
      </Style>
    </ControlTheme>

    <!-- The stock DataGrid with its horizontal scrollbar moved ABOVE the column headers, so a wide list says it scrolls sideways before anyone reaches the bottom.
         Copied from Avalonia.Controls.DataGrid 12.1.2 Themes/Fluent.xaml (commit 1e12211);
         only the row layout differs. Shift+wheel and touchpad sideways scrolling
         come from DataGrid itself. Re-check against the source when upgrading the package. -->
    <ControlTheme x:Key="TopScrollDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="DataGridBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,*" ClipToBounds="True">
              <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto,*">
                <Rectangle Name="PART_FrozenColumnScrollBarSpacer" />
                <ScrollBar Name="PART_HorizontalScrollbar"
                           AllowAutoHide="{Binding Path=(ScrollViewer.AllowAutoHide), RelativeSource={RelativeSource TemplatedParent}}"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           Height="{DynamicResource ScrollBarSize}" />
              </Grid>

              <DataGridColumnHeader Name="PART_TopLeftCornerHeader" Grid.Row="1"
                                    Theme="{StaticResource DataGridTopLeftColumnHeader}" />
              <DataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter"
                                              Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" />
              <Rectangle Name="PART_ColumnHeadersAndRowsSeparator"
                         Grid.Row="1" Grid.ColumnSpan="3" Grid.Column="0"
                         VerticalAlignment="Bottom" Height="1"
                         Fill="{DynamicResource DataGridGridLinesBrush}" />

              <DataGridRowsPresenter Name="PART_RowsPresenter"
                                     Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                     ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                <DataGridRowsPresenter.GestureRecognizers>
                  <ScrollGestureRecognizer CanHorizontallyScroll="True"
                                           CanVerticallyScroll="True"
                                           IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_RowsPresenter}" />
                </DataGridRowsPresenter.GestureRecognizers>
              </DataGridRowsPresenter>
              <Rectangle Name="PART_BottomRightCorner" IsVisible="False" Grid.Column="2" Grid.Row="0" />
              <ScrollBar Name="PART_VerticalScrollbar"
                         AllowAutoHide="{Binding Path=(ScrollViewer.AllowAutoHide), RelativeSource={RelativeSource TemplatedParent}}"
                         Orientation="Vertical"
                         Grid.Column="2" Grid.Row="2"
                         Width="{DynamicResource ScrollBarSize}" />

              <Border x:Name="PART_DisabledVisualElement"
                      Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      CornerRadius="2"
                      Background="{DynamicResource DataGridDisabledVisualElementBackground}"
                      IsVisible="{Binding !$parent[DataGrid].IsEnabled}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <!-- Undo the stock theme's span of the rows presenter over the scrollbar rows. -->
      <Style Selector="^ /template/ DataGridRowsPresenter#PART_RowsPresenter">
        <Setter Property="Grid.RowSpan" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- Surfaces -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.card.tight">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.banner.error">
    <Setter Property="Background" Value="{DynamicResource BannerErrorBg}" />
  </Style>
  <Style Selector="Border.banner.info">
    <Setter Property="Background" Value="{DynamicResource BannerInfoBg}" />
  </Style>
  <Style Selector="Border.banner.warning">
    <Setter Property="Background" Value="{DynamicResource BadgeWarningBg}" />
  </Style>
  <Style Selector="Border.banner.warning > StackPanel > Grid > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BadgeWarningFg}" />
  </Style>
  <Style Selector="Border.banner.neutral">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
  </Style>
  <Style Selector="ProgressBar.storage">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ProgressBar.storage.full">
    <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFg}" />
  </Style>
  <Style Selector="Border.banner.success">
    <Setter Property="Background" Value="{DynamicResource BadgeSuccessBg}" />
  </Style>

  <!-- Bulk edit: each action is a full-width option; the chosen one is tinted. -->
  <Style Selector="RadioButton.bulkaction">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.bulkaction:pointerover">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>
  <Style Selector="RadioButton.bulkaction:checked">
    <Setter Property="Background" Value="{DynamicResource DropSlotBg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Editing: the Pending changes tray, pending values in place, and sign-in actions -->
  <Style Selector="Border.tray">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BoxShadow" Value="{DynamicResource DragShadow}" />
  </Style>
  <Style Selector="Border.pending">
    <Setter Property="Background" Value="{DynamicResource DropSlotBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="StackPanel.unavailable">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Border.licenserow">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.licenserow.pending">
    <Setter Property="Background" Value="{DynamicResource DropSlotBg}" />
  </Style>

  <!-- Selection panel: checked rows as removable chips; actions as rows that open in place. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3,4,3" />
  </Style>
  <Style Selector="Button.chipx">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.chipx:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>
  <Style Selector="TextBlock.value.mixed">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Border.bulkrow">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.bulkrow.open">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
  </Style>
  <Style Selector="Button.bulkhead">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.bulkhead:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>

  <!-- People picker: matches drop below the search box as a light, bordered list. -->
  <Style Selector="Border.pickresults">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #22000000" />
  </Style>
  <Style Selector="Button.pickrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.pickrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>

  <!-- A row of checkboxes (group roles, mailbox rights); tinted while a change is pending. -->
  <Style Selector="Border.togglerow">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Border.togglerow.pending">
    <Setter Property="Background" Value="{DynamicResource DropSlotBg}" />
  </Style>
  <Style Selector="CheckBox.pendingcheck">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFg}" />
  </Style>
  <Style Selector="TextBlock.pendingtext">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBlock.before">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>
  <Style Selector="Button.danger-outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeDangerFg}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFg}" />
  </Style>
  <Style Selector="Button.danger-outline.undo">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Divider}" />
  </Style>
  <Style Selector="Border.vdivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Divider}" />
  </Style>

  <!-- Type scale: one title per screen, section headings, body, secondary text, labels. -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.value, SelectableTextBlock.value">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="SelectableTextBlock.code">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Avatars: initials in a tinted circle. -->
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource AvatarBg}" />
  </Style>
  <Style Selector="Border.avatar > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AvatarFg}" />
  </Style>
  <Style Selector="Border.avatar.small">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Border.avatar.small > TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.avatar.large">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="32" />
  </Style>
  <Style Selector="Border.avatar.large > TextBlock">
    <Setter Property="FontSize" Value="22" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedFg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Fluent greys disabled items twice (its own disabled brush, then this opacity); a plain
       muted foreground keeps them clearly secondary but still readable. -->
  <Style Selector="ListBox.nav ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:disabled">
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.choice">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
  </Style>

  <!-- Quick-filter chips -->
  <Style Selector="Button.chip">
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.chip.selected">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedFg}" />
  </Style>
  <Style Selector="Button.chip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedFg}" />
  </Style>

  <!-- Tables -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Divider}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="Padding" Value="12,8,4,8" />
  </Style>
  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="DataGrid.compact DataGridRow">
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="DataGridRowGroupHeader">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="IsItemCountVisible" Value="True" />
  </Style>

  <!-- Scrollbars: thin, rounded, no arrow buttons, a soft track when expanded. Overrides the
       Fluent scrollbar's parts by name rather than replacing its template, so its auto-hide,
       panning and context menu keep working. -->
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton, ScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource ScrollThumb}" />
  </Style>
  <Style Selector="ScrollBar[IsExpanded=true] /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource ScrollThumb}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pressed /template/ Border">
    <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}" />
  </Style>
  <Style Selector="ScrollBar[IsExpanded=true] /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
    <Setter Property="Fill" Value="{DynamicResource ScrollTrack}" />
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="RadiusX" Value="5" />
    <Setter Property="RadiusY" Value="5" />
  </Style>

  <!-- Buttons by role -->
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- A saved view has unsaved changes: the Save view button says so. -->
  <Style Selector="Button.outline.attention">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerFill}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFill}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- A whole-row button in a list (the home page's tenants) -->
  <Style Selector="Button.listrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.listrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
  </Style>

  <!-- The list toolbar: one bar, borderless buttons, active ones tinted. "quiet" marks the
       display/output group so it reads as different from filtering and sorting. -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="Border.vsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,6" />
    <Setter Property="Background" Value="{DynamicResource CardBorder}" />
  </Style>
  <Style Selector="Button.tb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.tb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>
  <Style Selector="Button.tb.quiet">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.tb.active">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedFg}" />
  </Style>
  <Style Selector="Button.tb.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedFg}" />
  </Style>
  <!-- Child combinators (">") on purpose: a tooltip is a logical child of its button, so a
       descendant selector here hid the tooltip text too, leaving empty tooltip boxes. -->
  <Style Selector="Border.toolbar.narrow Button.tb.quiet > StackPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.count">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.count > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Filter pills and panels -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <Style Selector="Border.pill Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedFg}" />
  </Style>
  <Style Selector="Border.pill.sort">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
  </Style>
  <Style Selector="Border.pill.sort Button">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Panels (filter, sort, advanced, columns, views): a calm card with a header icon, a
       body, and a footer whose main action sits bottom right. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #1F000000" />
    <Setter Property="MaxWidth" Value="620" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.panel.wide">
    <Setter Property="MaxWidth" Value="980" />
  </Style>
  <!-- Height cap: a resource the list view updates with the window, so a panel's header and
       buttons always fit and only its middle scrolls. -->
  <Style Selector="Border.panel">
    <Setter Property="MaxHeight" Value="{DynamicResource PanelMaxHeight}" />
  </Style>
  <Style Selector="Grid.panelheader">
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>
  <Style Selector="Grid.panelfooter">
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>

  <!-- Menus: every dropdown and context menu shares one look. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="FlyoutPresenter.menu">
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Button.menurow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Button.menurow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>
  <Style Selector="Button.menurow.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
  </Style>
  <Style Selector="Border.menuicon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.menuicon > ic|FluentIcon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.activedot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- "More views" reads as a menu, not a view -->
  <Style Selector="Button.chip.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- Drag to reorder: a grip, the lifted row, and an accent line where it will land -->
  <Style Selector="Border.draghandle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
    <Setter Property="Padding" Value="2,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.draghandle > ic|FluentIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Border.draghandle:pointerover > ic|FluentIcon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.draghandle:pressed">
    <Setter Property="Cursor" Value="DragMove" />
  </Style>
  <!-- While a row is dragged its own slot stays behind as a tinted, outlined gap (DragReorder
       hides the row's content) and slides to where the row will land. -->
  <Style Selector="ContentPresenter.dragslot">
    <Setter Property="Background" Value="{DynamicResource DropSlotBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- The lifted copy that follows the pointer. -->
  <Style Selector="Border.dragghost">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{DynamicResource DragShadow}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Border.panelicon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.panelicon > ic|FluentIcon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.listbox">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.valuerow">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.valuerow:pointerover">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
  </Style>
  <Style Selector="Border.levelrow">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.groupbox">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!-- A two-part switch: "Show only these | Hide these", "A → Z | Z → A". -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <!-- Date presets as selectable chips -->
  <Style Selector="ListBox.chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedFg}" />
  </Style>

  <!-- The record name in a list's first column is the way in: it reads as a link. -->
  <Style Selector="Button.namelink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.namelink > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.namelink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.namelink:pointerover > TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Compact rows: one line, a smaller avatar, no subtitle. -->
  <Style Selector="DataGrid.compact TextBlock.subtitle">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGrid.compact Border.avatar.small">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="DataGrid.compact Border.avatar.small > TextBlock">
    <Setter Property="FontSize" Value="9" />
  </Style>
  <Style Selector="DataGrid.compact Grid.primarycell">
    <Setter Property="Margin" Value="12,2" />
  </Style>

  <!-- Very narrow toolbar: every tool shows just its icon (tooltips still name it). -->
  <Style Selector="Border.toolbar.tiny Button.tb > StackPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.rowaction">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.rowaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <!-- Header sort button: a padded, rounded hover area that sits flush with the header text
       (the negative margin cancels the padding, so the label stays where it was). -->
  <Style Selector="Button.header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="-8,0,0,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Button.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Border.sortpriority">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <!-- No cell padding: each cell template sets its own margins, and padding on top of them
       clipped narrow badges ("Membe"). -->
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Tabs -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,0" />
  </Style>

  <!-- Status pills -->
  <!-- Spinner: a quarter arc turning over a faint ring -->
  <Style Selector="Ellipse.spintrack">
    <Setter Property="Stroke" Value="{DynamicResource Divider}" />
    <Setter Property="StrokeThickness" Value="3" />
  </Style>
  <Style Selector="Arc.spinner">
    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <!-- Needs a RotateTransform set on the Arc itself (see StartingView). -->
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A spinning icon (syncing). Like the spinner, it needs a RotateTransform set on the icon
       itself: animating RenderTransform as transform operations throws "No animator". -->
  <Style Selector="ic|FluentIcon.spin">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The sidebar's sync step: two lines' room while busy (text anchored at the top). -->
  <Style Selector="TextBlock.syncstep.busy">
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- A thin moving bar under a status line while work runs. -->
  <Style Selector="ProgressBar.working">
    <Setter Property="IsIndeterminate" Value="True" />
    <!-- The moving part slides past the track's ends; clip it so it never runs under the button beside it. -->
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
  </Style>

  <!-- Main tabs: hidden while the area's list is the only page open -->
  <Style Selector="TabControl.liststrip /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Search everything: the sidebar button that looks like a search box, and the Ctrl+K palette -->
  <Style Selector="Button.searchall">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Button.searchall:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Border.backdrop">
    <Setter Property="Background" Value="#66000000" />
  </Style>
  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource DragShadow}" />
  </Style>
  <!-- A borderless text box, for inputs that sit inside their own framed area -->
  <Style Selector="TextBox.bare">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="0,6" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="c|Badge">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="9,2"
                HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                     FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
