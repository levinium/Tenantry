<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:wf="using:Tenantry.ViewModels.Workflows"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:views="using:Tenantry.App.Views"
             x:Class="Tenantry.App.App"
             Name="Tenantry"
             RequestedThemeVariant="Default">
  <!-- Record sections and editors, wherever they appear: a record page's tabs or a popup. -->
  <Application.DataTemplates>
    <DataTemplate DataType="rec:OverviewSection">
      <views:UserOverviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:AccountSection">
      <views:AccountSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:LicensesSection">
      <views:LicensesSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:PlannedSection">
      <views:PlannedSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:ResetPasswordViewModel">
      <views:ResetPasswordView />
    </DataTemplate>
    <DataTemplate DataType="rec:NewUserViewModel">
      <views:NewUserView />
    </DataTemplate>
    <DataTemplate DataType="rec:NewGroupViewModel">
      <views:NewGroupView />
    </DataTemplate>
    <DataTemplate DataType="rec:NewSiteViewModel">
      <views:NewSiteView />
    </DataTemplate>
    <DataTemplate DataType="rec:CaPolicyPreviewViewModel">
      <views:CaPolicyPreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:AppPreviewViewModel">
      <views:AppPreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:AuditRecordPreviewViewModel">
      <views:AuditRecordPreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:RiskPreviewViewModel">
      <views:RiskPreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:NewAppViewModel">
      <views:NewAppView />
    </DataTemplate>
    <DataTemplate DataType="rec:NewCaseViewModel">
      <views:NewCaseView />
    </DataTemplate>
    <DataTemplate DataType="rec:EdItemEditorViewModel">
      <views:EdItemEditorView />
    </DataTemplate>
    <DataTemplate DataType="rec:EdPurgeViewModel">
      <views:EdPurgeView />
    </DataTemplate>
    <DataTemplate DataType="rec:EdExportViewModel">
      <views:EdExportView />
    </DataTemplate>
    <DataTemplate DataType="rec:AppSection">
      <views:AppSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:RolePreviewViewModel">
      <views:RolePreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:CustomRoleEditorViewModel">
      <views:CustomRoleEditorView />
    </DataTemplate>
    <DataTemplate DataType="rec:RoleAssignmentsSection">
      <views:RoleAssignmentsSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:RolePermissionsSection">
      <views:RolePermissionsSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:RoleSettingsSection">
      <views:RoleSettingsSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:DeletedSitePreviewViewModel">
      <views:DeletedSitePreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:ImportUsersViewModel">
      <views:ImportUsersView />
    </DataTemplate>
    <DataTemplate DataType="rec:ImportMembersViewModel">
      <views:ImportMembersView />
    </DataTemplate>
    <DataTemplate DataType="rec:ConvertMailboxViewModel">
      <views:ConvertMailboxView />
    </DataTemplate>
    <DataTemplate DataType="rec:GroupPeopleEditor">
      <views:GroupPeopleEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="rec:DevicesSection">
      <views:DevicesSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:SecuritySection">
      <views:SecuritySectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:MailSection">
      <views:MailSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:SelectionPanelViewModel">
      <views:SelectionPanelView />
    </DataTemplate>
    <DataTemplate DataType="rec:GroupsAccessSection">
      <views:GroupsAccessSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:OneDriveSection">
      <views:OneDriveSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:ActivitySection">
      <views:ActivitySectionView />
    </DataTemplate>
    <DataTemplate DataType="wf:OffboardingViewModel">
      <views:OffboardingView />
    </DataTemplate>
    <DataTemplate DataType="wf:CompromiseViewModel">
      <views:CompromiseView />
    </DataTemplate>
    <DataTemplate DataType="ms:QuarantinePreviewViewModel">
      <views:QuarantinePreviewView />
    </DataTemplate>
    <DataTemplate DataType="ms:TracePreviewViewModel">
      <views:TracePreviewView />
    </DataTemplate>
    <DataTemplate DataType="ms:ListEntryPreviewViewModel">
      <views:ListEntryPreviewView />
    </DataTemplate>
    <DataTemplate DataType="ms:RulePreviewViewModel">
      <views:RulePreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:DevicePreviewViewModel">
      <views:DevicePreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:PrincipalRow">
      <views:PrincipalRowView />
    </DataTemplate>
    <DataTemplate DataType="rec:SiteOverviewSection">
      <views:SiteOverviewSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:SitePermissionsSection">
      <views:SitePermissionsSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:SiteSharingSection">
      <views:SiteSharingSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:SiteLibrariesSection">
      <views:SiteLibrariesSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:SitePreviewViewModel">
      <views:SitePreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:AutopilotPreviewViewModel">
      <views:AutopilotPreviewView />
    </DataTemplate>
    <DataTemplate DataType="rec:DeviceOverviewSection">
      <views:DeviceOverviewSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:DeviceUsersSection">
      <views:DeviceUsersSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:DeviceComplianceSection">
      <views:DeviceComplianceSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:DeviceAppsSection">
      <views:DeviceAppsSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:DeviceGroupsSection">
      <views:DeviceGroupsSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:DeviceDefenderSection">
      <views:DeviceDefenderSectionView />
    </DataTemplate>
    <DataTemplate DataType="rec:DeviceKeysSection">
      <views:DeviceKeysSectionView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Tenantry/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Tenantry/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
