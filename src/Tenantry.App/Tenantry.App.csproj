<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe hides the console window on Windows and is ignored on macOS and Linux. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>Tenantry</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Tenantry</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Generated by tools/icon/render-icon.ps1; rerun it after changing the design. -->
    <ApplicationIcon>Assets\tenantry.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The 1024 px master is for macOS/Linux packaging, not embedded in the app. -->
    <AvaloniaResource Include="Assets\tenantry.ico;Assets\tenantry-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="FluentIcons.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tenantry.ViewModels\Tenantry.ViewModels.csproj" />
    <ProjectReference Include="..\Tenantry.Demo\Tenantry.Demo.csproj" />
    <ProjectReference Include="..\Tenantry.Auth\Tenantry.Auth.csproj" />
    <ProjectReference Include="..\Tenantry.Graph\Tenantry.Graph.csproj" />
  </ItemGroup>

</Project>
