<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:listviews="using:Tenantry.App.Lists"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:views="using:Tenantry.App.Views"
             x:Class="Tenantry.App.Views.ReportsAreaView"
             x:DataType="vm:ReportsAreaViewModel">
  <!-- Reports: health checks with counts and Open List, and the change log. -->
  <DockPanel>
    <TabStrip DockPanel.Dock="Top" Classes="pagetabs" Margin="8,8,8,10" ItemsSource="{x:Static vm:ReportsAreaViewModel.Pages}" SelectedItem="{Binding SelectedPage}">
      <TabStrip.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </TabStrip.ItemsPanel>
      <TabStrip.ItemTemplate>
        <DataTemplate x:DataType="ms:MailSecurityPage">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="15" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabStrip.ItemTemplate>
    </TabStrip>

    <DockPanel IsVisible="{Binding ShowReports}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
        <Button Classes="ghost" Command="{Binding RefreshCommand}" ToolTip.Tip="Count again from the local copy">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
        <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Counts from the local copy, kept current as it syncs. Open List shows the matching people, groups, devices or sites, ready to filter, change or export." />
      </StackPanel>
      <ScrollViewer>
        <ContentControl Content="{Binding Reports}" HorizontalAlignment="Left" Margin="0,0,0,24" />
      </ScrollViewer>
    </DockPanel>

    <Panel IsVisible="{Binding ShowSignIns}">
      <views:LogHistoryView DataContext="{Binding SignIns}" />
    </Panel>
    <Panel IsVisible="{Binding ShowAudits}">
      <views:LogHistoryView DataContext="{Binding Audits}" />
    </Panel>
    <Panel IsVisible="{Binding ShowExchangeAdmin}">
      <views:LogHistoryView DataContext="{Binding ExchangeAdmin}" />
    </Panel>

    <DockPanel IsVisible="{Binding ShowChangeLog}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
        <Button Classes="ghost" Command="{Binding RefreshCommand}" ToolTip.Tip="Read the change log again">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
        <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Every change Tenantry has tried in this tenant from this computer, and what happened. Kept encrypted on this computer only." />
      </StackPanel>
      <ContentControl Content="{Binding ChangeLog}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
  </DockPanel>
</UserControl>
