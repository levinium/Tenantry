<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.SecuritySectionView"
             x:DataType="rec:SecuritySection">
  <!-- The small forms: adding (under the buttons) and changing a method (under its row). -->
  <UserControl.DataTemplates>
    <!-- A phone or the password-reset email -->
    <DataTemplate x:DataType="rec:ContactMethodForm">
      <Border Classes="levelrow" MinWidth="440">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding PhoneTypes}" IsVisible="{Binding HasPhoneTypes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rec:PhoneTypeChoice">
                <RadioButton GroupName="phonetype" Content="{Binding Name}" IsChecked="{Binding IsChosen}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox Text="{Binding Value}" PlaceholderText="{Binding Placeholder}" Width="320" HorizontalAlignment="Left">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock Classes="caption" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{Binding SaveText}" Command="{Binding SaveCommand}"
                    ToolTip.Tip="Goes to Pending Changes; nothing changes until you apply" ToolTip.ShowOnDisabled="True" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- A hardware token: what's printed on it or in the vendor's file -->
    <DataTemplate x:DataType="rec:HardwareTokenForm">
      <Border Classes="levelrow" MaxWidth="620">
        <StackPanel Spacing="8">
          <TextBlock Text="Add a Hardware Token" FontWeight="SemiBold" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="From the token and the file its vendor sends. Microsoft's preview feature: hardware tokens must be turned on in Security &amp; Compliance, Authentication Methods. After applying, activate it with the code it shows." />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <TextBlock Classes="label" Text="SERIAL NUMBER" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Serial}" Width="320" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="1" Classes="label" Text="MANUFACTURER" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Width="320" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="2" Classes="label" Text="MODEL" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Model}" Width="320" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="3" Classes="label" Text="SECRET KEY" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SecretKey}" Width="320" HorizontalAlignment="Left" PasswordChar="•" />
          </Grid>
          <CheckBox IsChecked="{Binding SixtySeconds}" Content="its code changes every 60 seconds (most change every 30)" />
          <CheckBox IsChecked="{Binding Sha256}" Content="it uses SHA-256 (most use SHA-1; the vendor's file says)" />
          <TextBlock Classes="caption" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Add Token" Command="{Binding SaveCommand}"
                    ToolTip.Tip="Goes to Pending Changes; the secret key is sent once and never kept" ToolTip.ShowOnDisabled="True" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- Activating a token: its code is good for a minute, so this goes at once -->
    <DataTemplate x:DataType="rec:TokenActivationForm">
      <Border Classes="levelrow" MinWidth="440">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                     Text="Type the 6-digit code the token shows now. It changes within a minute, so this is sent straight away (logged, and refused in Test mode for anyone else) instead of waiting in Pending Changes." />
          <TextBox Text="{Binding Code}" PlaceholderText="123456" Width="160" HorizontalAlignment="Left" MaxLength="6">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ActivateCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock Classes="error" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Activate Now" Command="{Binding ActivateCommand}" ToolTip.ShowOnDisabled="True"
                    ToolTip.Tip="Sends the code to Microsoft now" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <ProgressBar Classes="working" Width="80" IsVisible="{Binding IsWorking}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

  </UserControl.DataTemplates>

  <StackPanel Spacing="12" MaxWidth="1180" HorizontalAlignment="Stretch">
    <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ic:FluentIcon Icon="LockClosed" FontSize="16" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding EditReason}" />
      </StackPanel>
    </Border>

    <!-- The tab's pages. -->
    <TabStrip Classes="pagetabs" ItemsSource="{x:Static rec:SecuritySection.Pages}" SelectedItem="{Binding SelectedPageItem}">
      <TabStrip.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </TabStrip.ItemsPanel>
      <TabStrip.ItemTemplate>
        <DataTemplate x:DataType="rec:SecurityPageItem">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="15" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabStrip.ItemTemplate>
    </TabStrip>

    <!-- Sign-in methods -->
    <StackPanel Spacing="12" IsVisible="{Binding ShowMethods}">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <ic:FluentIcon Icon="Key" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="h3" Text="Multi-Factor Sign-In" VerticalAlignment="Center" />
          </Grid>
          <!-- One centred column: how they're set up, what can be added, then the list. -->
          <c:ReadableWidth>
          <StackPanel Spacing="10">
            <Border Classes="banner warning" IsVisible="{Binding HasMfaWarning}">
              <TextBlock Text="{Binding MfaText}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Classes="value" Text="{Binding MfaText}" TextWrapping="Wrap" IsVisible="{Binding !HasMfaWarning}" />
            <TextBlock Classes="label" Text="SIGN-IN METHODS" Margin="0,6,0,0" />
            <!-- Adding: buttons; each opens one small form here (nothing is staged until it's saved). -->
            <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding !HasForm}">
              <Button Command="{Binding SetUpAuthenticatorCommand}" IsVisible="{Binding CanAddMethod}"
                      ToolTip.Tip="Make a Temporary Access Pass and walk them through adding the app on their phone">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:FluentIcon Icon="Phone" FontSize="14" />
                  <TextBlock Text="Set Up Authenticator" />
                </StackPanel>
              </Button>
              <Button Command="{Binding AddPhoneCommand}" IsVisible="{Binding CanAddPhone}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:FluentIcon Icon="Add" FontSize="14" />
                  <TextBlock Text="{Binding AddPhoneText}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding AddEmailCommand}" IsVisible="{Binding CanAddEmail}"
                      ToolTip.Tip="An email they can reset their own password with (not counted as multi-factor)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:FluentIcon Icon="Add" FontSize="14" />
                  <TextBlock Text="Add Password Reset Email" />
                </StackPanel>
              </Button>
              <Button Command="{Binding AddHardwareTokenCommand}" IsVisible="{Binding CanAddMethod}"
                      ToolTip.Tip="A key-fob that shows a code (Microsoft's preview feature)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:FluentIcon Icon="Add" FontSize="14" />
                  <TextBlock Text="Add Hardware Token" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <ContentControl x:Name="FormHost" Content="{Binding Form}" IsVisible="{Binding HasForm}" HorizontalAlignment="Left">
            </ContentControl>
            <TextBlock Classes="muted" Text="Reading their sign-in methods…" IsVisible="{Binding MethodsLoading}" />
            <TextBlock Classes="error" Text="{Binding MethodsError}" IsVisible="{Binding HasMethodsError}" TextWrapping="Wrap" />
            <!-- One row per method: what it is on the left, its buttons on the right of the same row,
                 held to a readable width so the buttons stay near the name. -->
            <ItemsControl ItemsSource="{Binding Methods}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:MethodRow">
                  <Border Classes="valuerow">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <c:Badge Text="Default" Kind="Neutral" IsVisible="{Binding IsDefault}" VerticalAlignment="Center"
                                     ToolTip.Tip="Their default way to confirm a sign-in. Removing it makes another of their methods the default." />
                          </StackPanel>
                          <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AddedText}" VerticalAlignment="Center" />
                        <c:Badge Grid.Column="2" Text="{Binding PendingText}" Kind="Info" IsVisible="{Binding HasPending}" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="outline" Content="{Binding ChangeText}" Command="{Binding ChangeCommand}" IsVisible="{Binding CanChange}"
                                VerticalAlignment="Center" />
                        <Panel Grid.Column="4" VerticalAlignment="Center">
                          <Button Classes="danger-outline quiet" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                                  ToolTip.Tip="Remove this method (goes to Pending Changes)" />
                          <Button Classes="danger-outline undo" Content="Undo" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}"
                                  ToolTip.Tip="Take this change out of Pending Changes" />
                        </Panel>
                      </Grid>
                      <ContentControl Content="{Binding Form}" IsVisible="{Binding HasForm}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          </c:ReadableWidth>
        </StackPanel>
      </Border>
      <!-- Reset sign-in: Entra's two buttons for when someone must prove who they are again. -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="ArrowRotateCounterclockwise" FontSize="18" Foreground="{DynamicResource Accent}" />
            <TextBlock Classes="h3" Text="Reset Sign-In" VerticalAlignment="Center" />
          </StackPanel>
          <!-- The two steps as list rows: lines between them, buttons kept near the words. -->
          <c:ReadableWidth>
          <StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="When they should prove who they are again: a lost or new phone, a suspected compromise, someone leaving. Use one or both, in this order; each goes to Pending Changes, and pressing again undoes it." />
          <Border Classes="valuerow">
          <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12">
            <TextBlock Classes="h3" Text="1" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Revoke Sessions" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Signs them out of every app, browser and device, so anything still signed in has to sign in again. Same as Sign out everywhere." />
            </StackPanel>
            <Button Grid.Column="2" Classes="danger-outline quiet" Classes.undo="{Binding IsRevokePending}" Content="{Binding RevokeText}"
                    Command="{Binding ToggleRevokeSessionsCommand}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Width="190" HorizontalContentAlignment="Center" />
          </Grid>
          </Border>

          <Border Classes="valuerow">
          <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12">
            <TextBlock Classes="h3" Text="2" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Require Re-Register Multi-Factor Authentication" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Removes their MFA methods (Authenticator, phones, passkeys…) but keeps the password. They set MFA up again at their next sign-in." />
            </StackPanel>
            <Button Grid.Column="2" Classes="danger-outline quiet" Classes.undo="{Binding IsReregisterPending}" Content="{Binding ReregisterText}"
                    Command="{Binding ToggleReregisterCommand}" IsEnabled="{Binding CanReregister}" ToolTip.Tip="{Binding ReregisterTip}"
                    ToolTip.ShowOnDisabled="True" VerticalAlignment="Center" Width="190" HorizontalContentAlignment="Center" />
          </Grid>
          </Border>
          </StackPanel>
          </c:ReadableWidth>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <!-- Temporary Access Pass: often used on its own (a first sign-in, a new device). -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Password" FontSize="18" Foreground="{DynamicResource Accent}" />
              <TextBlock Classes="h3" Text="Temporary Access Pass" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="A time-limited code they sign in with instead of a password, to set up MFA or a new device. It's shown to you once after applying." />
            <StackPanel Orientation="Horizontal" Spacing="12" IsEnabled="{Binding CanEdit}">
              <TextBlock Text="Valid For" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{x:Static rec:SecuritySection.TapLifetimes}" SelectedItem="{Binding TapLifetime}" MinWidth="110" />
              <CheckBox IsChecked="{Binding TapOneTime}" Content="One Use Only" />
            </StackPanel>
            <Button HorizontalAlignment="Left" Content="Create a Temporary Access Pass" Command="{Binding CreateTapCommand}" IsEnabled="{Binding CanEdit}"
                    ToolTip.Tip="Adds the pass to Pending Changes; it's created and shown once when you apply" />
            <TextBlock Classes="pendingtext" Text="{Binding TapPendingText}" IsVisible="{Binding HasTapPending}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Risk -->
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <ic:FluentIcon Icon="ShieldError" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="h3" Text="Risk" VerticalAlignment="Center" />
              <c:Badge Grid.Column="2" Text="At Risk" Kind="Danger" IsVisible="{Binding IsAtRisk}" />
            </Grid>
            <TextBlock Classes="muted" Text="Checking Identity Protection…" IsVisible="{Binding RiskLoading}" />
            <TextBlock Classes="error" Text="{Binding RiskError}" IsVisible="{Binding HasRiskError}" TextWrapping="Wrap" />
            <TextBlock Classes="value" Text="{Binding RiskText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRiskAvailable}" IsEnabled="{Binding CanEdit}">
              <Button Classes="danger-outline" Content="Confirm Compromised" Command="{Binding ConfirmCompromisedCommand}"
                      ToolTip.Tip="Raises their risk to high, so risk policies act on it (added to Pending Changes)" />
              <Button Content="Dismiss Risk" Command="{Binding DismissRiskCommand}" IsVisible="{Binding IsAtRisk}"
                      ToolTip.Tip="You've checked and it's fine (added to Pending Changes)" />
            </StackPanel>
            <TextBlock Classes="pendingtext" Text="{Binding RiskPendingText}" IsVisible="{Binding HasRiskPending}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>

    <!-- Sign-in log -->
    <Border Classes="card" IsVisible="{Binding ShowSignIns}">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ic:FluentIcon Icon="History" FontSize="18" Foreground="{DynamicResource Accent}" />
          <TextBlock Classes="h3" Text="Sign-In Log" VerticalAlignment="Center" />
        </StackPanel>
        <!-- Asked of the sign-in log: the period, the type and the result. -->
        <WrapPanel ItemSpacing="10" LineSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Last" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static rec:SecuritySection.SignInDayOptions}" SelectedItem="{Binding SignInDays}" MinWidth="70" />
            <TextBlock Text="days" VerticalAlignment="Center" />
          </StackPanel>
          <ComboBox ItemsSource="{x:Static rec:SecuritySection.SignInKindOptions}" SelectedItem="{Binding SignInKind}" MinWidth="150"
                    ToolTip.Tip="Interactive: a person signed in. Non-interactive: apps refreshing their access in the background (most of the traffic)." />
          <ComboBox ItemsSource="{x:Static rec:SecuritySection.SignInResultOptions}" SelectedItem="{Binding SignInResult}" MinWidth="130" />
        </WrapPanel>
        <!-- Narrowing what came back: each lists what's there, with counts. -->
        <WrapPanel ItemSpacing="10" LineSpacing="8">
          <ComboBox ItemsSource="{Binding AppOptions}" SelectedItem="{Binding SelectedApp}" MinWidth="170" MaxDropDownHeight="360" ToolTip.Tip="App" />
          <ComboBox ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding SelectedLocation}" MinWidth="170" MaxDropDownHeight="360" ToolTip.Tip="Location" />
          <ComboBox ItemsSource="{Binding ClientOptions}" SelectedItem="{Binding SelectedClient}" MinWidth="170" MaxDropDownHeight="360"
                    ToolTip.Tip="How they connected. Legacy protocols (IMAP, POP, SMTP, ActiveSync…) often sign in without MFA." />
          <ComboBox ItemsSource="{Binding AuthOptions}" SelectedItem="{Binding SelectedAuth}" MinWidth="170" MaxDropDownHeight="360"
                    ToolTip.Tip="Whether the sign-in needed more than a password" />
          <TextBox Text="{Binding SignInSearch, UpdateSourceTrigger=LostFocus}" c:EditCommit.EnterUpdates="True" c:EditCommit.Idle="True"
                   Width="220" PlaceholderText="Search IP, device, reason…" />
          <Button Classes="link" Content="Clear Filters" Command="{Binding ClearSignInFiltersCommand}" IsVisible="{Binding HasSignInFilters}" VerticalAlignment="Center" />
        </WrapPanel>
        <TextBlock Classes="muted" Text="Reading the sign-in log…" IsVisible="{Binding SignInsLoading}" />
        <TextBlock Classes="error" Text="{Binding SignInsError}" IsVisible="{Binding HasSignInsError}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding SignInsUnavailable}" IsVisible="{Binding HasSignInsUnavailable}" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="{Binding SignInsSummary}" />
        <ItemsControl ItemsSource="{Binding SignIns}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:SignInRow">
              <Border Classes="valuerow">
                <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding When}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding App}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding Where}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="caption" Text="{Binding Client}" VerticalAlignment="Center" />
                      <c:Badge Text="Legacy Protocol" Kind="Warning" IsVisible="{Binding IsLegacy}" />
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                  </StackPanel>
                  <c:Badge Grid.Column="2" Text="{Binding Status}" Kind="{Binding StatusKind}" VerticalAlignment="Top" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Roles and app access -->
    <StackPanel Spacing="12" IsVisible="{Binding ShowAccess}">
      <TextBlock Classes="muted" Text="Reading their roles and app access…" IsVisible="{Binding AccessLoading}" />
      <TextBlock Classes="error" Text="{Binding AccessError}" IsVisible="{Binding HasAccessError}" TextWrapping="Wrap" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="PersonKey" FontSize="18" Foreground="{DynamicResource Accent}" />
            <TextBlock Classes="h3" Text="Admin Roles" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Roles assigned to them directly. Roles that come from a group they're in show on the group." />
          <TextBlock Classes="muted" Text="No admin roles." IsVisible="{Binding HasNoRoles}" />
          <c:ReadableWidth>
          <ItemsControl ItemsSource="{Binding Roles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rec:RevocableRow">
                <Border Classes="valuerow">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption" Text="{Binding Detail}" />
                    </StackPanel>
                    <c:Badge Grid.Column="1" Text="Removing" Kind="Info" IsVisible="{Binding IsRevoking}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="danger-outline quiet" Classes.undo="{Binding IsRevoking}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding Tip}"
                            ToolTip.ShowOnDisabled="True" VerticalAlignment="Center">
                      <Panel>
                        <TextBlock Text="Remove" IsVisible="{Binding !IsRevoking}" />
                        <TextBlock Text="Undo" IsVisible="{Binding IsRevoking}" />
                      </Panel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </c:ReadableWidth>
          <TextBlock Classes="label" Text="ROLES THEY CAN ACTIVATE (ELIGIBLE)" Margin="0,6,0,0" />
          <TextBlock Classes="muted" Text="{Binding EligibleText}" IsVisible="{Binding HasEligibleText}" TextWrapping="Wrap" />
          <c:ReadableWidth>
          <ItemsControl ItemsSource="{Binding EligibleRoles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="value" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </c:ReadableWidth>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="AppsList" FontSize="18" Foreground="{DynamicResource Accent}" />
            <TextBlock Classes="h3" Text="Apps They've Given Access to Their Data" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Apps they agreed could act for them, with what each may do. An unfamiliar app reading mail is a common sign of a phishing consent." />
          <TextBlock Classes="muted" Text="No apps." IsVisible="{Binding HasNoConsents}" />
          <c:ReadableWidth>
          <ItemsControl ItemsSource="{Binding Consents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rec:RevocableRow">
                <Border Classes="valuerow">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <c:Badge Grid.Column="1" Text="Revoking" Kind="Info" IsVisible="{Binding IsRevoking}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="danger-outline quiet" Classes.undo="{Binding IsRevoking}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding Tip}"
                            ToolTip.ShowOnDisabled="True" VerticalAlignment="Center">
                      <Panel>
                        <TextBlock Text="Remove" IsVisible="{Binding !IsRevoking}" />
                        <TextBlock Text="Undo" IsVisible="{Binding IsRevoking}" />
                      </Panel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </c:ReadableWidth>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Conditional Access -->
    <Border Classes="card" IsVisible="{Binding ShowConditionalAccess}">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ic:FluentIcon Icon="ShieldTask" FontSize="18" Foreground="{DynamicResource Accent}" />
          <TextBlock Classes="h3" Text="Conditional Access Policies" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Which policies cover them, judged on who each includes and excludes (them, their groups, their roles). Apps, locations and devices then decide when a policy acts." />
        <CheckBox IsChecked="{Binding ShowAllPolicies}" Content="Also Show Policies That Don't Apply to Them" />
        <TextBlock Classes="muted" Text="Reading the policies…" IsVisible="{Binding PoliciesLoading}" />
        <TextBlock Classes="error" Text="{Binding PoliciesError}" IsVisible="{Binding HasPoliciesError}" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="{Binding PoliciesSummary}" />
        <ItemsControl ItemsSource="{Binding Policies}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:PolicyRow">
              <Border Classes="valuerow">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding Why}" />
                    <TextBlock Classes="caption" Text="{Binding Controls}" TextWrapping="Wrap" />
                  </StackPanel>
                  <c:Badge Grid.Column="1" Text="{Binding Fit}" Kind="{Binding FitKind}" VerticalAlignment="Center" />
                  <c:Badge Grid.Column="2" Text="{Binding State}" Kind="{Binding StateKind}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
