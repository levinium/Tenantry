<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:dir="using:Tenantry.Core.Directory"
             x:Class="Tenantry.App.Views.UserListView"
             x:DataType="vm:UserListViewModel">
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox Grid.Column="0" Text="{Binding FilterText}"
               PlaceholderText="Filter: any words, in any order (name, address, department, title, license, guest, disabled)" />
      <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding CountText}" />
    </Grid>
    <DataGrid x:Name="Grid" ItemsSource="{Binding VisibleUsers}" SelectedItem="{Binding SelectedUser}"
              IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal" DoubleTapped="OnRowDoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn x:DataType="dir:UserSummary" Header="Name" Binding="{Binding DisplayName}" Width="1.3*" />
        <DataGridTextColumn x:DataType="dir:UserSummary" Header="Sign-in name" Binding="{Binding UserPrincipalName}" Width="2*" />
        <DataGridTextColumn x:DataType="dir:UserSummary" Header="Department" Binding="{Binding Department}" Width="*" />
        <DataGridTextColumn x:DataType="dir:UserSummary" Header="Title" Binding="{Binding JobTitle}" Width="1.4*" />
        <DataGridCheckBoxColumn x:DataType="dir:UserSummary" Header="Enabled" Binding="{Binding AccountEnabled}" Width="Auto" />
        <DataGridTextColumn x:DataType="dir:UserSummary" Header="Type" Binding="{Binding Kind}" Width="Auto" />
        <DataGridTextColumn x:DataType="dir:UserSummary" Header="Last sign-in" Binding="{Binding LastSignIn, StringFormat={}{0:g}, TargetNullValue=Never}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
