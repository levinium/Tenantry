<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.ResetPasswordView"
             x:DataType="rec:ResetPasswordViewModel">
  <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock TextWrapping="Wrap" Text="{Binding Explanation}" />

    <StackPanel Spacing="8">
      <RadioButton GroupName="password" IsChecked="{Binding Generate}" Content="Create One for Me, in This Tenant's Password Style (Settings › Passwords)" />
      <RadioButton GroupName="password" IsChecked="{Binding TypeOwn}" Content="Let Me Type a Password" />
      <StackPanel Spacing="6" Margin="28,0,0,0" IsVisible="{Binding TypeOwn}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" MaxWidth="360" HorizontalAlignment="Left">
          <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="{Binding ShowPassword}" PlaceholderText="New password" />
          <ToggleButton Grid.Column="1" Classes="ghost" IsChecked="{Binding ShowPassword}" ToolTip.Tip="Show or hide what you typed" VerticalAlignment="Center">
            <Panel>
              <ic:FluentIcon Icon="Eye" FontSize="16" IsVisible="{Binding !ShowPassword}" />
              <ic:FluentIcon Icon="EyeOff" FontSize="16" IsVisible="{Binding ShowPassword}" />
            </Panel>
          </ToggleButton>
        </Grid>
        <TextBlock Classes="error" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="At least 8 characters, with three of: upper-case letters, lower-case letters, numbers, symbols. It's never saved or shown again." />
      </StackPanel>
    </StackPanel>

    <CheckBox IsChecked="{Binding MustChange}"
              Content="Make Them Choose a New Password When They Next Sign In (Recommended)" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="accent" Command="{Binding StageCommand}" Content="Reset Password"
              ToolTip.Tip="Adds the reset to Pending Changes; nothing changes until you apply" />
      <Button Command="{Binding CancelCommand}" Content="Cancel" />
    </StackPanel>
  </StackPanel>
</UserControl>
