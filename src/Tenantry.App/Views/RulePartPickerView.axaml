<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.RulePartPickerView"
             x:DataType="ms:RulePartPickerViewModel"
             x:Name="Root">
  <!-- Everything a rule can check or do, grouped and searchable; advanced ones marked, unusable ones greyed with the reason. -->
  <Border Classes="groupbox" Padding="12">
    <StackPanel Spacing="8">
      <TextBox Text="{Binding Search}" PlaceholderText="{Binding SearchHint}">
        <TextBox.InnerLeftContent>
          <ic:FluentIcon Icon="Search" FontSize="14" Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <TextBlock Classes="caption" Text="Nothing matches. Try another word." IsVisible="{Binding HasNoMatches}" />
      <ScrollViewer MaxHeight="380">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ms:RulePickerGroup">
              <StackPanel Spacing="2" Margin="0,4,0,6">
                <TextBlock Classes="label" Text="{Binding Title}" Margin="4,0,0,2" />
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ms:RulePickerItem">
                      <Button Classes="pickrow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Command="{Binding #Root.((ms:RulePartPickerViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}"
                              IsEnabled="{Binding CanAdd}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <c:Badge Grid.Column="1" Text="Advanced" Kind="Info" IsVisible="{Binding IsAdvanced}" />
                          <c:Badge Grid.Column="2" Text="{Binding Status}" Kind="Neutral" IsVisible="{Binding HasStatus}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</UserControl>
