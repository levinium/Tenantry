<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.PlannedSectionView"
             x:DataType="rec:PlannedSection">
  <!-- A tab that isn't built yet: says when, and lists what it will hold. -->
  <Border Classes="card" HorizontalAlignment="Left" MaxWidth="720" Margin="0,4">
    <StackPanel Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Classes="menuicon" Width="36" Height="36">
          <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="18" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="h3" Text="{Binding Heading}" />
          <TextBlock Classes="caption" Text="What you'll be able to do here:" />
        </StackPanel>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Features}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <ic:FluentIcon Icon="Checkmark" FontSize="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0" />
              <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
