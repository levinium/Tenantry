<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.EdItemEditorView"
             x:DataType="rec:EdItemEditorViewModel">
  <!-- A new or changed search or hold: name, what to look for, and where. -->
  <UserControl.DataTemplates>
    <!-- One kind of place: None / All / Chosen, then the chosen ones as chips with a picker -->
    <DataTemplate x:DataType="rec:PlacesEditor">
      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="{Binding Title}" />
        <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Classes="chips">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="ed:EditorChoice">
              <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Detail}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Spacing="6" IsVisible="{Binding IsChosen}">
          <ItemsControl ItemsSource="{Binding Chips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rec:PlaceChip">
                <Border Classes="chip">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip.Tip="{Binding Detail}" />
                    <Button Classes="chipx" Command="{Binding RemoveCommand}" ToolTip.Tip="Take it off">
                      <ic:FluentIcon Icon="Dismiss" FontSize="11" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <views:PersonPickerView DataContext="{Binding Picker}" MaxWidth="460" HorizontalAlignment="Left" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <StackPanel Spacing="14" Width="680">
    <TextBlock Classes="caption" Text="{Binding Intro}" TextWrapping="Wrap" />
    <StackPanel Spacing="4" IsVisible="{Binding IsNew}">
      <TextBlock Classes="label" Text="NAME" />
      <TextBox Text="{Binding Name}" PlaceholderText="A short name, like Contract emails" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="label" Text="WHAT TO LOOK FOR (KEYWORD QUERY)" />
      <TextBox Text="{Binding Query}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
      <TextBlock Classes="caption" Text="{Binding QueryHint}" TextWrapping="Wrap" />
    </StackPanel>
    <ContentControl Content="{Binding Mailboxes}" />
    <ContentControl Content="{Binding Sites}" />
    <CheckBox IsChecked="{Binding PublicFolders}" Content="Also public folders" ToolTip.Tip="All public folders (if the organization has any)" />
    <StackPanel Spacing="4" IsVisible="{Binding IsNew}">
      <StackPanel Spacing="4" IsVisible="{Binding IsSearch}">
        <TextBlock Classes="label" Text="DESCRIPTION (OPTIONAL)" />
        <TextBox Text="{Binding Description}" PlaceholderText="Why you're searching" />
      </StackPanel>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
            <ic:FluentIcon Icon="Warning" FontSize="14" Foreground="{DynamicResource BadgeWarningFg}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource BadgeWarningFg}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="accent" Content="{Binding SaveText}" Command="{Binding SaveCommand}" ToolTip.Tip="Nothing changes until you apply" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
