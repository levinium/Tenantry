<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.PeopleExportButton"
             x:DataType="rec:PeopleExporter">
  <!-- Export for a list of people: a button per choice, and the nested-groups tickbox where the list holds groups. -->
  <Button x:Name="ExportButton" ToolTip.Tip="Save this list as a CSV file to open in Excel">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <ic:FluentIcon Icon="ArrowDownload" FontSize="14" />
      <TextBlock Text="Export" />
    </StackPanel>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnOpening">
        <StackPanel Spacing="10" Width="300">
          <TextBlock Classes="h3" Text="Export to CSV" />
          <TextBlock Classes="muted" Text="Nobody is listed yet." IsVisible="{Binding !HasAny}" />
          <CheckBox IsChecked="{Binding IncludeNested}" IsVisible="{Binding HasNested}">
            <TextBlock TextWrapping="Wrap" Text="Include people in nested groups (each marked with the group they're in)" />
          </CheckBox>
          <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding HasAny}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="rec:ExportChoice">
                <Button Classes="staysopen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding $parent[ItemsControl].((rec:PeopleExporter)DataContext).ExportCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Tip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="DocumentTable" FontSize="14" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Status}"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
