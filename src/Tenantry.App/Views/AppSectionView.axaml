<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.AppSectionView"
             x:DataType="rec:AppSection">
  <!-- A tab of an app's page: its cards, each with facts and rows. -->
  <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Stretch">
    <views:DeviceSectionStatusView />
    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="rec:AppCard">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="{Binding Title}" />
                <TextBlock Classes="caption" Text="{Binding Caption}" IsVisible="{Binding HasCaption}" TextWrapping="Wrap" />
              </StackPanel>
              <ContentControl Content="{Binding Form}" IsVisible="{Binding HasForm}">
                <ContentControl.DataTemplates>
                  <!-- A new client secret: what it's for and how long it lasts -->
                  <DataTemplate x:DataType="rec:AddSecretForm">
                    <Border Classes="valuerow">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="ADD A CLIENT SECRET" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding Description}" PlaceholderText="What it's for, like Nightly export" />
                          <ComboBox Grid.Column="1" ItemsSource="{x:Static rec:AddSecretForm.Lengths}" SelectedItem="{Binding Length}" MinWidth="150">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="ed:EditorChoice">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Button Grid.Column="2" Classes="accent" Content="Add Secret" Command="{Binding AddCommand}"
                                  ToolTip.Tip="Added to Pending changes; its value is shown to you once after applying" />
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource BadgeWarningFg}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                  <!-- A person (or group) to add, as a role when the app has several -->
                  <DataTemplate x:DataType="rec:AppPickForm">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRoles}">
                        <TextBlock Classes="label" Text="AS" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" MinWidth="220">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="ed:EditorChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <views:PersonPickerView DataContext="{Binding Picker}" MaxWidth="440" HorizontalAlignment="Left" />
                    </StackPanel>
                  </DataTemplate>
                  <!-- On/off settings, each staged as it's flipped -->
                  <DataTemplate x:DataType="rec:AppToggleForm">
                    <ItemsControl ItemsSource="{Binding Toggles}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rec:AppToggle">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                              <WrapPanel ItemSpacing="8">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <c:Badge Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" ToolTip.Tip="Waiting in Pending changes" />
                              </WrapPanel>
                              <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanEdit}" OnContent="Yes" OffContent="No" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                  <!-- One action for the whole card (Grant Admin Consent) -->
                  <DataTemplate x:DataType="rec:AppButtonForm">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="accent" Content="{Binding Text}" Command="{Binding ActCommand}" ToolTip.Tip="{Binding Tip}" />
                    </Grid>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
              <ItemsControl ItemsSource="{Binding FactLines}" IsVisible="{Binding HasFacts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="rec:SummaryLine">
                    <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
                      <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Text="{Binding EmptyText}" IsVisible="{Binding ShowEmpty}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding RowItems}" IsVisible="{Binding HasRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="rec:AppRow">
                    <Border Classes="valuerow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                          <WrapPanel ItemSpacing="8" LineSpacing="4">
                            <Button Classes="namelink" Content="{Binding Title}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" ToolTip.Tip="Open their page" />
                            <SelectableTextBlock Text="{Binding Title}" FontWeight="SemiBold" IsVisible="{Binding !CanOpen}" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding Badges}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel ItemSpacing="6" LineSpacing="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rec:HealthChip">
                                  <c:Badge Text="{Binding Text}" Kind="{Binding Kind}" ToolTip.Tip="{Binding Tip}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <c:Badge Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" ToolTip.Tip="Waiting in Pending changes" />
                          </WrapPanel>
                          <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                          <SelectableTextBlock Text="{Binding Code}" IsVisible="{Binding HasCode}" TextWrapping="Wrap" FontSize="12"
                                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                          <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="6" LineSpacing="6" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Border Classes="chip">
                                  <TextBlock Text="{Binding}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                          <Button Classes="outline" Content="{Binding AltText}" Command="{Binding AltCommand}" IsVisible="{Binding HasAlt}" ToolTip.Tip="{Binding AltTip}" />
                          <Button Classes="danger-outline" Classes.undo="{Binding IsUndo}" Content="{Binding ActionText}" Command="{Binding DoCommand}" IsVisible="{Binding HasAction}"
                                  ToolTip.Tip="{Binding ActionTip}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
