<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.AppSectionView"
             x:DataType="rec:AppSection">
  <!-- A tab of an app's page: its cards, each with facts and rows. -->
  <StackPanel Spacing="12" MaxWidth="1180" HorizontalAlignment="Stretch">
    <views:DeviceSectionStatusView />
    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="rec:AppCard">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="{Binding Title}" />
                <TextBlock Classes="caption" Text="{Binding Caption}" IsVisible="{Binding HasCaption}" TextWrapping="Wrap" />
              </StackPanel>
              <!-- Above the rows: the card's form (an Add button, for lists) on the left, search on the right -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <views:ListSearchBox Grid.Column="1" Target="{Binding #CardRows}" Placeholder="Search this list" VerticalAlignment="Top" />
              <ContentControl Content="{Binding Form}" IsVisible="{Binding HasForm}" VerticalAlignment="Top">
                <ContentControl.DataTemplates>
                  <!-- A new client secret: what it's for and how long it lasts -->
                  <DataTemplate x:DataType="rec:AddSecretForm">
                    <!-- Adding: a button; it opens a small form here, and nothing is staged until Add. -->
                    <Panel>
                    <Button Command="{Binding OpenCommand}" IsVisible="{Binding !IsOpen}" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Add" FontSize="14" />
                        <TextBlock Text="Add Secret" />
                      </StackPanel>
                    </Button>
                    <Border Classes="levelrow" IsVisible="{Binding IsOpen}" HorizontalAlignment="Left">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Add a Client Secret" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBox Text="{Binding Description}" PlaceholderText="What it's for, like Nightly export" Width="300" c:FocusWhen.Value="{Binding IsOpen}">
                            <TextBox.KeyBindings>
                              <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                              <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                            </TextBox.KeyBindings>
                          </TextBox>
                          <ComboBox ItemsSource="{x:Static rec:AddSecretForm.Lengths}" SelectedItem="{Binding Length}" MinWidth="150">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="ed:EditorChoice">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource BadgeWarningFg}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="accent" Content="Add Secret" Command="{Binding AddCommand}"
                                  ToolTip.Tip="Added to Pending Changes; its value is shown to you once after applying" />
                          <Button Content="Cancel" Command="{Binding CancelCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    </Panel>
                  </DataTemplate>
                  <!-- A person (or group) to add, as a role when the app has several -->
                  <DataTemplate x:DataType="rec:AppPickForm">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <views:AddButton DataContext="{Binding Picker}" Text="{Binding $parent[StackPanel].((rec:AppPickForm)DataContext).AddText}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRoles}">
                        <TextBlock Classes="label" Text="AS" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" MinWidth="220">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="ed:EditorChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                  <!-- On/off settings, each staged as it's flipped -->
                  <DataTemplate x:DataType="rec:AppToggleForm">
                    <ItemsControl ItemsSource="{Binding Toggles}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rec:AppToggle">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                              <WrapPanel ItemSpacing="8">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <c:Badge Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" ToolTip.Tip="Waiting in Pending Changes" />
                              </WrapPanel>
                              <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanEdit}" OnContent="Yes" OffContent="No" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                  <!-- A text to change (a case's description), saved to Pending changes -->
                  <DataTemplate x:DataType="rec:AppTextForm">
                    <StackPanel Spacing="6">
                      <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                               IsReadOnly="{Binding !CanEdit}" />
                      <Button Classes="accent" Content="Save to Pending Changes" Command="{Binding SaveCommand}" IsVisible="{Binding IsChanged}"
                              HorizontalAlignment="Left" ToolTip.Tip="Nothing changes until you apply" />
                    </StackPanel>
                  </DataTemplate>
                  <!-- Text fields that go to Pending Changes when left (an app's name and notes) -->
                  <DataTemplate x:DataType="rec:AppFieldsForm">
                    <ItemsControl ItemsSource="{Binding Fields}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rec:AppField">
                          <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Classes="label" Text="{Binding Label}" />
                            <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap"
                                     MinWidth="420" IsReadOnly="{Binding !CanEdit}" c:EditCommit.Commit="{Binding CommitCommand}" />
                            <TextBlock Classes="caption" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource BadgeWarningFg}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                  <!-- Add a line (a redirect URI): a button that opens a small form -->
                  <DataTemplate x:DataType="rec:AddEntryForm">
                    <Panel>
                      <Button Command="{Binding OpenCommand}" IsVisible="{Binding !IsOpen}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ic:FluentIcon Icon="Add" FontSize="14" />
                          <TextBlock Text="{Binding AddText}" />
                        </StackPanel>
                      </Button>
                      <Border Classes="levelrow" IsVisible="{Binding IsOpen}" HorizontalAlignment="Left">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" MinWidth="180" IsVisible="{Binding HasChoices}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ed:EditorChoice">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" Width="380" c:FocusWhen.Value="{Binding IsOpen}">
                              <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                              </TextBox.KeyBindings>
                            </TextBox>
                          </StackPanel>
                          <TextBlock Classes="caption" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource BadgeWarningFg}" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="Add" Command="{Binding AddCommand}" ToolTip.Tip="Added to Pending Changes" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Panel>
                  </DataTemplate>
                  <!-- Ask for a permission: choose an API, search what it offers, add one -->
                  <DataTemplate x:DataType="rec:AddPermissionForm">
                    <Panel>
                      <Button Command="{Binding OpenCommand}" IsVisible="{Binding !IsOpen}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ic:FluentIcon Icon="Add" FontSize="14" />
                          <TextBlock Text="Add Permission" />
                        </StackPanel>
                      </Button>
                      <Border Classes="levelrow" IsVisible="{Binding IsOpen}">
                        <StackPanel Spacing="8">
                          <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <ComboBox ItemsSource="{Binding Apis}" SelectedItem="{Binding Api}" MinWidth="240">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ed:EditorChoice">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{x:Static rec:AddPermissionForm.Kinds}" SelectedItem="{Binding Kind}" MinWidth="200">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ed:EditorChoice">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Text="{Binding Search}" PlaceholderText="Search, like Mail.Read or calendars" Width="300" c:FocusWhen.Value="{Binding IsOpen}">
                              <TextBox.KeyBindings>
                                <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                              </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="Done" Command="{Binding CloseCommand}" />
                          </WrapPanel>
                          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsReading}">
                            <Panel Width="16" Height="16" VerticalAlignment="Center">
                              <Ellipse Classes="spintrack" />
                              <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
                                <Arc.RenderTransform>
                                  <RotateTransform />
                                </Arc.RenderTransform>
                              </Arc>
                            </Panel>
                            <TextBlock Classes="muted" Text="Reading what it offers…" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Classes="caption" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                          <ScrollViewer MaxHeight="360">
                            <ItemsControl ItemsSource="{Binding Matches}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rec:ApiPermissionChoice">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,3">
                                    <StackPanel Spacing="1">
                                      <WrapPanel ItemSpacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <c:Badge Text="{Binding Kind.Text}" Kind="{Binding Kind.Kind}" ToolTip.Tip="{Binding Kind.Tip}" />
                                      </WrapPanel>
                                      <TextBlock Classes="caption" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Add" Command="{Binding AddCommand}" VerticalAlignment="Center"
                                            ToolTip.Tip="Ask for it (added to Pending Changes; consent comes after)" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </StackPanel>
                      </Border>
                    </Panel>
                  </DataTemplate>
                  <!-- Upload a certificate file (the public part) -->
                  <DataTemplate x:DataType="rec:CertificateForm">
                    <StackPanel Spacing="6">
                      <Button Command="{Binding UploadCommand}" HorizontalAlignment="Left" ToolTip.Tip="Choose a .cer, .crt or .pem file; it goes to Pending Changes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ic:FluentIcon Icon="ArrowUpload" FontSize="14" />
                          <TextBlock Text="Upload Certificate" />
                        </StackPanel>
                      </Button>
                      <TextBlock Classes="caption" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource BadgeWarningFg}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                  <!-- One action for the whole card (Grant Admin Consent) -->
                  <DataTemplate x:DataType="rec:AppButtonForm">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="accent" Content="{Binding Text}" Command="{Binding ActCommand}" ToolTip.Tip="{Binding Tip}" />
                    </Grid>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
              </Grid>
              <ItemsControl ItemsSource="{Binding FactLines}" IsVisible="{Binding HasFacts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="rec:SummaryLine">
                    <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
                      <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Text="{Binding EmptyText}" IsVisible="{Binding ShowEmpty}" TextWrapping="Wrap" />
              <c:ReadableWidth>
              <ItemsControl x:Name="CardRows" ItemsSource="{Binding RowItems}" IsVisible="{Binding HasRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="rec:AppRow">
                    <Border Classes="valuerow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                          <WrapPanel ItemSpacing="8" LineSpacing="4">
                            <Button Classes="namelink" Content="{Binding Title}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" ToolTip.Tip="{Binding OpenTip}" />
                            <SelectableTextBlock Text="{Binding Title}" FontWeight="SemiBold" IsVisible="{Binding !CanOpen}" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding Badges}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel ItemSpacing="6" LineSpacing="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rec:HealthChip">
                                  <c:Badge Text="{Binding Text}" Kind="{Binding Kind}" ToolTip.Tip="{Binding Tip}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <c:Badge Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" ToolTip.Tip="Waiting in Pending Changes" />
                          </WrapPanel>
                          <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                          <SelectableTextBlock Text="{Binding Code}" IsVisible="{Binding HasCode}" TextWrapping="Wrap" FontSize="12"
                                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                          <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="6" LineSpacing="6" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Border Classes="chip">
                                  <TextBlock Text="{Binding}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                          <Button Classes="outline" Content="{Binding EditText}" Command="{Binding EditCommand}" IsVisible="{Binding HasEdit}" ToolTip.Tip="{Binding EditTip}" />
                          <Button Classes="outline" Content="{Binding AltText}" Command="{Binding AltCommand}" IsVisible="{Binding HasAlt}" ToolTip.Tip="{Binding AltTip}" />
                          <Button Classes="danger-outline" Classes.undo="{Binding IsUndo}" Content="{Binding ActionText}" Command="{Binding DoCommand}" IsVisible="{Binding HasAction}"
                                  ToolTip.Tip="{Binding ActionTip}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </c:ReadableWidth>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
