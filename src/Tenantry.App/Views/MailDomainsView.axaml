<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:listviews="using:Tenantry.App.Lists"
             x:Class="Tenantry.App.Views.MailDomainsView"
             x:DataType="ms:MailDomainsViewModel">
  <!-- One row a domain in the standard list; a domain's checks, records and DKIM buttons are in its preview. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="How receivers can tell mail from your domains is really yours: SPF (which servers may send), DKIM (a signature), DMARC (what to do when those fail) and where mail arrives (MX). Read from Exchange and DNS." />
      <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding IsLoaded}" />
      <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}" Margin="0,4,0,0">
        <TextBlock TextWrapping="Wrap" Text="{Binding EditReason}" />
      </Border>
    </StackPanel>
    <ContentControl Content="{Binding List}">
      <ContentControl.DataTemplates>
        <listviews:ListViewCache />
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</UserControl>
