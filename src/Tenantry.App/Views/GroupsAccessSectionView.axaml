<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.GroupsAccessSectionView"
             x:DataType="rec:GroupsAccessSection"
             x:Name="Root">
  <UserControl.DataTemplates>
    <DataTemplate DataType="rec:ToggleRow">
      <views:ToggleRowView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <StackPanel Spacing="12" MaxWidth="1180" HorizontalAlignment="Stretch">
    <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ic:FluentIcon Icon="LockClosed" FontSize="16" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding EditReason}" />
      </StackPanel>
    </Border>

    <!-- Groups and teams: Member and Owner as checkboxes -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <ic:FluentIcon Icon="People" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="h3" Text="{Binding GroupsHeading}" VerticalAlignment="Center" />
        </Grid>
        <!-- Above the list: Add on the left, search on the right -->
        <c:ReadableWidth>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <views:AddButton DataContext="{Binding GroupPicker}" Text="Add to Group" VerticalAlignment="Top"
                           IsEnabled="{Binding #Root.((rec:GroupsAccessSection)DataContext).CanEdit}" />
          <views:ListSearchBox Grid.Column="2" Target="{Binding #GroupsList}" Placeholder="Search their groups" />
        </Grid>
        </c:ReadableWidth>
        <TextBlock Classes="muted" Text="Not in any groups." IsVisible="{Binding HasNoGroups}" />
        <c:ReadableWidth>
        <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        </c:ReadableWidth>
      </StackPanel>
    </Border>

    <!-- Shared mailboxes they can use -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <ic:FluentIcon Icon="MailInbox" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="h3" Text="{Binding MailboxesHeading}" VerticalAlignment="Center" />
        </Grid>
        <c:ReadableWidth>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <views:AddButton DataContext="{Binding MailboxPicker}" Text="Give Access to a Mailbox" VerticalAlignment="Top"
                           Hint="Choose a shared mailbox. They get Full Access; change it on the row. It goes to Pending Changes."
                           IsEnabled="{Binding #Root.((rec:GroupsAccessSection)DataContext).CanEdit}" />
          <views:ListSearchBox Grid.Column="2" Target="{Binding #MailboxesList}" Placeholder="Search their shared mailboxes" />
        </Grid>
        </c:ReadableWidth>
        <TextBlock Classes="muted" Text="No access to any shared mailboxes." IsVisible="{Binding HasNoMailboxes}" />
        <c:ReadableWidth>
        <ItemsControl x:Name="MailboxesList" ItemsSource="{Binding Mailboxes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        </c:ReadableWidth>
      </StackPanel>
    </Border>

    <!-- Who can use their own mailbox -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <ic:FluentIcon Icon="PersonKey" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="h3" Text="{Binding DelegatesHeading}" VerticalAlignment="Center" />
        </Grid>
        <c:ReadableWidth>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <views:AddButton DataContext="{Binding DelegatePicker}" Text="Give Someone Access" VerticalAlignment="Top"
                           Hint="Choose a person. They get Full Access; change it on the row. It goes to Pending Changes."
                           IsVisible="{Binding #Root.((rec:GroupsAccessSection)DataContext).IsDelegatesReady}"
                           IsEnabled="{Binding #Root.((rec:GroupsAccessSection)DataContext).CanEdit}" />
          <views:ListSearchBox Grid.Column="2" Target="{Binding #DelegatesList}" Placeholder="Search who has access" />
        </Grid>
        </c:ReadableWidth>
        <TextBlock Classes="muted" Text="No mailbox." IsVisible="{Binding !HasMailbox}" />
        <TextBlock Classes="muted" Text="Reading who can use their mailbox from Exchange…" IsVisible="{Binding IsLoadingDelegates}" />
        <Border Classes="banner error" IsVisible="{Binding HasDelegatesError}">
          <SelectableTextBlock Text="{Binding DelegatesError}" TextWrapping="Wrap" />
        </Border>
        <TextBlock Classes="muted" Text="Nobody else can use this mailbox." IsVisible="{Binding HasNoDelegates}" />
        <c:ReadableWidth>
        <ItemsControl x:Name="DelegatesList" ItemsSource="{Binding Delegates}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        </c:ReadableWidth>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
