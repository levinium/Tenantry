<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.CardPageView"
             x:DataType="vm:CardPageViewModel">
  <!-- A page of cards (an eDiscovery case or search): header with flags, buttons and a wheel, then its tabs. -->
  <DockPanel Margin="8,12,8,0">
    <Border DockPanel.Dock="Top" Classes="card">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <Border Classes="avatar large" VerticalAlignment="Top">
          <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Classes="h1" Text="{Binding Title}" TextWrapping="Wrap" />
          <SelectableTextBlock Classes="caption" Text="{Binding Subtitle}" />
          <TextBlock Classes="caption pendingtext" Text="{Binding PendingText}" IsVisible="{Binding HasPending}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Badges}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="8" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rec:HealthChip">
                <c:Badge Text="{Binding Text}" Kind="{Binding Kind}" ToolTip.Tip="{Binding Tip}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- What the page is working on (Run Search), with a wheel -->
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" Margin="0,4,0,0">
            <Panel Width="18" Height="18" VerticalAlignment="Center">
              <Ellipse Classes="spintrack" />
              <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
                <Arc.RenderTransform>
                  <RotateTransform />
                </Arc.RenderTransform>
              </Arc>
            </Panel>
            <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding BusyText}" />
          </StackPanel>
          <Border Classes="banner neutral" IsVisible="{Binding HasNotice}" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Notice}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <ItemsControl Grid.Column="2" ItemsSource="{Binding Buttons}" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PageButton">
              <Button Command="{Binding ActCommand}" ToolTip.Tip="{Binding Tip}" HorizontalAlignment="Stretch"
                      Classes.accent="{Binding IsAccent}" Classes.danger-outline="{Binding IsDanger}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="16" />
                  <TextBlock Text="{Binding Text}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <TabControl Classes="recordtabs" Margin="0,8,0,0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="rec:RecordSection">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="rec:RecordSection">
          <ScrollViewer Padding="0,12,0,24">
            <ContentControl Content="{Binding}" />
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</UserControl>
