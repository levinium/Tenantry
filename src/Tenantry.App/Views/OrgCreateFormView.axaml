<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:org="using:Tenantry.ViewModels.Organization"
             xmlns:it="using:Tenantry.ViewModels.Intune"
             xmlns:dir="using:Tenantry.Core.Directory"
             x:Class="Tenantry.App.Views.OrgCreateFormView"
             x:DataType="org:OrgCreateForm">
  <!-- New: what an organization kind can make, with its boxes. -->
  <Border Classes="card" IsVisible="{Binding IsOpen}">
    <StackPanel Spacing="10">
      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Option}" IsVisible="{Binding HasManyOptions}" MinWidth="320">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="dir:OrgCreate">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Classes="caption" Text="{Binding Description}" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Fields}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="it:CreateFieldRow">
            <StackPanel Spacing="3" MaxWidth="720" HorizontalAlignment="Left">
              <TextBlock Classes="label" Text="{Binding Label}" />
              <TextBox Text="{Binding Text}" IsVisible="{Binding IsText}" PlaceholderText="{Binding Placeholder}" MinWidth="420" />
              <TextBox Text="{Binding Text}" IsVisible="{Binding IsLong}" PlaceholderText="{Binding Placeholder}" AcceptsReturn="True" MinHeight="70" MaxHeight="240" MinWidth="560" />
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" IsVisible="{Binding IsChoice}" MinWidth="320" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="error" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Add to Pending Changes" Command="{Binding AddCommand}" />
        <Button Content="Cancel" Command="{Binding ToggleCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
