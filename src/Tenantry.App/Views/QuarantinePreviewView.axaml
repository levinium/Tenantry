<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.QuarantinePreviewView"
             x:DataType="ms:QuarantinePreviewViewModel">
  <StackPanel Spacing="14">
    <StackPanel Spacing="6">
      <TextBlock Classes="h3" Text="{Binding Subject}" TextWrapping="Wrap" />
      <WrapPanel ItemSpacing="6" LineSpacing="4">
        <c:Badge Text="{Binding ReasonText}" Kind="{Binding ReasonKind}" />
        <c:Badge Text="{Binding StatusText}" Kind="Neutral" />
      </WrapPanel>
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
      <TextBlock Classes="label" Text="FROM" VerticalAlignment="Center" />
      <SelectableTextBlock Grid.Column="1" Text="{Binding Sender}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Classes="label" Text="TO" VerticalAlignment="Center" />
      <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RecipientsText}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Classes="label" Text="RECEIVED" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReceivedText}" />
      <TextBlock Grid.Row="3" Classes="label" Text="POLICY" VerticalAlignment="Center" IsVisible="{Binding HasPolicy}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Policy}" IsVisible="{Binding HasPolicy}" TextWrapping="Wrap" />
    </Grid>
    <TextBlock Classes="caption" Text="{Binding ExpiresText}" />

    <!-- The message, on request and as plain text -->
    <StackPanel Spacing="6">
      <Button Command="{Binding ShowMessageCommand}" IsVisible="{Binding !HasBody}" HorizontalAlignment="Left"
              ToolTip.Tip="Shown as plain text, so nothing in it loads or runs. Microsoft records each preview.">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="Eye" FontSize="14" />
          <TextBlock Text="Show the Message" />
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoadingBody}">
        <Panel Width="16" Height="16" VerticalAlignment="Center">
          <Ellipse Classes="spintrack" />
          <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
            <Arc.RenderTransform>
              <RotateTransform />
            </Arc.RenderTransform>
          </Arc>
        </Panel>
        <TextBlock Classes="muted" Text="Reading the message…" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="error" Text="{Binding BodyError}" IsVisible="{Binding HasBodyError}" TextWrapping="Wrap" />
      <Border Classes="valuerow" IsVisible="{Binding HasBody}" MaxHeight="320">
        <ScrollViewer>
          <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <TextBlock Classes="caption" Text="{Binding AttachmentsText}" IsVisible="{Binding HasAttachments}" TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="divider" />

    <!-- Actions: each goes to Pending changes -->
    <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}">
      <TextBlock TextWrapping="Wrap" Text="{Binding EditReason}" />
    </Border>
    <Border Classes="banner success" IsVisible="{Binding HasOutcome}">
      <TextBlock TextWrapping="Wrap" Text="{Binding Outcome}" />
    </Border>
    <StackPanel Spacing="10" IsVisible="{Binding CanAct}">
      <Border Classes="banner error" IsVisible="{Binding IsDangerous}">
        <TextBlock TextWrapping="Wrap" Text="{Binding DangerText}" />
      </Border>
      <TextBlock Classes="pendingtext" Text="{Binding PendingText}" IsVisible="{Binding HasPending}" />
      <StackPanel Spacing="6" IsVisible="{Binding CanRelease}">
        <Button Classes="accent" Content="{Binding ReleaseText}" Command="{Binding ReleaseCommand}" HorizontalAlignment="Left"
                ToolTip.Tip="Delivers it to every recipient (added to Pending changes)" />
        <CheckBox IsChecked="{Binding AllowSender}" Content="Also Allow This Sender from Now On" />
      </StackPanel>
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Classes="danger-outline" Content="{Binding DeleteText}" Command="{Binding DeleteCommand}"
                ToolTip.Tip="Removes it from quarantine for good (added to Pending changes)" />
        <Button Classes="danger-outline" Content="{Binding BlockText}" Command="{Binding BlockSenderCommand}" IsEnabled="{Binding CanBlock}"
                ToolTip.Tip="Adds the sender to the block list: their mail goes to quarantine from now on (added to Pending changes)" />
      </WrapPanel>
      <TextBlock Classes="caption" Text="{Binding BlockNote}" IsVisible="{Binding HasBlockNote}" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</UserControl>
