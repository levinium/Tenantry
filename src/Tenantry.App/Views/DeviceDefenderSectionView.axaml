<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             x:Class="Tenantry.App.Views.DeviceDefenderSectionView"
             x:DataType="rec:DeviceDefenderSection">
  <StackPanel Spacing="12" MaxWidth="1180" HorizontalAlignment="Stretch">
    <views:DeviceSectionStatusView />
    <Border Classes="card" IsVisible="{Binding HasState}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h3" Text="Microsoft Defender" />
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="8" LineSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:HealthChip">
              <c:Badge Text="{Binding Text}" Kind="{Binding Kind}" ToolTip.Tip="{Binding Tip}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Facts}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:SummaryLine">
              <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
                <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding HasState}">
      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="Threats" />
        <TextBlock Classes="muted" Text="Defender hasn't reported any threats on this device." IsVisible="{Binding HasNoMalware}" />
        <ItemsControl ItemsSource="{Binding Malware}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:MalwareRow">
              <Border Classes="valuerow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="1">
                    <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="{Binding Detail}" />
                  </StackPanel>
                  <c:Badge Grid.Column="1" Text="{Binding SeverityText}" Kind="{Binding SeverityKind}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
