<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:lists="using:Tenantry.ViewModels.Lists"
             xmlns:listviews="using:Tenantry.App.Lists"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             x:Class="Tenantry.App.Views.MainView"
             x:DataType="vm:MainViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Gesture="Meta+K" Command="{Binding OpenPaletteCommand}" />
  </UserControl.KeyBindings>

  <Grid ColumnDefinitions="248,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Classes="sidebar">
      <DockPanel>
        <!-- Who and where -->
        <Grid DockPanel.Dock="Top" Margin="16,18,16,14" ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="avatar">
            <TextBlock Text="{Binding TenantInitials}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="h3" Text="{Binding TenantName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="caption" Text="{Binding Account}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <!-- Search everything (Ctrl+K), shown as a box so it reads as search at a glance -->
        <Button DockPanel.Dock="Top" Classes="searchall" Margin="12,0,12,12" Command="{Binding OpenPaletteCommand}"
                ToolTip.Tip="Search everything: find any person, group or saved view and open it (Ctrl+K)">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <ic:FluentIcon Icon="Search" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Search everything" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl+K" /></Border>
          </Grid>
        </Button>
        <Border DockPanel.Dock="Top" Classes="divider" Margin="16,0,16,12" />

        <!-- Footer actions -->
        <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,14" Spacing="2">
          <!-- How fresh the local copy is, and a way to check now -->
          <Grid IsVisible="{Binding HasSync}" Margin="12,0,4,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                Background="Transparent" ToolTip.Tip="{Binding SyncTip}">
            <Panel VerticalAlignment="Center">
              <ic:FluentIcon Icon="CloudCheckmark" FontSize="16" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding IsSyncOk}" />
              <ic:FluentIcon Icon="CloudSync" FontSize="16" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsSyncing}" />
              <ic:FluentIcon Icon="Warning" FontSize="16" Foreground="{DynamicResource BadgeWarningFg}" IsVisible="{Binding HasSyncError}" />
            </Panel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="caption" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{Binding SyncText}" />
              <!-- The background read (mailbox sizes and replies) under it, while it runs -->
              <TextBlock Classes="caption" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"
                         Text="{Binding BackgroundText}" IsVisible="{Binding HasBackgroundText}"
                         ToolTip.Tip="Reading every mailbox's size and automatic replies in the background; the lists update when it's done" />
            </StackPanel>
            <Button Grid.Column="2" Classes="rowaction" Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Refresh: check Microsoft 365 for changes now">
              <ic:FluentIcon Icon="ArrowSync" FontSize="16" />
            </Button>
          </Grid>
          <Border Classes="divider" Margin="8,0,8,8" />
          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Key" FontSize="18" />
              <TextBlock Text="Your access" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedBottom">
                <StackPanel Spacing="12" Width="440" Margin="4">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h3" Text="Your access in this tenant" />
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Based on your directory roles and the tenant's licenses. Features you can't use show why." />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Access}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CapabilityRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Reason}"
                                       IsVisible="{Binding Reason, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </StackPanel>
                          <c:Badge Grid.Column="1" Text="{Binding BadgeText}" Kind="{Binding BadgeKind}" VerticalAlignment="Top" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="10" DataContext="{Binding Pending}" x:DataType="ed:PendingChangesViewModel"
                              IsVisible="{Binding ShowTestModeBanner, FallbackValue=False}">
                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="1">
                        <TextBlock Text="Test mode" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding TestModeStateText}" />
                      </StackPanel>
                      <Button Grid.Column="1" VerticalAlignment="Top" IsVisible="{Binding !IsTestMode}"
                              Command="{Binding TurnOnTestModeCommand}" Content="Turn on"
                              ToolTip.Tip="Only objects starting zz-tenantry-test- can be changed again" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenSettingsCommand}"
                  IsVisible="{Binding HasSettings}" ToolTip.Tip="How often this tenant's local copy is updated, and when it last was">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Settings" FontSize="18" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding SwitchTenantCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="ArrowSwap" FontSize="18" />
              <TextBlock Text="Switch tenant" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Areas -->
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Margin="20,0,0,2" Text="ADMIN AREAS" />
          <ListBox Classes="nav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="vm:NavSection">
                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                <Setter Property="ToolTip.Tip" Value="{Binding UnavailableReason}" />
                <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavSection">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ic:FluentIcon Icon="{Binding Key, Converter={x:Static conv:NavIcon.Instance}}" FontSize="18" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Classes="banner info" Margin="20,16,20,0" IsVisible="{Binding IsDemo}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Demo tenant: generated people on example domains. Nothing here is real, and nothing is sent anywhere." />
        </StackPanel>
      </Border>

      <!-- Permissions a newer Tenantry needs that the tenant hasn't granted: one step to grant them. -->
      <Border DockPanel.Dock="Top" Classes="banner neutral" Margin="20,12,20,0" IsVisible="{Binding HasMissingPermissions}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <ic:FluentIcon Icon="ShieldLock" FontSize="16" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock TextWrapping="Wrap" Text="{Binding PermissionsText}" ToolTip.Tip="{Binding PermissionsList}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding PermissionsStatus}"
                       IsVisible="{Binding PermissionsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="accent" VerticalAlignment="Center" Command="{Binding GrantPermissionsCommand}"
                  Content="Grant permissions…" ToolTip.Tip="{Binding PermissionsList}" />
        </Grid>
      </Border>

      <!-- Test mode: only zz-tenantry-test- objects can change. Turning it off means typing the tenant's name. -->
      <Border DockPanel.Dock="Top" Classes="banner warning" Margin="20,12,20,0"
              DataContext="{Binding Pending}" x:DataType="ed:PendingChangesViewModel"
              IsVisible="{Binding ShowBanner, FallbackValue=False}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <ic:FluentIcon Icon="Beaker" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding TestModeText}" />
            <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center" IsVisible="{Binding !IsTurningOff}"
                    Command="{Binding StartTurnOffCommand}" Content="Allow real changes…"
                    ToolTip.Tip="Turn Test mode off for this tenant, so real users and groups can be changed" />
          </Grid>
          <StackPanel IsVisible="{Binding IsTurningOff}" Spacing="8">
            <TextBlock TextWrapping="Wrap" Text="{Binding TurnOffPrompt}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="280" Text="{Binding TurnOffText}" PlaceholderText="Tenant name" />
              <Button Classes="danger" Command="{Binding TurnOffTestModeCommand}" Content="Turn off Test mode" />
              <Button Command="{Binding CancelTurnOffCommand}" Content="Cancel" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Pending changes: everything staged, before → after, applied together. -->
      <Border DockPanel.Dock="Bottom" Classes="tray" Margin="12,0,12,12"
              DataContext="{Binding Pending}" x:DataType="ed:PendingChangesViewModel"
              IsVisible="{Binding IsVisible, FallbackValue=False}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Button Classes="ghost" Command="{Binding ToggleOpenCommand}" ToolTip.Tip="Show or hide the pending changes">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="h3" Text="{Binding HeaderText}" VerticalAlignment="Center" />
                <ic:FluentIcon Icon="ChevronUp" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding !IsOpen}" />
                <ic:FluentIcon Icon="ChevronDown" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsOpen}" />
              </StackPanel>
            </Button>
            <Border Grid.Column="1" Classes="banner neutral" Padding="10,6" VerticalAlignment="Center" HorizontalAlignment="Left"
                    IsVisible="{Binding HasResult}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Result}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Classes="rowaction" Padding="3" Command="{Binding DismissResultCommand}" ToolTip.Tip="Dismiss">
                  <ic:FluentIcon Icon="Dismiss" FontSize="12" />
                </Button>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasChanges}">
              <Button Classes="ghost" Command="{Binding DiscardAllCommand}" Content="Discard all"
                      ToolTip.Tip="Remove every pending change; nothing is sent" />
              <Button Command="{Binding CancelConfirmCommand}" Content="Cancel" IsVisible="{Binding ApplyIsDanger}" />
              <Button Classes="accent" Classes.danger="{Binding ApplyIsDanger}" Command="{Binding ApplyCommand}"
                      ToolTip.Tip="Send these changes to Microsoft 365, then read each one back to confirm it">
                <TextBlock Text="{Binding ApplyText}" />
              </Button>
            </StackPanel>
          </Grid>
          <!-- Temporary passwords: shown once, never stored; copy, pass on, dismiss. -->
          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Reveals}" Margin="0,10,0,0" IsVisible="{Binding HasReveals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ed:RevealRow">
                <Border Classes="pending" Margin="0,0,0,6" Padding="12,8">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <ic:FluentIcon Icon="Password" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Label}" />
                      <SelectableTextBlock Classes="code" FontSize="16" Text="{Binding Secret}" />
                      <TextBlock Classes="caption" Text="Shown once and never stored. Copy it now and pass it on securely." TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding CopyCommand}" ToolTip.Tip="Copy the password">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Copy" FontSize="14" />
                        <TextBlock Text="Copy" IsVisible="{Binding !Copied}" />
                        <TextBlock Text="Copied" IsVisible="{Binding Copied}" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Classes="rowaction" VerticalAlignment="Center" Command="{Binding DismissCommand}"
                            ToolTip.Tip="Done: remove the password from the screen">
                      <ic:FluentIcon Icon="Dismiss" FontSize="14" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ScrollViewer IsVisible="{Binding IsOpen}" MaxHeight="260" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ed:PendingRow">
                  <Border Classes="valuerow">
                    <Grid ColumnDefinitions="16,220,*,Auto" ColumnSpacing="12">
                      <ic:FluentIcon Icon="Warning" FontSize="14" Foreground="{DynamicResource BadgeWarningFg}"
                                     VerticalAlignment="Center" IsVisible="{Binding IsCaution}"
                                     ToolTip.Tip="This change takes something away; you'll be asked to confirm" />
                      <TextBlock Grid.Column="1" Text="{Binding TargetName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="muted" Text="{Binding LabelText}" />
                          <TextBlock Text="{Binding Before}" Classes="before" />
                          <TextBlock Classes="muted" Text="→" />
                          <TextBlock Text="{Binding After}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Classes="error" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
                      </StackPanel>
                      <Button Grid.Column="3" Classes="rowaction" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this change; nothing is sent">
                        <ic:FluentIcon Icon="Dismiss" FontSize="14" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The first tab is the sidebar area's list; open records follow it. With no record open
           there is nothing to switch between, so the strip hides. -->
      <TabControl x:Name="Tabs" Margin="12,4,12,0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0"
                  Classes.liststrip="{Binding !HasRecordTabs}">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <Button Classes="ghost" IsVisible="{Binding CanClose}" Padding="4" VerticalAlignment="Center"
                      ToolTip.Tip="Close"
                      Command="{Binding #Tabs.((vm:MainViewModel)DataContext).CloseTabCommand}"
                      CommandParameter="{Binding}">
                <ic:FluentIcon Icon="Dismiss" FontSize="12" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.DataTemplates>
          <listviews:ListViewCache />
          <DataTemplate DataType="vm:UserDetailViewModel">
            <views:UserDetailView />
          </DataTemplate>
          <DataTemplate DataType="vm:GroupDetailViewModel">
            <views:GroupDetailView />
          </DataTemplate>
        </TabControl.DataTemplates>
      </TabControl>
    </DockPanel>

    <!-- Popups: a record area from the preview pane, Reset password, … Close with ✕, Esc or a click outside. -->
    <Panel Grid.ColumnSpan="2" IsVisible="{Binding HasDialog}">
      <Border x:Name="DialogBackdrop" Classes="backdrop" />
      <Border Classes="palette" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="1120" MinWidth="420">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="22,16,14,12">
            <StackPanel Spacing="1">
              <TextBlock Classes="h2" Text="{Binding Dialog.Title, FallbackValue=''}" />
              <TextBlock Classes="muted" Text="{Binding Dialog.Subtitle, FallbackValue=''}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="rowaction" VerticalAlignment="Top" Command="{Binding CloseDialogCommand}" ToolTip.Tip="Close (Esc)">
              <ic:FluentIcon Icon="Dismiss" FontSize="16" />
            </Button>
          </Grid>
          <Border DockPanel.Dock="Top" Classes="divider" />
          <TextBlock DockPanel.Dock="Bottom" Classes="caption" Margin="22,8,22,12" TextWrapping="Wrap"
                     Text="{Binding Dialog.Footnote, FallbackValue=''}" IsVisible="{Binding Dialog.HasFootnote, FallbackValue=False}" />
          <Border DockPanel.Dock="Bottom" Classes="divider" IsVisible="{Binding Dialog.HasFootnote, FallbackValue=False}" />
          <ScrollViewer x:Name="DialogScroller" Padding="22,16">
            <ContentControl Content="{Binding Dialog.Content, FallbackValue={x:Null}}" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <!-- Ctrl+K: a box over everything. Click outside or press Esc to close. -->
    <Panel Grid.ColumnSpan="2" IsVisible="{Binding IsPaletteOpen}">
      <Border x:Name="PaletteBackdrop" Classes="backdrop" />
      <Border Classes="palette" DataContext="{Binding Palette}" x:DataType="vm:PaletteViewModel"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,72,16,16" Width="640">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,12" ColumnSpacing="10">
            <ic:FluentIcon Icon="Search" FontSize="18" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
            <TextBox x:Name="PaletteBox" Grid.Column="1" Classes="bare" Text="{Binding Query}"
                     PlaceholderText="Search people, groups and views" />
            <Button Grid.Column="2" Classes="rowaction" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Esc)">
              <ic:FluentIcon Icon="Dismiss" FontSize="14" />
            </Button>
          </Grid>
          <Border DockPanel.Dock="Top" Classes="divider" />
          <TextBlock DockPanel.Dock="Bottom" Classes="caption" Margin="16,8,16,12" TextWrapping="Wrap" Text="{Binding Hint}" />
          <Border DockPanel.Dock="Bottom" Classes="divider" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="16,14" IsVisible="{Binding ShowNoMatches}"
                     Text="Nothing matches. Try part of a name, an address or a department." />
          <ScrollViewer MaxHeight="440">
            <ItemsControl ItemsSource="{Binding Results}" Margin="8,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PaletteResult">
                  <Button Classes="menurow" Classes.selected="{Binding IsSelected}"
                          Command="{Binding #PaletteBox.((vm:PaletteViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Classes="menuicon">
                        <ic:FluentIcon Icon="{Binding Entry.Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="16" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Entry.Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Entry.Subtitle}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Entry.Kind}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
