<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:views="using:Tenantry.App.Views"
             x:Class="Tenantry.App.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Grid ColumnDefinitions="220,*">

    <!-- Sidebar: one entry per admin area. Unavailable areas stay visible but disabled,
         with the reason as a tooltip. -->
    <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12" Spacing="2">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Tenantry" />
          <TextBlock Text="{Binding TenantName}" TextTrimming="CharacterEllipsis" />
          <TextBlock Opacity="0.6" FontSize="12" Text="{Binding Account}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="12" Spacing="6">
          <Button HorizontalAlignment="Stretch" Content="Your access">
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedBottom">
                <StackPanel Spacing="8" MaxWidth="460">
                  <TextBlock FontWeight="SemiBold" Text="What you can do in this tenant" />
                  <ItemsControl ItemsSource="{Binding Access}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CapabilityRow">
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                          <TextBlock Grid.Column="0" Text="{Binding Title}" />
                          <TextBlock Grid.Column="1" Text="{Binding State}" TextWrapping="Wrap" Opacity="0.8" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button HorizontalAlignment="Stretch" Content="Switch tenant" Command="{Binding SwitchTenantCommand}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:NavSection">
              <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
              <Setter Property="ToolTip.Tip" Value="{Binding UnavailableReason}" />
              <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavSection">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="#33E81123" Padding="12,8">
        <SelectableTextBlock Text="{Binding LoadError}" TextWrapping="Wrap" />
      </Border>
      <Border DockPanel.Dock="Top" IsVisible="{Binding IsDemo}" Background="#22FFB900" Padding="12,6">
        <TextBlock Text="Demo tenant: generated people on example domains. Nothing here is real, and nothing is sent anywhere." />
      </Border>

      <!-- Console-style tabs: list pages plus any number of open records side by side. -->
      <TabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" />
              <Button IsVisible="{Binding CanClose}" Content="✕" FontSize="10" Padding="4,1"
                      Background="Transparent" VerticalAlignment="Center"
                      ToolTip.Tip="Close"
                      Command="{Binding #Tabs.((vm:MainViewModel)DataContext).CloseTabCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.DataTemplates>
          <DataTemplate DataType="vm:UserListViewModel">
            <views:UserListView />
          </DataTemplate>
          <DataTemplate DataType="vm:UserDetailViewModel">
            <views:UserDetailView />
          </DataTemplate>
        </TabControl.DataTemplates>
      </TabControl>
    </DockPanel>
  </Grid>
</UserControl>
