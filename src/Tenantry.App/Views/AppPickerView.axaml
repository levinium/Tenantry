<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:dir="using:Tenantry.Core.Directory"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.AppPickerView"
             x:DataType="ed:AppPicker"
             x:Name="Root">
  <!-- Apps chosen as chips with ×, then an Add button; its popup searches Entra's apps as you type. -->
  <StackPanel Spacing="6">
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="6" LineSpacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="ed:PickOption">
          <Border Classes="chip">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <Button Classes="chipx" Command="{Binding #Root.((ed:AppPicker)DataContext).RemoveCommand}" CommandParameter="{Binding}" ToolTip.Tip="Take it off">
                <ic:FluentIcon Icon="Dismiss" FontSize="11" />
              </Button>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button x:Name="Open" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ic:FluentIcon Icon="Add" FontSize="14" />
        <TextBlock Text="{Binding AddText}" />
      </StackPanel>
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedLeft">
          <StackPanel Spacing="8" Width="420">
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Type the start of the app's name." />
            <TextBox Text="{Binding Query}" PlaceholderText="App name" />
            <TextBlock Classes="muted" Text="Searching…" IsVisible="{Binding IsSearching}" />
    <ScrollViewer MaxHeight="320">
    <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="ed:PickRow">
          <Button Classes="pickrow staysopen" Click="OnRowClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <Grid ColumnDefinitions="Auto,*">
              <CheckBox IsChecked="{Binding IsTicked}" IsHitTestVisible="False" Focusable="False" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Option.Name}" />
                <TextBlock Classes="caption" Text="{Binding Option.Detail}" />
              </StackPanel>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Classes="caption" Text="{Binding TickedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="accent" Content="{Binding AddTickedText}" Command="{Binding AddTickedCommand}"
                      ToolTip.Tip="Adds every ticked app" ToolTip.ShowOnDisabled="True" />
              <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel" />
            </Grid>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </StackPanel>
</UserControl>
