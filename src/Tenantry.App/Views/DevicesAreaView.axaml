<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:listviews="using:Tenantry.App.Lists"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.DevicesAreaView"
             x:DataType="vm:DevicesAreaViewModel">
  <DockPanel>
    <!-- The area's pages -->
    <TabStrip DockPanel.Dock="Top" Classes="pagetabs" Margin="0,8,0,10" ItemsSource="{x:Static vm:DevicesAreaViewModel.Pages}" SelectedItem="{Binding SelectedPage}">
      <TabStrip.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </TabStrip.ItemsPanel>
      <TabStrip.ItemTemplate>
        <DataTemplate x:DataType="ms:MailSecurityPage">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="15" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabStrip.ItemTemplate>
    </TabStrip>

    <ContentControl Content="{Binding Devices}" IsVisible="{Binding ShowDevices}">
      <ContentControl.DataTemplates>
        <listviews:ListViewCache />
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Autopilot: read live, with Refresh; why it can't be read when it can't -->
    <DockPanel IsVisible="{Binding ShowAutopilot}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshAutopilotCommand}" ToolTip.Tip="Read the Autopilot devices from Intune again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Windows devices registered to set themselves up for the organization when first turned on, or after an Autopilot reset." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasAutopilotNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding AutopilotNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding Autopilot}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
  </DockPanel>
</UserControl>
