<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:listviews="using:Tenantry.App.Lists"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:views="using:Tenantry.App.Views"
             x:Class="Tenantry.App.Views.DevicesAreaView"
             x:DataType="vm:DevicesAreaViewModel">
  <DockPanel>
    <!-- The area's pages, in sections: the sections on one row, the chosen section's pages under it. -->
    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,10" Spacing="6">
      <TabStrip Classes="pagetabs" ItemsSource="{x:Static vm:DevicesAreaViewModel.Sections}" SelectedItem="{Binding SelectedSection}">
        <TabStrip.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </TabStrip.ItemsPanel>
        <TabStrip.ItemTemplate>
          <DataTemplate x:DataType="vm:SecurityPageGroup">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
      <Border Background="{DynamicResource SubtleBg}" CornerRadius="8" Padding="6,2">
        <TabStrip Classes="pagetabs" ItemsSource="{Binding SelectedSection.Pages}" SelectedItem="{Binding SelectedPage}">
          <TabStrip.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </TabStrip.ItemsPanel>
          <TabStrip.ItemTemplate>
            <DataTemplate x:DataType="ms:MailSecurityPage">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" />
              </StackPanel>
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>
      </Border>
    </StackPanel>
    <!-- One page shows at a time, filling the width. (As separate DockPanel children each page
         was docked left at its content's width, leaving a blank strip on wide windows.) -->
    <Grid>

    <ContentControl Content="{Binding Devices}" IsVisible="{Binding ShowDevices}">
      <ContentControl.DataTemplates>
        <listviews:ListViewCache />
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Autopilot: read live, with Refresh; why it can't be read when it can't -->
    <DockPanel IsVisible="{Binding ShowAutopilot}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshAutopilotCommand}" ToolTip.Tip="Read the Autopilot devices from Intune again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Windows devices registered to set themselves up for the organization when first turned on, or after an Autopilot reset." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasAutopilotNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding AutopilotNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding Autopilot}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>

    <Panel IsVisible="{Binding ShowCompliance}">
      <views:CompliancePoliciesView DataContext="{Binding Compliance}" />
    </Panel>
    </Grid>
  </DockPanel>
</UserControl>
