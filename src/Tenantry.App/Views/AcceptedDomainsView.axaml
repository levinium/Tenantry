<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.AcceptedDomainsView"
             x:DataType="ms:AcceptedDomainsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="0,0,0,24">
      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="h3" Text="Accepted Domains" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="The domains the organization takes mail for. Adding and verifying a domain is done in Microsoft 365&apos;s domain setup; each one&apos;s sender checks are on Email Authentication." />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshCommand}" VerticalAlignment="Top" ToolTip.Tip="Read them from Exchange again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}">
        <TextBlock TextWrapping="Wrap" Text="{Binding EditReason}" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
        <Panel Width="16" Height="16" VerticalAlignment="Center">
          <Ellipse Classes="spintrack" />
          <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
            <Arc.RenderTransform>
              <RotateTransform />
            </Arc.RenderTransform>
          </Arc>
        </Panel>
        <TextBlock Classes="muted" Text="Reading from Exchange…" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
      <Border Classes="card">
        <ItemsControl ItemsSource="{Binding Domains}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ms:AcceptedDomainRow">
              <StackPanel Spacing="2" Margin="0,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="{Binding Tags}" IsVisible="{Binding HasTags}" VerticalAlignment="Center" />
                </StackPanel>
                <Panel IsVisible="{Binding !IsInitial}">
                  <views:SettingRowView DataContext="{Binding Type}" />
                </Panel>
                <TextBlock Classes="caption" Text="Microsoft's initial domain: always authoritative." IsVisible="{Binding IsInitial}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
