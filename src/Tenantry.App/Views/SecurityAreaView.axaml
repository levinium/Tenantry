<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:listviews="using:Tenantry.App.Lists"
             x:Class="Tenantry.App.Views.SecurityAreaView"
             x:DataType="vm:SecurityAreaViewModel">
  <DockPanel>
    <!-- The area's pages -->
    <TabStrip DockPanel.Dock="Top" Classes="pagetabs" Margin="0,8,0,10" ItemsSource="{x:Static vm:SecurityAreaViewModel.Pages}" SelectedItem="{Binding SelectedPage}">
      <TabStrip.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </TabStrip.ItemsPanel>
      <TabStrip.ItemTemplate>
        <DataTemplate x:DataType="ms:MailSecurityPage">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="15" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabStrip.ItemTemplate>
    </TabStrip>

    <!-- Conditional Access: read live, with Refresh -->
    <DockPanel IsVisible="{Binding ShowPolicies}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshPoliciesCommand}" ToolTip.Tip="Read Conditional Access from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Rules every sign-in must meet: who, to which apps, from where, and what they require." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasCaNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding CaNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding Policies}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>

    <!-- What If: which policies a sign-in would meet -->
    <Panel IsVisible="{Binding ShowWhatIf}">
    <ScrollViewer DataContext="{Binding WhatIf}" x:DataType="rec:WhatIfViewModel">
      <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="h3" Text="A Sign-In to Test" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Entra works out which policies would apply, what they'd require, and why the others wouldn't. Nothing is changed." />
            </StackPanel>
            <Panel IsVisible="{Binding !HasPerson}">
              <views:PersonPickerView DataContext="{Binding Picker}" MaxWidth="440" HorizontalAlignment="Left" />
            </Panel>
            <Border Classes="chip" HorizontalAlignment="Left" IsVisible="{Binding HasPerson}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding PersonName}" VerticalAlignment="Center" />
                <Button Classes="chipx" Command="{Binding ClearPersonCommand}" ToolTip.Tip="Choose someone else">
                  <ic:FluentIcon Icon="Dismiss" FontSize="11" />
                </Button>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="Auto,240,24,Auto,240" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <TextBlock Classes="caption" Text="App" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static rec:WhatIfViewModel.Apps}" SelectedItem="{Binding App}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="3" Classes="caption" Text="Device Platform" VerticalAlignment="Center" />
              <ComboBox Grid.Column="4" ItemsSource="{x:Static rec:WhatIfViewModel.Platforms}" SelectedItem="{Binding Platform}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="caption" Text="Kind of App" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static rec:WhatIfViewModel.ClientApps}" SelectedItem="{Binding ClientApp}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Grid.Column="3" Classes="caption" Text="Country (2 Letters)" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Country}" PlaceholderText="Like US or GB" MaxLength="2" />
              <TextBlock Grid.Row="2" Classes="caption" Text="Sign-In Risk" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static rec:WhatIfViewModel.Risks}" SelectedItem="{Binding SignInRisk}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Grid.Column="3" Classes="caption" Text="IP Address" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding IpAddress}" PlaceholderText="Optional" />
              <TextBlock Grid.Row="3" Classes="caption" Text="User Risk" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static rec:WhatIfViewModel.Risks}" SelectedItem="{Binding UserRisk}" HorizontalAlignment="Stretch" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="accent" Content="Check" Command="{Binding CheckCommand}" ToolTip.Tip="Ask Entra which policies would apply" />
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsChecking}">
                <Panel Width="18" Height="18" VerticalAlignment="Center">
                  <Ellipse Classes="spintrack" />
                  <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
                    <Arc.RenderTransform>
                      <RotateTransform />
                    </Arc.RenderTransform>
                  </Arc>
                </Panel>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="Asking Entra…" />
              </StackPanel>
            </StackPanel>
            <Border Classes="banner error" IsVisible="{Binding HasNote}">
              <TextBlock TextWrapping="Wrap" Text="{Binding Note}" />
            </Border>
          </StackPanel>
        </Border>
        <TextBlock Classes="h3" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:WhatIfRow">
              <Border Classes="valuerow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                  <c:Badge Grid.Column="1" Text="{Binding Verdict}" Kind="{Binding VerdictKind}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Admin roles: read live, with Refresh; what PIM can't show here -->
    <DockPanel IsVisible="{Binding ShowRoles}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshRolesCommand}" ToolTip.Tip="Read admin roles from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Who can administer what. Privileged roles can change security settings or reach everyone's data: keep them few." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasRolesNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RolesNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding Roles}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <!-- My Roles (PIM): the admin's own eligible roles, to switch on -->
    <Panel IsVisible="{Binding ShowMyRoles}">
    <ScrollViewer DataContext="{Binding MyRoles}" x:DataType="rec:MyRolesViewModel">
      <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding ReadAgainCommand}" ToolTip.Tip="Read your roles from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Roles you're eligible for stay off until you switch one on, for a few hours, when you need it." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
          <Panel Width="18" Height="18" VerticalAlignment="Center">
            <Ellipse Classes="spintrack" />
            <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
              <Arc.RenderTransform>
                <RotateTransform />
              </Arc.RenderTransform>
            </Arc>
          </Panel>
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="Reading your roles…" />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Note}" />
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding HasActive}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Switched On" />
            <ItemsControl ItemsSource="{Binding Active}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:MyRoleRow">
                  <Border Classes="valuerow">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Classes="caption" Text="{Binding Detail}" />
                      </StackPanel>
                      <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="danger-outline" Content="Switch Off" Command="{Binding DeactivateCommand}" IsVisible="{Binding IsActivated}"
                              VerticalAlignment="Center" ToolTip.Tip="End it now, before it runs out (added to Pending changes)" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding !HasNote}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Eligible" />
            <TextBlock Classes="muted" Text="You aren't eligible for any roles." IsVisible="{Binding HasNoEligible}" />
            <ItemsControl ItemsSource="{Binding Eligible}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:MyRoleRow">
                  <Border Classes="valuerow">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="caption" Text="{Binding Detail}" />
                        </StackPanel>
                        <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="outline" Content="Switch On…" Command="{Binding OpenCommand}" VerticalAlignment="Center"
                                ToolTip.Tip="Choose how long and say why" />
                      </Grid>
                      <StackPanel Spacing="8" IsVisible="{Binding IsOpen}" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="caption" Text="For (Hours)" VerticalAlignment="Center" />
                          <ComboBox ItemsSource="{Binding HourChoices}" SelectedItem="{Binding Hours}" MinWidth="90" />
                        </StackPanel>
                        <TextBox Text="{Binding Justification}" PlaceholderText="Why you need it" Width="480" HorizontalAlignment="Left" />
                        <TextBox Text="{Binding Ticket}" PlaceholderText="Ticket number" Width="260" HorizontalAlignment="Left" IsVisible="{Binding NeedsTicket}" />
                        <TextBlock Classes="caption" Text="{Binding Needs}" IsVisible="{Binding HasNeeds}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource BadgeWarningFg}" />
                        <Button Classes="accent" Content="Add to Pending Changes" Command="{Binding ActivateCommand}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Approvals (PIM): requests waiting for the admin -->
    <Panel IsVisible="{Binding ShowApprovals}">
    <ScrollViewer DataContext="{Binding Approvals}" x:DataType="rec:ApprovalsViewModel">
      <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding ReadAgainCommand}" ToolTip.Tip="Read requests from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="Requests to switch a role on that are waiting for your answer." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
          <Panel Width="18" Height="18" VerticalAlignment="Center">
            <Ellipse Classes="spintrack" />
            <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
              <Arc.RenderTransform>
                <RotateTransform />
              </Arc.RenderTransform>
            </Arc>
          </Panel>
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="Reading requests waiting for you…" />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Note}" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" Text="Nothing is waiting for you." IsVisible="{Binding HasNone}" />
        <ItemsControl ItemsSource="{Binding Requests}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:RoleRequestRow">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Who}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding What}" />
                      <TextBlock Classes="caption" Text="{Binding Why}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding When}" />
                    </StackPanel>
                    <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" VerticalAlignment="Top" />
                  </Grid>
                  <TextBox Text="{Binding Reason}" PlaceholderText="Your reason (optional)" Width="480" HorizontalAlignment="Left" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Content="Approve" Command="{Binding ApproveCommand}" ToolTip.Tip="Added to Pending changes" />
                    <Button Classes="danger-outline" Content="Deny" Command="{Binding DenyCommand}" ToolTip.Tip="Added to Pending changes" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
