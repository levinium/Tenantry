<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:listviews="using:Tenantry.App.Lists"
             x:Class="Tenantry.App.Views.SecurityAreaView"
             x:DataType="vm:SecurityAreaViewModel">
  <DockPanel>
    <!-- The area's pages -->
    <TabStrip DockPanel.Dock="Top" Classes="pagetabs" Margin="0,8,0,10" ItemsSource="{x:Static vm:SecurityAreaViewModel.Pages}" SelectedItem="{Binding SelectedPage}">
      <TabStrip.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </TabStrip.ItemsPanel>
      <TabStrip.ItemTemplate>
        <DataTemplate x:DataType="ms:MailSecurityPage">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="15" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabStrip.ItemTemplate>
    </TabStrip>

    <!-- Conditional Access: read live, with Refresh -->
    <DockPanel IsVisible="{Binding ShowPolicies}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshPoliciesCommand}" ToolTip.Tip="Read Conditional Access from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Rules every sign-in must meet: who, to which apps, from where, and what they require." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasCaNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding CaNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding Policies}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>

    <!-- What If: which policies a sign-in would meet -->
    <Panel IsVisible="{Binding ShowWhatIf}">
    <ScrollViewer DataContext="{Binding WhatIf}" x:DataType="rec:WhatIfViewModel">
      <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="h3" Text="A Sign-In to Test" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Entra works out which policies would apply, what they'd require, and why the others wouldn't. Nothing is changed." />
            </StackPanel>
            <Panel IsVisible="{Binding !HasPerson}">
              <views:PersonPickerView DataContext="{Binding Picker}" MaxWidth="440" HorizontalAlignment="Left" />
            </Panel>
            <Border Classes="chip" HorizontalAlignment="Left" IsVisible="{Binding HasPerson}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding PersonName}" VerticalAlignment="Center" />
                <Button Classes="chipx" Command="{Binding ClearPersonCommand}" ToolTip.Tip="Choose someone else">
                  <ic:FluentIcon Icon="Dismiss" FontSize="11" />
                </Button>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="Auto,240,24,Auto,240" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <TextBlock Classes="caption" Text="App" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static rec:WhatIfViewModel.Apps}" SelectedItem="{Binding App}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="3" Classes="caption" Text="Device Platform" VerticalAlignment="Center" />
              <ComboBox Grid.Column="4" ItemsSource="{x:Static rec:WhatIfViewModel.Platforms}" SelectedItem="{Binding Platform}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="caption" Text="Kind of App" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static rec:WhatIfViewModel.ClientApps}" SelectedItem="{Binding ClientApp}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Grid.Column="3" Classes="caption" Text="Country (2 Letters)" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Country}" PlaceholderText="Like US or GB" MaxLength="2" />
              <TextBlock Grid.Row="2" Classes="caption" Text="Sign-In Risk" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static rec:WhatIfViewModel.Risks}" SelectedItem="{Binding SignInRisk}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Grid.Column="3" Classes="caption" Text="IP Address" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding IpAddress}" PlaceholderText="Optional" />
              <TextBlock Grid.Row="3" Classes="caption" Text="User Risk" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static rec:WhatIfViewModel.Risks}" SelectedItem="{Binding UserRisk}" HorizontalAlignment="Stretch" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="accent" Content="Check" Command="{Binding CheckCommand}" ToolTip.Tip="Ask Entra which policies would apply" />
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsChecking}">
                <Panel Width="18" Height="18" VerticalAlignment="Center">
                  <Ellipse Classes="spintrack" />
                  <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
                    <Arc.RenderTransform>
                      <RotateTransform />
                    </Arc.RenderTransform>
                  </Arc>
                </Panel>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="Asking Entra…" />
              </StackPanel>
            </StackPanel>
            <Border Classes="banner error" IsVisible="{Binding HasNote}">
              <TextBlock TextWrapping="Wrap" Text="{Binding Note}" />
            </Border>
          </StackPanel>
        </Border>
        <TextBlock Classes="h3" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:WhatIfRow">
              <Border Classes="valuerow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                  <c:Badge Grid.Column="1" Text="{Binding Verdict}" Kind="{Binding VerdictKind}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Named locations: places policies name -->
    <Panel IsVisible="{Binding ShowLocations}">
    <ScrollViewer DataContext="{Binding NamedLocations}" x:DataType="rec:LocationsViewModel">
      <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Places Conditional Access policies can include or leave out: IP ranges (like an office's connection, which can be marked trusted) or countries." />
          <Button Grid.Column="1" Classes="accent" Command="{Binding AddCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="Add an IP range or a list of countries">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="Add" FontSize="14" />
              <TextBlock Text="Add Location" />
            </StackPanel>
          </Button>
        </Grid>
        <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="LockClosed" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding EditReason}" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsFormOpen}">
          <StackPanel Spacing="10">
            <TextBlock Classes="h3" Text="{Binding FormTitle}" />
            <TextBox Text="{Binding Name}" PlaceholderText="Name, like Head Office" />
            <ListBox ItemsSource="{x:Static rec:LocationsViewModel.Kinds}" SelectedItem="{Binding Kind}" Background="Transparent">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="ed:EditorChoice">
                  <StackPanel Spacing="2" Margin="2,4">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBox Text="{Binding PlacesText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" PlaceholderText="{Binding PlacesHint}"
                     FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
            <CheckBox IsChecked="{Binding Trusted}" IsVisible="{Binding IsIp}" Content="Trusted (Policies That Leave Out Trusted Places Skip It)" />
            <StackPanel Spacing="6" IsVisible="{Binding !IsIp}">
              <CheckBox IsChecked="{Binding IncludeUnknown}" Content="Include Addresses No Country Can Be Found For" />
              <CheckBox IsChecked="{Binding ByGps}" Content="Judge by the Authenticator App's GPS (Not the IP Address)" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                    <ic:FluentIcon Icon="Warning" FontSize="14" Foreground="{DynamicResource BadgeWarningFg}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource BadgeWarningFg}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="Add to Pending Changes" Command="{Binding SaveCommand}" ToolTip.Tip="Nothing changes until you apply the pending changes" />
              <Button Content="Cancel" Command="{Binding CancelCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Classes="muted" Text="No named locations yet." IsVisible="{Binding HasNone}" />
        <ItemsControl ItemsSource="{Binding Locations}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:LocationRow">
              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <c:Badge Text="{Binding KindText}" Kind="Neutral" />
                      <c:Badge Text="Trusted" Kind="Info" IsVisible="{Binding IsTrusted}" />
                      <c:Badge Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" ToolTip.Tip="Waiting in Pending changes" />
                    </WrapPanel>
                    <SelectableTextBlock Text="{Binding Places}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" />
                    <TextBlock Classes="caption" Text="{Binding Extra}" IsVisible="{Binding HasExtra}" />
                    <TextBlock Classes="caption" Text="{Binding UsedText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Classes="outline" Content="Edit" Command="{Binding EditCommand}" IsVisible="{Binding !HasState}"
                            IsEnabled="{Binding $parent[ScrollViewer].((rec:LocationsViewModel)DataContext).CanEdit}" ToolTip.Tip="Change its name, places or trust" />
                    <Button Classes="danger-outline" Content="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding !HasState}" IsEnabled="{Binding CanDelete}"
                            ToolTip.Tip="{Binding DeleteTip}" ToolTip.ShowOnDisabled="True" />
                    <Button Classes="danger-outline undo" Content="Undo" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}"
                            ToolTip.Tip="Take the change back out of Pending changes" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Authentication strengths: which methods each counts -->
    <Panel IsVisible="{Binding ShowStrengths}">
    <ScrollViewer DataContext="{Binding AuthStrengths}" x:DataType="rec:StrengthsViewModel">
      <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="A policy can require an authentication strength instead of plain MFA: only the sign-in methods (or combinations) listed for it count." />
        <ItemsControl ItemsSource="{Binding Strengths}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:StrengthRow">
              <Border Classes="card">
                <StackPanel Spacing="6">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <c:Badge Text="{Binding TypeText}" Kind="Neutral" />
                  </WrapPanel>
                  <TextBlock Classes="caption" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                  <TextBlock Classes="label" Text="ANY OF THESE" Margin="0,4,0,0" />
                  <ItemsControl ItemsSource="{Binding Methods}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="chip">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" Text="{Binding UsedText}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- App registrations and enterprise apps (8c): read live together, with Refresh -->
    <DockPanel IsVisible="{Binding ShowRegistrations}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshAppsCommand}" ToolTip.Tip="Read apps from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Apps defined in this organization: how they sign in (secrets and certificates) and what they ask to do." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasAppsNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding AppsNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding Registrations}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <DockPanel IsVisible="{Binding ShowEnterpriseApps}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshAppsCommand}" ToolTip.Tip="Read apps from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Every app people here can sign in to: who has access, and what they or an admin allowed it to do." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasAppsNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding AppsNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding EnterpriseApps}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <!-- Identity Protection (8d-2): read together, with Refresh; P2 or a permission may be missing -->
    <DockPanel IsVisible="{Binding ShowRiskyUsers}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshRiskCommand}" ToolTip.Tip="Read Identity Protection again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="People Identity Protection thinks may be compromised. Confirm or dismiss to teach it; risk-based policies act on the level." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasRiskNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RiskNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding RiskyUsers}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>    <DockPanel IsVisible="{Binding ShowRiskDetections}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshRiskCommand}" ToolTip.Tip="Read Identity Protection again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="Each sign-in or account event that raised someone's risk, and why." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasRiskNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RiskNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding RiskDetections}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>    <DockPanel IsVisible="{Binding ShowRiskyApps}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshRiskCommand}" ToolTip.Tip="Read Identity Protection again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="Apps (service principals) whose sign-ins or credentials look compromised." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasRiskNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RiskNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding RiskyApps}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>    <!-- Audit log search (8e) -->
    <Panel IsVisible="{Binding ShowAuditLog}">
      <views:AuditLogView DataContext="{Binding AuditLog}" />
    </Panel>
    <!-- Sign-in methods and security defaults (8d-1) -->
    <Panel IsVisible="{Binding ShowAuthMethods}">
      <views:AuthMethodsView DataContext="{Binding AuthMethodsPage}" />
    </Panel>
    <!-- Deleted app registrations: restore or delete for good -->
    <Panel IsVisible="{Binding ShowDeletedApps}">
      <ScrollViewer>
        <ContentControl Content="{Binding DeletedAppsSection}" HorizontalAlignment="Left" Margin="0,0,0,24" />
      </ScrollViewer>
    </Panel>
    <!-- Admin roles: read live, with Refresh; what PIM can't show here -->
    <DockPanel IsVisible="{Binding ShowRoles}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding RefreshRolesCommand}" ToolTip.Tip="Read admin roles from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Who can administer what. Privileged roles can change security settings or reach everyone's data: keep them few." />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasRolesNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RolesNote}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding Roles}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
    <!-- My Roles (PIM): the admin's own eligible roles, to switch on -->
    <Panel IsVisible="{Binding ShowMyRoles}">
    <ScrollViewer DataContext="{Binding MyRoles}" x:DataType="rec:MyRolesViewModel">
      <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding ReadAgainCommand}" ToolTip.Tip="Read your roles from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Roles you're eligible for stay off until you switch one on, for a few hours, when you need it." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
          <Panel Width="18" Height="18" VerticalAlignment="Center">
            <Ellipse Classes="spintrack" />
            <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
              <Arc.RenderTransform>
                <RotateTransform />
              </Arc.RenderTransform>
            </Arc>
          </Panel>
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="Reading your roles…" />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Note}" />
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding HasActive}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Switched On" />
            <ItemsControl ItemsSource="{Binding Active}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:MyRoleRow">
                  <Border Classes="valuerow">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Classes="caption" Text="{Binding Detail}" />
                      </StackPanel>
                      <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="danger-outline" Content="Switch Off" Command="{Binding DeactivateCommand}" IsVisible="{Binding IsActivated}"
                              VerticalAlignment="Center" ToolTip.Tip="End it now, before it runs out (added to Pending changes)" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding !HasNote}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Eligible" />
            <TextBlock Classes="muted" Text="You aren't eligible for any roles." IsVisible="{Binding HasNoEligible}" />
            <ItemsControl ItemsSource="{Binding Eligible}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:MyRoleRow">
                  <Border Classes="valuerow">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="caption" Text="{Binding Detail}" />
                        </StackPanel>
                        <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="outline" Content="Switch On…" Command="{Binding OpenCommand}" VerticalAlignment="Center"
                                ToolTip.Tip="Choose how long and say why" />
                      </Grid>
                      <StackPanel Spacing="8" IsVisible="{Binding IsOpen}" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="caption" Text="For (Hours)" VerticalAlignment="Center" />
                          <ComboBox ItemsSource="{Binding HourChoices}" SelectedItem="{Binding Hours}" MinWidth="90" />
                        </StackPanel>
                        <TextBox Text="{Binding Justification}" PlaceholderText="Why you need it" Width="480" HorizontalAlignment="Left" />
                        <TextBox Text="{Binding Ticket}" PlaceholderText="Ticket number" Width="260" HorizontalAlignment="Left" IsVisible="{Binding NeedsTicket}" />
                        <TextBlock Classes="caption" Text="{Binding Needs}" IsVisible="{Binding HasNeeds}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource BadgeWarningFg}" />
                        <Button Classes="accent" Content="Add to Pending Changes" Command="{Binding ActivateCommand}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Approvals (PIM): requests waiting for the admin -->
    <Panel IsVisible="{Binding ShowApprovals}">
    <ScrollViewer DataContext="{Binding Approvals}" x:DataType="rec:ApprovalsViewModel">
      <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Command="{Binding ReadAgainCommand}" ToolTip.Tip="Read requests from Entra again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="Requests to switch a role on that are waiting for your answer." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
          <Panel Width="18" Height="18" VerticalAlignment="Center">
            <Ellipse Classes="spintrack" />
            <Arc Classes="spinner" StartAngle="0" SweepAngle="90">
              <Arc.RenderTransform>
                <RotateTransform />
              </Arc.RenderTransform>
            </Arc>
          </Panel>
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="Reading requests waiting for you…" />
        </StackPanel>
        <Border Classes="banner neutral" IsVisible="{Binding HasNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Note}" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" Text="Nothing is waiting for you." IsVisible="{Binding HasNone}" />
        <ItemsControl ItemsSource="{Binding Requests}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:RoleRequestRow">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Who}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding What}" />
                      <TextBlock Classes="caption" Text="{Binding Why}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding When}" />
                    </StackPanel>
                    <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="Warning" IsVisible="{Binding HasState}" VerticalAlignment="Top" />
                  </Grid>
                  <TextBox Text="{Binding Reason}" PlaceholderText="Your reason (optional)" Width="480" HorizontalAlignment="Left" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Content="Approve" Command="{Binding ApproveCommand}" ToolTip.Tip="Added to Pending changes" />
                    <Button Classes="danger-outline" Content="Deny" Command="{Binding DenyCommand}" ToolTip.Tip="Added to Pending changes" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
