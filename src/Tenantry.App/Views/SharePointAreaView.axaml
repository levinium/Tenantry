<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:listviews="using:Tenantry.App.Lists"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.SharePointAreaView"
             x:DataType="vm:SharePointAreaViewModel">
  <DockPanel>
    <!-- The area's pages -->
    <TabStrip DockPanel.Dock="Top" Classes="pagetabs" Margin="0,8,0,10" ItemsSource="{x:Static vm:SharePointAreaViewModel.Pages}" SelectedItem="{Binding SelectedPage}">
      <TabStrip.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </TabStrip.ItemsPanel>
      <TabStrip.ItemTemplate>
        <DataTemplate x:DataType="ms:MailSecurityPage">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="15" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabStrip.ItemTemplate>
    </TabStrip>

    <Panel>
      <ContentControl Content="{Binding Sites}" IsVisible="{Binding ShowSites}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>
      <ContentControl Content="{Binding OneDrives}" IsVisible="{Binding ShowOneDrives}">
        <ContentControl.DataTemplates>
          <listviews:ListViewCache />
        </ContentControl.DataTemplates>
      </ContentControl>

      <!-- Deleted sites: read live, with Refresh; why they can't be read when they can't -->
      <DockPanel IsVisible="{Binding ShowDeleted}">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost" Command="{Binding RefreshDeletedCommand}" ToolTip.Tip="Read deleted sites from SharePoint again">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:FluentIcon Icon="ArrowSync" FontSize="14" />
                <TextBlock Text="Refresh" />
              </StackPanel>
            </Button>
            <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Sites in SharePoint's recycle bin (kept 93 days) and deleted Microsoft 365 groups (kept 30 days). After that they're gone for good." />
          </StackPanel>
          <Border Classes="banner neutral" IsVisible="{Binding HasDeletedNote}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding DeletedNote}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <ContentControl Content="{Binding Deleted}">
          <ContentControl.DataTemplates>
            <listviews:ListViewCache />
          </ContentControl.DataTemplates>
        </ContentControl>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
