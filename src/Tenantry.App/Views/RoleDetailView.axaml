<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.RoleDetailView"
             x:DataType="vm:RoleDetailViewModel">
  <!-- A role's record: what it is and how privileged, then its assignments and permissions. -->
  <DockPanel Margin="8,12,8,0">
    <Border DockPanel.Dock="Top" Classes="card">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <Border Classes="avatar large" VerticalAlignment="Top">
          <ic:FluentIcon Icon="PersonKey" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Classes="h1" Text="{Binding Title}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <c:Badge Text="Privileged" Kind="Warning" IsVisible="{Binding IsPrivileged}" ToolTip.Tip="Can change security settings or reach everyone's data" />
            <c:Badge Text="{Binding TypeText}" Kind="Neutral" />
          </WrapPanel>
          <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
          <TextBlock Classes="caption" Text="{Binding CountsText}" />
          <TextBlock Classes="caption pendingtext" Text="{Binding PendingText}" IsVisible="{Binding HasPending}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
          <Button Command="{Binding OpenInAdminCenterCommand}" ToolTip.Tip="Open this role in the Entra admin center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="Globe" FontSize="16" />
              <TextBlock Text="Open in Admin Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding EditRoleCommand}" IsVisible="{Binding CanEditRole}" ToolTip.Tip="Change its name, description or permissions">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="Edit" FontSize="16" />
              <TextBlock Text="Edit Role" />
            </StackPanel>
          </Button>
          <Button Classes="danger-outline" Command="{Binding DeleteRoleCommand}" IsVisible="{Binding CanEditRole}"
                  ToolTip.Tip="Delete this custom role (added to Pending Changes; you type its name to confirm)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="Delete" FontSize="16" />
              <TextBlock Text="Delete Role" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Classes="recordtabs" Margin="0,8,0,0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="rec:RecordSection">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="rec:RecordSection">
          <ScrollViewer Padding="0,12,0,24">
            <ContentControl Content="{Binding}" />
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</UserControl>
