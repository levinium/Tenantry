<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.ListSearchBox"
             x:Name="Root">
  <!-- Searches the rows already in a list; it never adds anything (the Add button does).
       Sits at the top right of its list, with the Add button at the top left. -->
  <StackPanel Spacing="4">
    <TextBox x:Name="Box" Text="{Binding #Root.Text}" PlaceholderText="{Binding #Root.Placeholder}" Width="300">
      <TextBox.InnerLeftContent>
        <ic:FluentIcon Icon="Filter" FontSize="14" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
      </TextBox.InnerLeftContent>
    </TextBox>
    <TextBlock x:Name="NoMatch" Classes="caption" Margin="4,0,0,0" Text="Nothing here matches." IsVisible="False" />
  </StackPanel>
</UserControl>
