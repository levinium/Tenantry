<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:views="using:Tenantry.App.Views"
             x:Class="Tenantry.App.Views.FoundFilesSelectionView"
             x:DataType="vm:FoundFilesSelectionViewModel">
  <StackPanel Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Classes="h3" Text="{Binding Heading}" />
      <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
    </StackPanel>
    <views:FoundFileActionsView DataContext="{Binding Actions}" />
  </StackPanel>
</UserControl>
