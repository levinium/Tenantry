<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.AutopilotPreviewView"
             x:DataType="rec:AutopilotPreviewViewModel">
  <StackPanel Spacing="16">
    <StackPanel Spacing="6">
      <SelectableTextBlock Classes="h3" Text="{Binding Serial}" />
      <TextBlock Classes="caption" Text="{Binding Model}" />
      <WrapPanel ItemSpacing="6" LineSpacing="4">
        <c:Badge Text="{Binding ProfileText}" Kind="{Binding ProfileKind}" ToolTip.Tip="Whether an Autopilot profile is assigned" />
        <c:Badge Text="{Binding EnrollmentText}" Kind="{Binding EnrollmentKind}" ToolTip.Tip="Whether it has been set up through Autopilot" />
      </WrapPanel>
      <Button Classes="link" Content="Open Its Device Page" Command="{Binding OpenManagedCommand}" IsVisible="{Binding CanOpenManaged}" HorizontalAlignment="Left"
              ToolTip.Tip="The Intune device it enrolled as" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Facts}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="rec:SummaryLine">
          <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
            <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="divider" />
    <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ic:FluentIcon Icon="LockClosed" FontSize="16" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding EditReason}" />
      </StackPanel>
    </Border>
    <Panel IsVisible="{Binding CanEdit}">
      <StackPanel Spacing="8">
        <TextBlock Classes="h3" Text="Actions" />
        <views:BulkEditorView DataContext="{Binding Actions}" />
      </StackPanel>
    </Panel>
  </StackPanel>
</UserControl>
