<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.DeviceAppsSectionView"
             x:DataType="rec:DeviceAppsSection">
  <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Stretch">
    <views:DeviceSectionStatusView />
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="h3" Text="Assigned by Intune" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Apps Intune installs for its primary user, and how each one went on this device." />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding AssignedNote}" IsVisible="{Binding HasAssignedNote}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Assigned}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:AppStateRow">
              <Border Classes="valuerow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                  </StackPanel>
                  <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="{Binding StateKind}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="h3" Text="{Binding InstalledHeading}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Everything the device reports installed, as Intune last heard it." />
        </StackPanel>
        <TextBox Text="{Binding Search}" PlaceholderText="Search apps or publishers" MaxWidth="420" HorizontalAlignment="Left" Width="420" />
        <TextBlock Classes="muted" Text="It reports no installed apps." IsVisible="{Binding HasNoInstalled}" />
        <ItemsControl ItemsSource="{Binding Installed}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rec:DetectedAppRow">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4">
                <ic:FluentIcon Icon="AppGeneric" FontSize="16" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <SelectableTextBlock Text="{Binding Name}" />
                  <TextBlock Classes="caption" Text="{Binding Detail}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
