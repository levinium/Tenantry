<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.SiteDetailView"
             x:DataType="vm:SiteDetailViewModel">
  <!-- A site's record: what it is, whose and how shared, then one tab per area. -->
  <DockPanel Margin="8,12,8,0">
    <Border DockPanel.Dock="Top" Classes="card">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <Border Classes="avatar large" VerticalAlignment="Top">
          <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" DataContext="{Binding Summary}" x:DataType="rec:SitePreviewViewModel">
          <TextBlock Classes="h1" Text="{Binding Title}" TextWrapping="Wrap" />
          <Button Classes="link" Command="{Binding OpenSiteCommand}" HorizontalAlignment="Left" ToolTip.Tip="Open it in the browser">
            <TextBlock Text="{Binding Url}" TextWrapping="Wrap" />
          </Button>
          <WrapPanel ItemSpacing="8" LineSpacing="6" Margin="0,4,0,0">
            <c:Badge Text="{Binding KindText}" Kind="Neutral" />
            <c:Badge Text="Team" Kind="Info" IsVisible="{Binding IsTeam}" ToolTip.Tip="Connected to Microsoft Teams" />
            <c:Badge Text="{Binding StateText}" Kind="{Binding StateKind}" />
            <c:Badge Text="{Binding SharingText}" Kind="{Binding SharingKind}" ToolTip.Tip="Who it can be shared with outside the organization" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="caption" Text="Owner:" VerticalAlignment="Center" />
            <Button Classes="link" Content="{Binding OwnerText}" Command="{Binding OpenOwnerCommand}" IsVisible="{Binding CanOpenOwner}" ToolTip.Tip="Open their record" />
            <TextBlock Classes="caption" Text="{Binding OwnerText}" IsVisible="{Binding !CanOpenOwner}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="caption pendingtext" Text="{Binding $parent[UserControl].((vm:SiteDetailViewModel)DataContext).PendingText}"
                     IsVisible="{Binding $parent[UserControl].((vm:SiteDetailViewModel)DataContext).HasPending}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Command="{Binding OpenSiteCommand}" VerticalAlignment="Top" ToolTip.Tip="Open the site in the browser">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="Open" FontSize="16" />
            <TextBlock Text="Open Site" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <TabControl Classes="recordtabs" Margin="0,8,0,0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="rec:RecordSection">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="rec:RecordSection">
          <ScrollViewer Padding="0,12,0,24">
            <ContentControl Content="{Binding}" />
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</UserControl>
