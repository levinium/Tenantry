<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.ContactPreviewView"
             x:DataType="vm:ContactDetailViewModel">
  <!-- The contact, stacked to fit the preview pane; changes are made on its page. -->
  <StackPanel Spacing="18">
    <StackPanel Spacing="10">
      <Border Classes="avatar large" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Initials}" />
      </Border>
      <StackPanel Spacing="2">
        <TextBlock Classes="h2" Text="{Binding Contact.DisplayName}" TextWrapping="Wrap" />
        <SelectableTextBlock Classes="muted" Text="{Binding Email}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding WorkText}" IsVisible="{Binding HasWorkText}" TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Text="Contact" Kind="Neutral" />
        <c:Badge Text="Hidden from the Address List" Kind="Warning" IsVisible="{Binding IsHidden}" />
        <c:Badge Text="Synced from On-Premises AD" Kind="Neutral" IsVisible="{Binding IsSynced}" />
      </WrapPanel>
      <Button Classes="accent" HorizontalAlignment="Left" Command="{Binding OpenPageCommand}" IsVisible="{Binding CanOpenPage}"
              ToolTip.Tip="Edit its details, address list setting and lists, or delete it">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="Edit" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="Open Contact Page" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <Border Classes="divider" />
    <StackPanel Spacing="10">
      <TextBlock Classes="h3" Text="{Binding ListsHeading}" />
      <TextBlock Classes="muted" Text="{Binding ListsText}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding FirstLists}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MemberRow">
            <StackPanel Spacing="1">
              <Button Classes="namelink" Command="{Binding $parent[UserControl].((vm:ContactDetailViewModel)DataContext).OpenListCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="Open the list's page">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </Button>
              <TextBlock Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption" Text="{Binding MoreListsText}" TextWrapping="Wrap"
                 IsVisible="{Binding MoreListsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
