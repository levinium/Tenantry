<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:org="using:Tenantry.ViewModels.Organization"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:listviews="using:Tenantry.App.Lists"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:views="using:Tenantry.App.Views"
             x:Class="Tenantry.App.Views.OrganizationAreaView"
             x:DataType="vm:OrganizationAreaViewModel">
  <DockPanel>
    <!-- The area's pages, in sections: the sections on one row, the chosen section's pages under it. -->
    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,10" Spacing="6">
      <TabStrip Classes="pagetabs" ItemsSource="{x:Static vm:OrganizationAreaViewModel.Sections}" SelectedItem="{Binding SelectedSection}">
        <TabStrip.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </TabStrip.ItemsPanel>
        <TabStrip.ItemTemplate>
          <DataTemplate x:DataType="vm:SecurityPageGroup">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
      <Border Background="{DynamicResource SubtleBg}" CornerRadius="8" Padding="6,2">
        <TabStrip Classes="pagetabs" ItemsSource="{Binding SelectedSection.Pages}" SelectedItem="{Binding SelectedPage}">
          <TabStrip.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </TabStrip.ItemsPanel>
          <TabStrip.ItemTemplate>
            <DataTemplate x:DataType="ms:MailSecurityPage">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" />
              </StackPanel>
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>
      </Border>
    </StackPanel>
    <Grid>


    <!-- Billing, settings, identity and Teams: pages of cards -->
    <Panel IsVisible="{Binding ShowOrgPage}">
      <views:OrgPageView DataContext="{Binding CurrentOrgPage}" />
    </Panel>

    <!-- Usage Reports: a report and a period, then the report as a list -->
    <Panel IsVisible="{Binding ShowUsage}">
      <DockPanel DataContext="{Binding Usage}" x:DataType="org:UsageReportsViewModel">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox ItemsSource="{x:Static org:UsageReportsViewModel.Reports}" SelectedItem="{Binding Report}" MinWidth="280" />
            <ComboBox ItemsSource="{x:Static org:UsageReportsViewModel.Periods}" SelectedItem="{Binding Period}" MinWidth="170" />
            <TextBlock Classes="muted" Text="Reading the report from Microsoft…" IsVisible="{Binding IsReading}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="caption" Text="{Binding About}" TextWrapping="Wrap" />
          <Border Classes="banner neutral" IsVisible="{Binding HasNote}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Note}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <ContentControl Content="{Binding List}">
          <ContentControl.DataTemplates>
            <listviews:ListViewCache />
          </ContentControl.DataTemplates>
        </ContentControl>
      </DockPanel>
    </Panel>

    </Grid>
  </DockPanel>
</UserControl>
