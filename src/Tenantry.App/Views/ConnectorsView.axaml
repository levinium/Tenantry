<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             xmlns:listviews="using:Tenantry.App.Lists"
             x:Class="Tenantry.App.Views.ConnectorsView"
             x:DataType="ms:ConnectorsViewModel">
  <!-- One row a connector in the standard list; switching one on or off, or deleting it, is in its preview. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="How mail moves between Microsoft 365 and your own mail servers, partners or a filtering service in front of Microsoft 365. Most organizations need none." />
      <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}" Margin="0,4,0,0">
        <TextBlock TextWrapping="Wrap" Text="{Binding EditReason}" />
      </Border>
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
    </StackPanel>
    <ContentControl Content="{Binding List}">
      <ContentControl.DataTemplates>
        <listviews:ListViewCache />
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</UserControl>
