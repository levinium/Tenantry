<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.CaPolicyDetailView"
             x:DataType="vm:CaPolicyDetailViewModel">
  <!-- A Conditional Access policy: its state switch, the policy in words, and Entra's JSON. -->
  <ScrollViewer Margin="8,12,8,0">
    <StackPanel Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,24">
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
          <Border Classes="avatar large" VerticalAlignment="Top">
            <ic:FluentIcon Icon="ShieldLock" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock Classes="h1" Text="{Binding Title}" TextWrapping="Wrap" />
            <c:Badge Text="{Binding StateText}" Kind="{Binding StateKind}" HorizontalAlignment="Left" />
            <TextBlock Classes="caption" Text="{Binding Dates}" />
            <TextBlock Classes="caption pendingtext" Text="{Binding PendingText}" IsVisible="{Binding HasPending}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
            <Button Command="{Binding OpenInAdminCenterCommand}" ToolTip.Tip="Open this policy in the Entra admin center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Globe" FontSize="16" />
                <TextBlock Text="Open in Admin Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding EditPolicyCommand}" IsVisible="{Binding CanEditPolicy}" ToolTip.Tip="Open it in the editor">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Edit" FontSize="16" />
                <TextBlock Text="Edit Policy" />
              </StackPanel>
            </Button>
            <Button Classes="danger-outline" Command="{Binding DeleteCommand}" IsVisible="{Binding CanEdit}"
                    ToolTip.Tip="Delete this policy (added to Pending Changes; you type its name to confirm)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Delete" FontSize="16" />
                <TextBlock Text="Delete Policy" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="State" />
          <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="LockClosed" FontSize="16" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding EditReason}" />
            </StackPanel>
          </Border>
          <ListBox Classes="options" ItemsSource="{x:Static vm:CaStateChoice.All}" SelectedItem="{Binding State}" IsEnabled="{Binding CanEdit}" Background="Transparent">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CaStateChoice">
                <StackPanel Spacing="2" Margin="2,4">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Choosing one adds it to Pending Changes; nothing changes until you apply them." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="The Policy" />
          <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="rec:SummaryLine">
          <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
            <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
        </StackPanel>
      </Border>

      <Expander Header="Technical Details (JSON)" HorizontalAlignment="Stretch">
        <SelectableTextBlock Text="{Binding Json}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
