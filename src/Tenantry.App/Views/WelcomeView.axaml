<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:c="using:Tenantry.App.Controls"
             x:Class="Tenantry.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel"
             x:Name="Root">
  <ScrollViewer>
    <StackPanel Margin="48,40,48,40" Spacing="24" MaxWidth="880">

      <!-- Header: who we are on the left, the one main action on the right -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Image Source="/Assets/tenantry-256.png" Width="44" Height="44" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Classes="h2" Text="Tenantry" />
          <TextBlock Classes="caption" Text="Microsoft 365 Administration" />
        </StackPanel>
        <Button Grid.Column="2" Classes="accent" VerticalAlignment="Center" Command="{Binding AddTenantCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="Add" FontSize="16" />
            <TextBlock Text="Add Tenant" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Sign-in status -->
      <Border Classes="banner info" IsVisible="{Binding IsBusy}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}" />
          <Button Grid.Column="1" Content="Cancel Sign-In" Command="{Binding CancelSignInCommand}" />
        </Grid>
      </Border>
      <Border Classes="banner error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
      </Border>

      <!-- Tenants: one list, one row each; searchable once there are several -->
      <StackPanel Spacing="10" IsVisible="{Binding HasProfiles}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <TextBlock Classes="label" Text="TENANTS" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" MaxWidth="360" HorizontalAlignment="Right" Text="{Binding SearchText}"
                   PlaceholderText="Search tenants by name, domain or account" IsVisible="{Binding ShowSearch}">
            <TextBox.InnerLeftContent>
              <ic:FluentIcon Icon="Search" FontSize="14" Margin="10,0,2,0" Foreground="{DynamicResource TextMuted}" />
            </TextBox.InnerLeftContent>
          </TextBox>
        </Grid>
        <TextBlock Classes="muted" Margin="4,8" IsVisible="{Binding NoSearchMatches}" Text="No tenants match that search." />
        <Border Classes="card tight" ClipToBounds="True" IsVisible="{Binding !NoSearchMatches}">
          <ItemsControl ItemsSource="{Binding VisibleProfiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TenantCard">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0">
                    <Button Classes="listrow" Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).ConnectCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Open this tenant">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Classes="avatar" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Initials}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="h3" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <c:Badge Text="Default" Kind="Info" IsVisible="{Binding IsDefault}"
                                     ToolTip.Tip="Opens automatically when Tenantry starts" />
                          </StackPanel>
                          <TextBlock Classes="caption" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding PrimaryDomain}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding AccountText}" />
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                          <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding LastUsedText}" />
                          <ic:FluentIcon Icon="ChevronRight" FontSize="16" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="rowaction" Margin="4,0,12,0" VerticalAlignment="Center" ToolTip.Tip="More">
                      <ic:FluentIcon Icon="MoreHorizontal" FontSize="18" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="Open" Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).ConnectCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                              <ic:FluentIcon Icon="Open" FontSize="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Open at Startup (Make Default)" IsVisible="{Binding !IsDefault}"
                                    Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).SetDefaultCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                              <ic:FluentIcon Icon="Star" FontSize="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Stop Opening at Startup" IsVisible="{Binding IsDefault}"
                                    Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).ClearDefaultCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                              <ic:FluentIcon Icon="Star" FontSize="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="Remove from This Computer…" Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).AskRemoveCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                              <ic:FluentIcon Icon="Delete" FontSize="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>

                  <!-- Confirmation, in place, only after choosing Remove from the menu -->
                  <Border IsVisible="{Binding IsConfirmingRemove}" Background="{DynamicResource BannerErrorBg}" Padding="20,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding RemoveQuestion}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="danger" Content="Remove" Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).ConfirmRemoveCommand}" CommandParameter="{Binding}" />
                        <Button Content="Cancel" Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).CancelRemoveCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="divider" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- No tenants yet -->
      <Border Classes="card" IsVisible="{Binding HasNoProfiles}" Padding="32">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <ic:FluentIcon Icon="Organization" FontSize="36" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
          <TextBlock Classes="h3" HorizontalAlignment="Center" Text="No Tenants Yet" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     Text="Add a Microsoft 365 tenant you administer. Tenantry walks you through connecting it." />
          <Button Classes="accent" HorizontalAlignment="Center" Content="Add Tenant" Command="{Binding AddTenantCommand}" />
        </StackPanel>
      </Border>

      <!-- The demo, out of the way -->
      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="Want to look around first?" />
        <Button Classes="link" Command="{Binding OpenDemoCommand}" Content="Explore the Demo Tenant" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
