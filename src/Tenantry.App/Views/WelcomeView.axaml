<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:tenancy="using:Tenantry.Core.Tenancy"
             x:Class="Tenantry.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel"
             x:Name="Root">
  <ScrollViewer>
    <StackPanel Margin="48" Spacing="20" MaxWidth="720" HorizontalAlignment="Center">
      <StackPanel Spacing="4">
        <TextBlock FontSize="32" FontWeight="SemiBold" Text="Tenantry" />
        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                   Text="Administer Microsoft 365: users, mail, groups, devices and security, in one fast app." />
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding HasProfiles}">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Your tenants" />
        <ItemsControl ItemsSource="{Binding Profiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tenancy:TenantProfile">
              <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="6"
                      Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBlock Opacity="0.7" Text="{Binding PrimaryDomain}" />
                    <TextBlock Opacity="0.5" FontSize="12" Text="{Binding LastAccount}" />
                  </StackPanel>
                  <Button Grid.Column="1" Margin="8,0" Content="Open" Classes="accent" VerticalAlignment="Center"
                          Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).ConnectCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Content="Remove" VerticalAlignment="Center"
                          ToolTip.Tip="Forget this tenant on this computer (the app registration in the tenant is not touched)"
                          Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Add a tenant…" Classes="accent" Command="{Binding AddTenantCommand}" />
        <Button Content="Open the demo tenant" Command="{Binding OpenDemoCommand}" />
        <Button Content="Cancel sign-in" IsVisible="{Binding IsBusy}" Command="{Binding CancelSignInCommand}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
      <Border IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#33E81123" Padding="12,8" CornerRadius="4">
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
