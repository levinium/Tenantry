<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.NewAppView"
             x:DataType="rec:NewAppViewModel">
  <!-- New App Registration: name, who can sign in, and where sign-ins return. -->
  <StackPanel Spacing="14" Width="620">
    <StackPanel Spacing="4">
      <TextBlock Classes="label" Text="NAME" />
      <TextBox Text="{Binding Name}" PlaceholderText="What people will see, like Expense Reports" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="label" Text="WHO CAN SIGN IN" />
      <ListBox Classes="options" ItemsSource="{x:Static rec:NewAppViewModel.Audiences}" SelectedItem="{Binding Audience}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="ed:EditorChoice">
            <StackPanel Spacing="2" Margin="2,4">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="label" Text="WHERE IT RUNS (REDIRECT URI)" />
      <ComboBox ItemsSource="{x:Static rec:NewAppViewModel.Platforms}" SelectedItem="{Binding Platform}" MinWidth="240">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="ed:EditorChoice">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding Label}" />
              <TextBlock Classes="caption" Text="{Binding Detail}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox Text="{Binding RedirectUri}" IsVisible="{Binding HasPlatform}" PlaceholderText="https://app.example.com/signin" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
            <ic:FluentIcon Icon="Warning" FontSize="14" Foreground="{DynamicResource BadgeWarningFg}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource BadgeWarningFg}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="accent" Content="Add to Pending Changes" Command="{Binding AddCommand}" ToolTip.Tip="Its enterprise app is made with it; nothing changes until you apply" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>