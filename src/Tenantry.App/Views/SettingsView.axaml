<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!-- Areas down the left (Sync for now), the chosen area's settings on the right. -->
  <Grid ColumnDefinitions="180,Auto,*" Width="960">
    <ListBox Classes="nav" ItemsSource="{Binding SettingsAreas}" SelectedItem="{Binding SelectedArea}" VerticalAlignment="Top">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SettingsArea">
          <StackPanel Orientation="Horizontal" Spacing="10" ToolTip.Tip="{Binding Description}">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Column="1" Classes="vdivider" Margin="16,0" />

    <!-- Sync -->
    <StackPanel Grid.Column="2" Spacing="18" IsVisible="{Binding IsSyncArea}">
      <StackPanel Spacing="4">
        <TextBlock Classes="h2" Text="Sync" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Lists and searches read an encrypted copy of this tenant kept on this computer, so they're instant. These choices are for this tenant only and are saved as you change them." />
      </StackPanel>

      <!-- Now: the actions first -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="accent" Command="{Binding SyncEverythingCommand}" ToolTip.Tip="Check for changes and re-read everything now, whatever the schedule">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="ArrowSync" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="Check Everything Now" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding StartOverCommand}" IsVisible="{Binding !IsConfirmingStartOver}"
                ToolTip.Tip="Forget what's kept and download the whole tenant again (for when something looks wrong)">
          <TextBlock Text="Download Everything Again…" />
        </Button>
        <Button Classes="danger-outline" Command="{Binding StartOverCommand}" IsVisible="{Binding IsConfirmingStartOver}"
                ToolTip.Tip="This can take a few minutes for a large tenant">
          <TextBlock Text="Yes, Download Everything Again" />
        </Button>
        <Button Classes="ghost" Content="Cancel" Command="{Binding CancelStartOverCommand}" IsVisible="{Binding IsConfirmingStartOver}" />
      </StackPanel>

      <!-- A sync running now (from here, the sidebar or the timer), and the background read -->
      <Border Classes="banner info" IsVisible="{Binding HasLiveText}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Classes="spin" Icon="ArrowSync" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center">
              <ic:FluentIcon.RenderTransform>
                <RotateTransform />
              </ic:FluentIcon.RenderTransform>
            </ic:FluentIcon>
            <TextBlock Text="{Binding LiveText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <ProgressBar Classes="working" />
        </StackPanel>
      </Border>
      <Border Classes="banner neutral" IsVisible="{Binding HasBackgroundText}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ic:FluentIcon Classes="spin" Icon="ArrowSync" FontSize="16" VerticalAlignment="Center">
            <ic:FluentIcon.RenderTransform>
              <RotateTransform />
            </ic:FluentIcon.RenderTransform>
          </ic:FluentIcon>
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="In the Background: " FontWeight="SemiBold" />
            <Run Text="{Binding BackgroundText}" />
          </TextBlock>
        </StackPanel>
      </Border>
      <TextBlock Classes="muted" Text="{Binding Status}" IsVisible="{Binding ShowStatus}" TextWrapping="Wrap" />

      <!-- How often -->
      <StackPanel Spacing="12">
        <TextBlock Classes="h3" Text="How Often" />
        <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Check for Changes" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Users, groups and licenses: only what changed, so it's quick." />
          </StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.ChangesOptions}" SelectedItem="{Binding Changes}" MinWidth="320" VerticalAlignment="Center" />

          <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Re-Read Mailboxes and Sign-Ins" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Mailbox settings, who can use shared mailboxes, last sign-in times, domains and Teams: read in full." />
          </StackPanel>
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.DetailsOptions}" SelectedItem="{Binding Details}" MinWidth="320" VerticalAlignment="Center" />

          <StackPanel Grid.Row="2" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Read Automatic Replies" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="For the Automatic reply on view. One read per mailbox, in the background." />
          </StackPanel>
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.MailboxDetailsOptions}" SelectedItem="{Binding MailboxDetails}" MinWidth="320" VerticalAlignment="Center" />

          <StackPanel Grid.Row="3" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Read Mailbox Sizes" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="For the Mailbox nearly full view. Sizes change slowly, so less often is fine. One read per mailbox, in the background." />
          </StackPanel>
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.MailboxSizesOptions}" SelectedItem="{Binding MailboxSizes}" MinWidth="320" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <Border Classes="divider" />

      <!-- What's in the copy, and when -->
      <StackPanel Spacing="10" IsVisible="{Binding HasAreas}">
        <TextBlock Classes="h3" Text="What's Kept, and When It Was Last Read" />
        <ItemsControl ItemsSource="{Binding Areas}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SyncAreaRow">
              <Border Classes="valuerow">
                <Grid ColumnDefinitions="*,150,170" ColumnSpacing="12">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding Holds}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Last}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Every}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <!-- Passwords -->
    <Panel Grid.Column="2" IsVisible="{Binding IsPasswordsArea}">
    <StackPanel Spacing="18" DataContext="{Binding Passwords}" x:DataType="vm:PasswordStyleViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="h2" Text="Passwords" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="How Tenantry makes new passwords when it resets one, for this tenant. You can still type your own password when resetting one person. Saved as you change it." />
      </StackPanel>

      <!-- Simple or a pattern -->
      <StackPanel Spacing="6">
        <RadioButton GroupName="passwordmode" IsChecked="{Binding UseSimple}" Content="Simple: Choose a Length and Which Kinds of Characters" />
        <RadioButton GroupName="passwordmode" IsChecked="{Binding UsePattern}" Content="Pattern: Spell Out the Format, Part by Part, in Order" />
      </StackPanel>

      <!-- What they'll look like -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="EXAMPLES" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding !HasProblem}">
            <ItemsControl ItemsSource="{Binding Examples}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="24" LineSpacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <SelectableTextBlock Classes="code" FontSize="18" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Column="1" Content="More Examples" Command="{Binding NewExampleCommand}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding !HasProblem}" />
          <Border Classes="banner error" IsVisible="{Binding HasProblem}">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Pattern: the parts in order, and the same as short text -->
      <StackPanel Spacing="12" IsVisible="{Binding UsePattern}">
        <ItemsControl ItemsSource="{Binding Parts}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PatternPartRow">
              <Border Classes="valuerow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <WrapPanel ItemSpacing="10" LineSpacing="8" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{x:Static vm:PatternPartRow.Kinds}" SelectedItem="{Binding Kind}" MinWidth="250" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCount}" VerticalAlignment="Center">
                      <NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="64" Increment="1" FormatString="0" Width="110" ToolTip.Tip="How many" />
                      <TextBlock Classes="caption" Text="to" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding UpTo}" Minimum="1" Maximum="64" Increment="1" FormatString="0" Width="150" PlaceholderText="(exactly)"
                                     ToolTip.Tip="Leave empty for exactly that many; set it for a range" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasLetterRules}" VerticalAlignment="Center">
                      <TextBlock Classes="caption" Text="At least" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding MinCapitals}" Minimum="0" Maximum="64" Increment="1" FormatString="0" Width="100" />
                      <TextBlock Classes="caption" Text="capital," VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding MinSmall}" Minimum="0" Maximum="64" Increment="1" FormatString="0" Width="100" />
                      <TextBlock Classes="caption" Text="small" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox Text="{Binding Text}" IsVisible="{Binding IsExact}" PlaceholderText="Text, like -" MinWidth="140" VerticalAlignment="Center" />
                  </WrapPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="ghost" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move this part earlier" Padding="6">
                      <ic:FluentIcon Icon="ArrowUp" FontSize="14" />
                    </Button>
                    <Button Classes="ghost" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move this part later" Padding="6">
                      <ic:FluentIcon Icon="ArrowDown" FontSize="14" />
                    </Button>
                    <Button Classes="ghost" Command="{Binding RemoveCommand}" ToolTip.Tip="Take this part out" Padding="6">
                      <ic:FluentIcon Icon="Delete" FontSize="14" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="link" HorizontalAlignment="Left" Command="{Binding AddPartCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="Add" FontSize="14" />
            <TextBlock Text="Add a Part" />
          </StackPanel>
        </Button>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="AS PATTERN TEXT" />
          <TextBox Text="{Binding PatternText}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="15" MaxWidth="480" HorizontalAlignment="Left" MinWidth="320" />
          <TextBlock Classes="error" Text="{Binding PatternTextProblem}" IsVisible="{Binding HasPatternTextProblem}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{Binding PatternHelp}" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox Content="Leave Out Characters That Look Alike (0 and O, 1 and l, 5 and S)" IsChecked="{Binding AvoidLookAlikes}" />
      </StackPanel>

      <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="14" IsVisible="{Binding UseSimple}">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Length" FontWeight="SemiBold" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Characters, not counting dashes. 16 or more is strong." />
        </StackPanel>
        <NumericUpDown Grid.Column="1" Value="{Binding Length}" Minimum="{Binding MinLength}" Maximum="{Binding MaxLength}" Increment="1" FormatString="0"
                       Width="140" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Letters" FontWeight="SemiBold" />
        </StackPanel>
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:PasswordStyleViewModel.LetterChoices}" SelectedItem="{Binding Letters}" MinWidth="320" VerticalAlignment="Center" />

        <StackPanel Grid.Row="2" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Numbers" FontWeight="SemiBold" />
        </StackPanel>
        <CheckBox Grid.Row="2" Grid.Column="1" Content="Include Numbers (0–9)" IsChecked="{Binding Numbers}" VerticalAlignment="Center" />

        <StackPanel Grid.Row="3" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Symbols" FontWeight="SemiBold" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Some symbols take several taps to find on a phone keyboard." />
        </StackPanel>
        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:PasswordStyleViewModel.SymbolChoices}" SelectedItem="{Binding Symbols}" MinWidth="320" VerticalAlignment="Center" />

        <StackPanel Grid.Row="4" Spacing="2" VerticalAlignment="Top">
          <TextBlock Text="Easier to Read Out" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8">
          <CheckBox Content="Split Into Groups of Four with Dashes, Like Kp7r-Xw3n" IsChecked="{Binding Groups}" />
          <CheckBox Content="Leave Out Characters That Look Alike (0 and O, 1 and l, 5 and S)" IsChecked="{Binding AvoidLookAlikes}" />
        </StackPanel>
      </Grid>

      <Button Content="Go Back to Tenantry's Standard Style" Command="{Binding UseDefaultCommand}" IsVisible="{Binding !IsDefault}" HorizontalAlignment="Left" />
    </StackPanel>
    </Panel>
  </Grid>
</UserControl>
