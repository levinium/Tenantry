<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             x:Class="Tenantry.App.Views.AuditRecordPreviewView"
             x:DataType="rec:AuditRecordPreviewViewModel">
  <!-- One audit record: who, what, where, and the whole record to read or copy. -->
  <StackPanel Spacing="14">
    <StackPanel Spacing="4">
      <SelectableTextBlock Classes="h3" Text="{Binding Title}" TextWrapping="Wrap" />
      <SelectableTextBlock Classes="caption" Text="{Binding Subtitle}" TextWrapping="Wrap" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Facts}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="rec:SummaryLine">
          <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
            <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Classes="divider" />
    <TextBlock Classes="label" Text="THE WHOLE RECORD" />
    <Border Classes="valuerow">
      <SelectableTextBlock Text="{Binding Json}" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
    </Border>
  </StackPanel>
</UserControl>