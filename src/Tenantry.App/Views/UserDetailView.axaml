<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.UserDetailView"
             x:DataType="vm:UserDetailViewModel">
  <!-- A user's record: who they are and what to do, then one tab per area. -->
  <DockPanel Margin="8,12,8,0">
    <Border DockPanel.Dock="Top" Classes="card">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <Border Classes="avatar large" VerticalAlignment="Top">
          <TextBlock Text="{Binding Initials}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Classes="h1" Text="{Binding User.DisplayName}" TextWrapping="Wrap" />
          <SelectableTextBlock Classes="muted" Text="{Binding SecondaryText}" />
          <WrapPanel ItemSpacing="8" LineSpacing="6" Margin="0,6,0,0">
            <c:Badge Text="{Binding StatusText}" Kind="{Binding StatusKind}" />
            <c:Badge Text="{Binding KindText}" Kind="{Binding KindKind}" />
            <ItemsControl ItemsSource="{Binding Health}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:HealthChip">
                  <c:Badge Text="{Binding Text}" Kind="{Binding Kind}" ToolTip.Tip="{Binding Tip}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>
          <TextBlock Classes="caption pendingtext" Text="{Binding PendingSignInText}" IsVisible="{Binding HasPendingSignIn}" />
        </StackPanel>

        <!-- Everyday actions as buttons; the disruptive one in a menu. All are staged for review. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Command="{Binding ResetPasswordCommand}" IsEnabled="{Binding CanEdit}"
                  ToolTip.Tip="{Binding ResetPasswordTip}" ToolTip.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="Password" FontSize="16" />
              <TextBlock Text="Reset password" />
            </StackPanel>
          </Button>
          <Button Classes="danger-outline" Classes.undo="{Binding HasPendingSignIn}" Command="{Binding ToggleSignInCommand}"
                  IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding SignInActionTip}" ToolTip.ShowOnDisabled="True">
            <TextBlock Text="{Binding SignInActionText}" />
          </Button>
          <Button IsEnabled="{Binding CanEdit}" ToolTip.Tip="More actions" ToolTip.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Actions" />
              <ic:FluentIcon Icon="ChevronDown" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{Binding SignOutText}" Command="{Binding SignOutEverywhereCommand}"
                          ToolTip.Tip="End every session and app sign-in; they sign in again (staged for review)">
                  <MenuItem.Icon>
                    <ic:FluentIcon Icon="SignOut" FontSize="16" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Classes="recordtabs" Margin="0,8,0,0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="rec:RecordSection">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="rec:RecordSection">
          <ScrollViewer Padding="0,12,0,24">
            <ContentControl Content="{Binding}" />
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</UserControl>
