<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             xmlns:views="using:Tenantry.App.Views"
             x:Class="Tenantry.App.Views.UserDetailView"
             x:DataType="vm:UserDetailViewModel">
  <ScrollViewer>
    <StackPanel Margin="8,16,8,24" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

      <!-- Who -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
          <Border Classes="avatar large" VerticalAlignment="Center">
            <TextBlock Text="{Binding Initials}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock Classes="h1" Text="{Binding User.DisplayName}" />
            <SelectableTextBlock Classes="muted" Text="{Binding User.UserPrincipalName}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <c:Badge Text="{Binding StatusText}" Kind="{Binding StatusKind}" />
              <c:Badge Text="{Binding KindText}" Kind="{Binding KindKind}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Facts, grouped so each card answers one question -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">

        <Border Grid.Row="0" Grid.Column="0" Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="PersonLock" FontSize="20" Foreground="{DynamicResource Accent}" />
              <TextBlock Classes="h3" Text="Sign-in" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="LAST SIGN-IN" />
              <TextBlock Classes="value" Text="{Binding LastSignInText}" />
              <TextBlock Classes="caption" Text="{Binding LastSignInExact}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="ACCOUNT CREATED" />
              <TextBlock Classes="value" Text="{Binding CreatedText}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <Button Classes="danger-outline" HorizontalAlignment="Left" Command="{Binding ToggleSignInCommand}"
                      IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding SignInActionTip}" ToolTip.ShowOnDisabled="True"
                      Classes.undo="{Binding HasPendingSignIn}">
                <TextBlock Text="{Binding SignInActionText}" />
              </Button>
              <TextBlock Classes="caption pendingtext" Text="{Binding PendingSignInText}" IsVisible="{Binding HasPendingSignIn}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Building" FontSize="20" Foreground="{DynamicResource Accent}" />
              <TextBlock Classes="h3" Text="Profile" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="14" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ed:EditableField">
                  <views:EditableFieldView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="EMAIL" />
              <SelectableTextBlock Classes="value" Text="{Binding Email}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="card">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Apps" FontSize="20" Foreground="{DynamicResource Accent}" />
              <TextBlock Classes="h3" Text="Licenses" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Licenses}" IsVisible="{Binding HasLicenses}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <c:Badge Text="{Binding}" Kind="Info" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" IsVisible="{Binding !HasLicenses}" Text="No licenses assigned." />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ic:FluentIcon Icon="Key" FontSize="20" Foreground="{DynamicResource Accent}" />
              <TextBlock Classes="h3" Text="Identifiers" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="OBJECT ID" />
              <SelectableTextBlock Classes="code" Text="{Binding User.Id}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="SIGN-IN NAME" />
              <SelectableTextBlock Classes="code" Text="{Binding User.UserPrincipalName}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
