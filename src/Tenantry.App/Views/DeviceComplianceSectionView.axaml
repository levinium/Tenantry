<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.DeviceComplianceSectionView"
             x:DataType="rec:DeviceComplianceSection">
  <UserControl.Resources>
    <!-- A policy: click to open its settings. Policies with a problem start open. -->
    <DataTemplate x:Key="Policy" x:DataType="rec:DevicePolicyRow">
      <Border Classes="valuerow">
        <StackPanel Spacing="8">
          <Button Classes="ghost" Command="{Binding ToggleCommand}" IsHitTestVisible="{Binding CanExpand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Padding="0" ToolTip.Tip="Show or hide what it checks on this device">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding SettingsText}" />
              </StackPanel>
              <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="{Binding StateKind}" VerticalAlignment="Center" />
              <Panel Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding CanExpand}">
                <ic:FluentIcon Icon="ChevronDown" FontSize="12" IsVisible="{Binding !IsExpanded}" />
                <ic:FluentIcon Icon="ChevronUp" FontSize="12" IsVisible="{Binding IsExpanded}" />
              </Panel>
            </Grid>
          </Button>
          <StackPanel Spacing="6" IsVisible="{Binding IsExpanded}" Margin="16,0,0,0">
            <TextBlock Classes="muted" Text="Reading its settings…" IsVisible="{Binding IsLoading}" />
            <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Settings}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:SettingRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <SelectableTextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <c:Badge Grid.Column="1" Text="{Binding StateText}" Kind="{Binding StateKind}" VerticalAlignment="Top" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Stretch">
    <views:DeviceSectionStatusView />
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="h3" Text="Compliance Policies" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="What a device must meet to count as compliant. One it fails comes first, open to show which check." />
        </StackPanel>
        <TextBlock Classes="muted" Text="No compliance policies apply to it." IsVisible="{Binding HasNoPolicies}" />
        <ItemsControl ItemsSource="{Binding Policies}" ItemTemplate="{StaticResource Policy}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="h3" Text="Configuration Profiles" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Settings Intune applies to it: Wi-Fi, updates, restrictions and the like." />
        </StackPanel>
        <TextBlock Classes="muted" Text="No configuration profiles apply to it." IsVisible="{Binding HasNoProfiles}" />
        <ItemsControl ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource Policy}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
