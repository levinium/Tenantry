<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:c="using:Tenantry.App.Controls"
             x:Class="Tenantry.App.Views.EditableFieldView"
             x:DataType="ed:EditableField">
  <!-- A value with an Edit button; a staged change shows under it as pending, with an undo. -->
  <StackPanel Spacing="2">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="label" Text="{Binding Caption}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="rowaction" Padding="4" IsVisible="{Binding ShowEditButton}" IsEnabled="{Binding CanEdit}"
              Command="{Binding EditCommand}" ToolTip.Tip="{Binding EditTip}" ToolTip.ShowOnDisabled="True">
        <ic:FluentIcon Icon="Edit" FontSize="14" />
      </Button>
    </Grid>
    <TextBlock Classes="value" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding !IsEditing}" />

    <!-- The whole pending chip is the Undo button, said in words. It acts on press: pressing it
         while typing ends the edit, which moves this line, and a click on release would miss it
         (it took two clicks). -->
    <Button Classes="pendingchip" IsVisible="{Binding HasPending}" HorizontalAlignment="Left" Margin="0,4,0,0"
            ClickMode="Press" Command="{Binding UnstageCommand}" ToolTip.Tip="Take this change out of Pending Changes">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="pending" VerticalAlignment="Center" />
        <Border Width="1" Background="{DynamicResource Divider}" Margin="2,2" />
        <ic:FluentIcon Icon="ArrowUndo" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Text="Undo" VerticalAlignment="Center" FontWeight="SemiBold" />
      </StackPanel>
    </Button>

    <StackPanel IsVisible="{Binding IsEditing}" Spacing="6" Margin="0,4,0,0">
      <!-- ✓ finishes, ✕ puts it back. They don't take focus (or act on release), so the box never
           loses focus first: leaving the box counts as finishing, which would beat ✕ to it. -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding IsTyped}">
        <TextBox x:Name="Editor" Text="{Binding Draft}"
                 c:EditCommit.Commit="{Binding StageCommand}" c:EditCommit.Cancel="{Binding CancelEditCommand}" />
        <Button Grid.Column="1" Classes="accent" Padding="8,6" Focusable="False" ClickMode="Press" VerticalAlignment="Stretch"
                Command="{Binding StageCommand}" ToolTip.Tip="Done: keep this change (Enter)">
          <ic:FluentIcon Icon="Checkmark" FontSize="14" />
        </Button>
        <Button Grid.Column="2" Padding="8,6" Focusable="False" ClickMode="Press" VerticalAlignment="Stretch"
                Command="{Binding CancelEditCommand}" ToolTip.Tip="Cancel: put it back as it was (Esc)">
          <ic:FluentIcon Icon="Dismiss" FontSize="14" />
        </Button>
      </Grid>
      <ComboBox x:Name="ChoiceEditor" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding HasChoices}"
                HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
      <TextBlock Classes="caption" Text="{Binding Hint}" TextWrapping="Wrap" IsVisible="{Binding HasHint}" />
      <TextBlock Classes="error" Text="{Binding Problem}" TextWrapping="Wrap"
                 IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="caption" Text="✓ or Enter adds it to Pending Changes; ✕ or Esc puts it back." IsVisible="{Binding IsTyped}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</UserControl>
