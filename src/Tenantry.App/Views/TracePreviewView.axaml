<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ms="using:Tenantry.ViewModels.MailSecurity"
             x:Class="Tenantry.App.Views.TracePreviewView"
             x:DataType="ms:TracePreviewViewModel">
  <StackPanel Spacing="14">
    <StackPanel Spacing="4">
      <TextBlock Classes="h3" Text="{Binding Subject}" TextWrapping="Wrap" />
      <TextBlock Classes="caption" Text="{Binding StatusText}" />
    </StackPanel>
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
      <TextBlock Classes="label" Text="FROM" VerticalAlignment="Center" />
      <SelectableTextBlock Grid.Column="1" Text="{Binding Sender}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Classes="label" Text="TO" VerticalAlignment="Center" />
      <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Recipient}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Classes="label" Text="RECEIVED" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReceivedText}" />
    </Grid>
    <Border Classes="divider" />
    <StackPanel Spacing="6">
      <TextBlock Classes="label" Text="WHAT HAPPENED TO IT" />
      <TextBlock Classes="muted" Text="Reading its steps…" IsVisible="{Binding IsLoading}" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ms:TraceStepRow">
            <Grid ColumnDefinitions="90,*" ColumnSpacing="10" Margin="0,4">
              <TextBlock Classes="caption" Text="{Binding When}" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Event}" FontWeight="SemiBold" />
                <SelectableTextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
