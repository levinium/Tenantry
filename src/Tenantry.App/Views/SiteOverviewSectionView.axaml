<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.SiteOverviewSectionView"
             x:DataType="rec:SiteOverviewSection">
  <UserControl.Resources>
    <DataTemplate x:Key="Fact" x:DataType="rec:SummaryLine">
      <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
        <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid ColumnDefinitions="*,360" ColumnSpacing="16" MaxWidth="1180" HorizontalAlignment="Stretch">
  <StackPanel Spacing="12">
    <Border Classes="banner neutral" IsVisible="{Binding Details.HasArchiveNote}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <ic:FluentIcon Icon="Archive" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Details.ArchiveNote}" />
      </Grid>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="Storage" />
        <TextBlock Text="{Binding StorageText}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercent}" IsVisible="{Binding HasQuota}" Height="8" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="h3" Text="Activity" />
          <TextBlock Classes="caption" Text="From Microsoft's usage report for the last 30 days (updated daily)." />
        </StackPanel>
        <views:DeviceSectionStatusView />
        <ItemsControl ItemsSource="{Binding Activity}" ItemTemplate="{StaticResource Fact}" IsVisible="{Binding HasActivity}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="Details" />
        <ItemsControl ItemsSource="{Binding Details.Facts}" ItemTemplate="{StaticResource Fact}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>

    <!-- Actions: each goes to Pending changes -->
    <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="Actions" />
        <Border Classes="banner neutral" IsVisible="{Binding !CanEdit}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ic:FluentIcon Icon="LockClosed" FontSize="16" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding EditReason}" />
          </StackPanel>
        </Border>
        <Panel IsVisible="{Binding CanEdit}">
          <views:BulkEditorView DataContext="{Binding Actions}" />
        </Panel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
