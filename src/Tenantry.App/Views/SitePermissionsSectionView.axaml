<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:c="using:Tenantry.App.Controls"
             x:Class="Tenantry.App.Views.SitePermissionsSectionView"
             x:DataType="rec:SitePermissionsSection">
  <StackPanel Spacing="12" MaxWidth="1180" HorizontalAlignment="Stretch">
    <views:DeviceSectionStatusView />
    <ItemsControl ItemsSource="{Binding Groups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="rec:SiteGroupCard">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h3" Text="{Binding Name}" />
                  <TextBlock Classes="caption" Text="{Binding Explanation}" IsVisible="{Binding HasExplanation}" TextWrapping="Wrap" />
                </StackPanel>
                <c:Badge Grid.Column="1" Text="{Binding CountText}" Kind="Neutral" VerticalAlignment="Top" />
              </Grid>
              <TextBlock Classes="muted" Text="Nobody." IsVisible="{Binding IsEmpty}" />
              <ItemsControl ItemsSource="{Binding Members}" />
              <Panel IsVisible="{Binding HasPicker}">
                <views:PersonPickerView DataContext="{Binding Picker}" MaxWidth="440" HorizontalAlignment="Left" />
              </Panel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
