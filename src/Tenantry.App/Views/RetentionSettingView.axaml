<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:ed="using:Tenantry.ViewModels.Editing"
             x:Class="Tenantry.App.Views.RetentionSettingView"
             x:DataType="rec:RetentionSettingEditor">
  <!-- What happens to content: keep, delete or both, for how long, counted from when. -->
  <StackPanel Spacing="10">
    <StackPanel Spacing="4">
      <TextBlock Classes="label" Text="WHAT HAPPENS" />
      <ListBox Classes="options" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" Background="Transparent" IsEnabled="{Binding CanChangeAction}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="ed:EditorChoice">
            <StackPanel Spacing="1" Margin="2,3">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <StackPanel Spacing="4" IsVisible="{Binding HasPeriod}">
      <TextBlock Classes="label" Text="FOR" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding Amount}" Width="90" />
        <ComboBox ItemsSource="{x:Static rec:RetentionSettingEditor.Units}" SelectedItem="{Binding Unit}" MinWidth="120">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="ed:EditorChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="counted from" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding BasedOnChoices}" SelectedItem="{Binding BasedOn}" MinWidth="220" IsEnabled="{Binding CanChangeAction}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="ed:EditorChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
