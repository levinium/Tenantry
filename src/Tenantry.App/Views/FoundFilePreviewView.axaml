<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:c="using:Tenantry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.FoundFilePreviewView"
             x:DataType="vm:FoundFilePreviewViewModel">
  <StackPanel Spacing="16">
    <StackPanel Spacing="6">
      <SelectableTextBlock Classes="h3" Text="{Binding Name}" TextWrapping="Wrap" />
      <WrapPanel ItemSpacing="6" LineSpacing="4">
        <c:Badge Text="{Binding TypeText}" Kind="Neutral" />
        <c:Badge Text="{Binding SizeText}" Kind="Neutral" />
      </WrapPanel>
    </StackPanel>
    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
      <TextBlock Classes="factname" Text="Where" />
      <SelectableTextBlock Grid.Column="1" Text="{Binding PlaceText}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Classes="factname" Text="Folder" />
      <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PathText}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Classes="factname" Text="Last Changed" />
      <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModifiedText}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="3" Classes="factname" Text="Created" />
      <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedText}" TextWrapping="Wrap" />
    </Grid>
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Classes="accent" Command="{Binding DownloadCommand}" IsEnabled="{Binding CanDownload}" ToolTip.Tip="{Binding DownloadTip}" ToolTip.ShowOnDisabled="True">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="ArrowDownload" FontSize="14" />
          <TextBlock Text="{Binding DownloadText}" />
        </StackPanel>
      </Button>
      <Button Command="{Binding OpenCommand}" IsEnabled="{Binding HasLink}" ToolTip.Tip="Open it in the browser">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="Open" FontSize="14" />
          <TextBlock Text="Open" />
        </StackPanel>
      </Button>
      <Button Command="{Binding OpenFolderCommand}" IsEnabled="{Binding HasFolder}" ToolTip.Tip="Open the folder it's in, in the browser">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="FolderOpen" FontSize="14" />
          <TextBlock Text="Open Its Folder" />
        </StackPanel>
      </Button>
      <Button Command="{Binding CopyLinkCommand}" IsEnabled="{Binding HasLink}" ToolTip.Tip="Copy its address, to send to whoever needs it">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="Copy" FontSize="14" />
          <TextBlock Text="Copy Link" />
        </StackPanel>
      </Button>
    </WrapPanel>
    <TextBlock Classes="caption" Text="Copied." IsVisible="{Binding Copied}" />
    <StackPanel Spacing="6" IsVisible="{Binding HasDownloadNote}">
      <TextBlock Classes="caption" Text="{Binding DownloadNote}" TextWrapping="Wrap" />
      <Button Command="{Binding ShowSavedCommand}" IsVisible="{Binding HasSaved}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="FolderOpen" FontSize="14" />
          <TextBlock Text="Show in Folder" />
        </StackPanel>
      </Button>
    </StackPanel>
    <TextBlock Classes="caption" TextWrapping="Wrap"
               Text="Open needs access to where it is. Download works for any place searched, even after the access added for the search was removed: you're added again just for the download. To hand files over, give the person access from the OneDrive's or site's page." />
  </StackPanel>
</UserControl>
