<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Tenantry.ViewModels.Records"
             xmlns:dir="using:Tenantry.Core.Directory"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Views.RoleSettingsSectionView"
             x:DataType="rec:RoleSettingsSection"
             x:Name="Root">
  <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Stretch">
    <views:DeviceSectionStatusView />
    <Border Classes="banner neutral" IsVisible="{Binding IsLoaded}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ic:FluentIcon Icon="Info" FontSize="16" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Each change goes to Pending changes as you make it; nothing changes until you apply them." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsLoaded}">
      <StackPanel Spacing="10" IsEnabled="{Binding CanEdit}">
        <StackPanel Spacing="2">
          <TextBlock Classes="h3" Text="Activating It" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="When someone eligible switches the role on." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption" Text="Lasts Up To" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{x:Static rec:RoleSettingsSection.ActivationChoices}" SelectedItem="{Binding MaxActivation}" MinWidth="160" />
        </StackPanel>
        <CheckBox IsChecked="{Binding ActivationMfa}" Content="Needs MFA" />
        <CheckBox IsChecked="{Binding ActivationJustification}" Content="Needs a Reason" />
        <CheckBox IsChecked="{Binding ActivationTicket}" Content="Needs a Ticket Number" />
        <CheckBox IsChecked="{Binding ApprovalRequired}" Content="Needs an Approver's Yes" />
        <StackPanel Spacing="6" Margin="28,0,0,0" IsVisible="{Binding ApprovalRequired}">
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Approvers. With none, the Privileged Role Administrators approve." />
          <ItemsControl ItemsSource="{Binding Approvers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dir:RoleApprover">
                <Border Classes="chip">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <Button Classes="chipx" Command="{Binding #Root.((rec:RoleSettingsSection)DataContext).RemoveApproverCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Take them off">
                      <ic:FluentIcon Icon="Dismiss" FontSize="11" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <views:PersonPickerView DataContext="{Binding ApproverPicker}" MaxWidth="440" HorizontalAlignment="Left" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsLoaded}">
      <StackPanel Spacing="10" IsEnabled="{Binding CanEdit}">
        <StackPanel Spacing="2">
          <TextBlock Classes="h3" Text="Giving It" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="When an admin gives someone the role." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption" Text="Eligible Assignments" VerticalAlignment="Center" Width="150" />
          <ComboBox ItemsSource="{x:Static rec:RoleSettingsSection.AssignmentChoices}" SelectedItem="{Binding EligibleMax}" MinWidth="200" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption" Text="Active Assignments" VerticalAlignment="Center" Width="150" />
          <ComboBox ItemsSource="{x:Static rec:RoleSettingsSection.AssignmentChoices}" SelectedItem="{Binding ActiveMax}" MinWidth="200" />
        </StackPanel>
        <CheckBox IsChecked="{Binding ActiveMfa}" Content="Giving It Active Needs MFA" />
        <CheckBox IsChecked="{Binding ActiveJustification}" Content="Giving It Active Needs a Reason" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
