<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tenantry.ViewModels"
             xmlns:lists="using:Tenantry.ViewModels.Lists"
             xmlns:views="using:Tenantry.App.Views"
             xmlns:conv="using:Tenantry.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Tenantry.App.Lists.DataListView"
             x:DataType="lists:DataListViewModel"
             x:Name="Root">

  <Grid ColumnDefinitions="*,Auto">
    <DockPanel Grid.Column="0" Margin="8,16,8,12" MinWidth="360">

      <!-- Title, saving the view, and the list's main action -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,3,0,0" Text="{Binding CountText}" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="SaveViewButton" Classes="outline" Classes.attention="{Binding IsModified}"
                ToolTip.Tip="Save view: keep the current filters, sort, grouping and columns as a view you can come back to">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="Save" FontSize="16" />
            <TextBlock Text="Save view" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="10" Width="320" Margin="4">
                <TextBlock Classes="h3" Text="Save as a view" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Keeps the filters, sort, grouping and columns you have now. A name you've already used is replaced." />
                <TextBox x:Name="NewViewNameBox" Text="{Binding NewViewName}" PlaceholderText="View name, e.g. Finance staff" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="Manage views…" Click="OnManageViews" />
                  <Button Classes="accent" Content="Save" Click="OnSaveView" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="2" Classes="accent"
                IsVisible="{Binding PrimaryAction, Converter={x:Static ObjectConverters.IsNotNull}}"
                IsEnabled="{Binding PrimaryAction.IsEnabled, FallbackValue=False}"
                ToolTip.Tip="{Binding PrimaryAction.Tip}" ToolTip.ShowOnDisabled="True">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="{Binding PrimaryAction.Icon, Converter={x:Static conv:IconName.Instance}}" FontSize="16" />
            <TextBlock Text="{Binding PrimaryAction.Label}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Views: one line; scrolls sideways when the window is too narrow, with the app's standard
           top scrollbar (above the chips, only when they overflow). -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,4">
        <TextBlock Classes="label" Text="VIEWS" VerticalAlignment="Top" Margin="0,7,0,0" />
        <ScrollViewer Grid.Column="1" Theme="{StaticResource TopScrollViewer}">
          <ItemsControl ItemsSource="{Binding Views}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lists:SavedViewItem">
                <Button Classes="chip" Classes.selected="{Binding IsCurrent}"
                        Command="{Binding #Root.((lists:DataListViewModel)DataContext).ApplyViewCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="Bookmark" FontSize="12" IsVisible="{Binding !IsBuiltIn}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Opacity="0.65" Text="{Binding Count}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Column="2" Classes="link" VerticalAlignment="Top" Margin="0,3,0,0" Command="{Binding OpenViewsPanelCommand}"
                Content="Manage views" ToolTip.Tip="Rename, delete or apply your saved views" />
      </Grid>

      <!-- Search: full width -->
      <TextBox DockPanel.Dock="Top" Margin="0,0,0,10" Text="{Binding SearchText}" PlaceholderText="{Binding SearchHint}">
        <TextBox.InnerLeftContent>
          <ic:FluentIcon Icon="Search" FontSize="16" Margin="10,0,2,0" Foreground="{DynamicResource TextMuted}" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <ic:FluentIcon Icon="QuestionCircle" FontSize="16" Margin="4,0,10,0" Foreground="{DynamicResource TextMuted}"
                         ToolTip.Tip="{x:Static lists:DataListViewModel.SearchHelp}" Background="Transparent" />
        </TextBox.InnerRightContent>
      </TextBox>

      <!-- Toolbar. Left: which rows and in what order (wraps when narrow). Right: how they're
           shown and output (pinned right; labels drop to icons when narrow). -->
      <Border DockPanel.Dock="Top" x:Name="Toolbar" Classes="toolbar" Margin="0,0,0,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
            <Border Classes="vsep" />
            <Button Classes="tb quiet" Classes.active="{Binding IsColumnsPanelOpen}" Command="{Binding OpenColumnsPanelCommand}"
                    ToolTip.Tip="Columns: choose which columns show, and their order">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ic:FluentIcon Icon="TableSettings" FontSize="16" />
                <TextBlock Text="Columns" />
              </StackPanel>
            </Button>
            <Button Classes="tb quiet" Classes.active="{Binding IsCompact}" Command="{Binding ToggleDensityCommand}"
                    ToolTip.Tip="{Binding DensityTip}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ic:FluentIcon Icon="RowTriple" FontSize="16" />
                <TextBlock Text="Compact" />
              </StackPanel>
            </Button>
            <Button Classes="tb quiet" Click="OnExport" ToolTip.Tip="Export: save the rows and columns shown as a CSV file (opens in Excel)">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ic:FluentIcon Icon="ArrowDownload" FontSize="16" />
                <TextBlock Text="Export" />
              </StackPanel>
            </Button>
            <Border Classes="vsep" IsVisible="{Binding HasPreview}" />
            <Button Classes="tb quiet" Classes.active="{Binding IsPreviewOpen}" IsVisible="{Binding HasPreview}"
                    Command="{Binding TogglePreviewCommand}" ToolTip.Tip="{Binding PreviewTip}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ic:FluentIcon Icon="PanelRight" FontSize="16" />
                <TextBlock Text="Preview" />
              </StackPanel>
            </Button>
          </StackPanel>

          <WrapPanel ItemSpacing="2" LineSpacing="2">
            <Button Classes="tb" Classes.active="{Binding HasFilters}" ToolTip.Tip="Filter: show only rows that match a field's values">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ic:FluentIcon Icon="Filter" FontSize="16" />
                <TextBlock Text="Filter" />
                <Border Classes="count" IsVisible="{Binding HasFilters}">
                  <TextBlock Text="{Binding FilterCount}" />
                </Border>
                <ic:FluentIcon Icon="ChevronDown" FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout ItemsSource="{Binding FilterFields}" Placement="BottomEdgeAlignedLeft">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="lists:FieldOption">
                      <Setter Property="Header" Value="{Binding Label}" />
                      <Setter Property="Command" Value="{Binding #Root.((lists:DataListViewModel)DataContext).EditFilterCommand}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="tb" Classes.active="{Binding IsBuilderOpen}" Command="{Binding ToggleBuilderCommand}"
                    ToolTip.Tip="Advanced: combine rules with all / any">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ic:FluentIcon Icon="TextBulletListSquare" FontSize="16" />
                <TextBlock Text="Advanced" />
                <ic:FluentIcon Icon="ChevronDown" FontSize="11" VerticalAlignment="Center" Opacity="0.7" IsVisible="{Binding !IsBuilderOpen}" />
                <ic:FluentIcon Icon="ChevronUp" FontSize="11" VerticalAlignment="Center" Opacity="0.7" IsVisible="{Binding IsBuilderOpen}" />
              </StackPanel>
            </Button>
            <Border Classes="vsep" />
            <Button Classes="tb" Classes.active="{Binding IsSortPanelOpen}" Command="{Binding OpenSortPanelCommand}"
                    ToolTip.Tip="Sort: order rows by one or more columns">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ic:FluentIcon Icon="ArrowSort" FontSize="16" />
                <TextBlock Text="{Binding SortSummary}" />
                <ic:FluentIcon Icon="ChevronDown" FontSize="11" VerticalAlignment="Center" Opacity="0.7" IsVisible="{Binding !IsSortPanelOpen}" />
                <ic:FluentIcon Icon="ChevronUp" FontSize="11" VerticalAlignment="Center" Opacity="0.7" IsVisible="{Binding IsSortPanelOpen}" />
              </StackPanel>
            </Button>
            <Button Classes="tb" Classes.active="{Binding IsGrouped}" ToolTip.Tip="Group: gather rows into collapsible sections">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ic:FluentIcon Icon="GroupList" FontSize="16" />
                <TextBlock Text="{Binding GroupSummary}" />
                <ic:FluentIcon Icon="ChevronDown" FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout ItemsSource="{Binding GroupOptions}" Placement="BottomEdgeAlignedLeft">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="lists:GroupOption">
                      <Setter Property="Header" Value="{Binding Label}" />
                      <Setter Property="Command" Value="{Binding #Root.((lists:DataListViewModel)DataContext).SelectGroupCommand}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </WrapPanel>
        </DockPanel>
      </Border>

      <!-- What the search box understood -->
      <TextBlock DockPanel.Dock="Top" Classes="caption" Margin="4,0,0,6" Text="{Binding SearchUnderstood}"
                 IsVisible="{Binding SearchUnderstood, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource BadgeWarningFg}" Margin="4,0,0,6" Text="{Binding SearchProblem}"
                 IsVisible="{Binding SearchProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Active filters and sorting, each removable, each with a clear-all -->
      <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="0,2,0,10" IsVisible="{Binding HasFiltersOrSort}">
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasFilters}">
          <TextBlock Classes="label" Text="FILTERED BY" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding Pills}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lists:FilterPill">
                <Border Classes="pill">
                  <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding EditCommand}" ToolTip.Tip="Change this filter">
                      <TextBlock Text="{Binding Text}" FontSize="13" />
                    </Button>
                    <Button Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this filter" Padding="4,2">
                      <ic:FluentIcon Icon="Dismiss" FontSize="12" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="link" Command="{Binding ClearFiltersCommand}" Content="Clear filters" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSort}">
          <TextBlock Classes="label" Text="SORTED BY" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding SortPills}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lists:SortPill">
                <Border Classes="pill sort">
                  <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding EditCommand}" ToolTip.Tip="Change sorting">
                      <TextBlock Text="{Binding Text}" FontSize="13" />
                    </Button>
                    <Button Command="{Binding RemoveCommand}" ToolTip.Tip="Stop sorting by this" Padding="4,2">
                      <ic:FluentIcon Icon="Dismiss" FontSize="12" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="link" Command="{Binding ClearSortCommand}" Content="Clear sorting" />
        </StackPanel>
      </WrapPanel>

      <!-- The one open panel: a filter editor -->
      <ContentControl DockPanel.Dock="Top" Margin="0,0,0,12" Content="{Binding Editor}"
                      IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="lists:ChoiceFilterEditor">
            <Border Classes="panel">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="panelicon"><ic:FluentIcon Icon="Filter" FontSize="16" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="h3" Text="{Binding Title}" />
                    <TextBlock Classes="caption" Text="Pick values, then choose whether to show only them or hide them." />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="rowaction" VerticalAlignment="Top" ToolTip.Tip="Close" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelFilterCommand}">
                    <ic:FluentIcon Icon="Dismiss" FontSize="16" />
                  </Button>
                </Grid>
                <Border Classes="segmented" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="choiceMode" IsChecked="{Binding ShowSelected}" Content="Show only these" />
                    <RadioButton Theme="{StaticResource SegmentButton}" GroupName="choiceMode" IsChecked="{Binding HideSelected}" Content="Hide these" />
                  </StackPanel>
                </Border>
                <TextBox Text="{Binding ValueSearch}" PlaceholderText="Find a value" IsVisible="{Binding HasManyValues}">
                  <TextBox.InnerLeftContent>
                    <ic:FluentIcon Icon="Search" FontSize="14" Margin="10,0,2,0" Foreground="{DynamicResource TextMuted}" />
                  </TextBox.InnerLeftContent>
                </TextBox>
                <Border Classes="listbox">
                  <ScrollViewer MaxHeight="220">
                    <ItemsControl ItemsSource="{Binding Values}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="lists:ChoiceValueOption">
                          <Border Classes="valuerow" IsVisible="{Binding IsShown}">
                            <Grid ColumnDefinitions="*,Auto">
                              <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Value}" />
                              <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Text="{Binding Count}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
                  <Button Classes="link" Command="{Binding SelectAllCommand}" Content="Select all" />
                  <Button Grid.Column="1" Classes="link" Command="{Binding SelectNoneCommand}" Content="Clear" />
                  <TextBlock Grid.Column="2" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding SelectedText}" />
                </Grid>
                <Border Classes="divider" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Button Classes="ghost" Content="Remove filter" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ClearEditorFilterCommand}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelFilterCommand}" />
                    <Button Classes="accent" Content="Apply" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ApplyFilterCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>

          <DataTemplate DataType="lists:TextFilterEditor">
            <Border Classes="panel">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="panelicon"><ic:FluentIcon Icon="Filter" FontSize="16" /></Border>
                  <TextBlock Grid.Column="1" Classes="h3" VerticalAlignment="Center" Text="{Binding Title}" />
                  <Button Grid.Column="2" Classes="rowaction" ToolTip.Tip="Close" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelFilterCommand}">
                    <ic:FluentIcon Icon="Dismiss" FontSize="16" />
                  </Button>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding Op}" MinWidth="170" />
                  <TextBox Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding NeedsValue}" PlaceholderText="Text to match" />
                </Grid>
                <Border Classes="divider" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Button Classes="ghost" Content="Remove filter" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ClearEditorFilterCommand}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelFilterCommand}" />
                    <Button Classes="accent" Content="Apply" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ApplyFilterCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>

          <DataTemplate DataType="lists:DateFilterEditor">
            <Border Classes="panel">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="panelicon"><ic:FluentIcon Icon="CalendarDate" FontSize="16" /></Border>
                  <TextBlock Grid.Column="1" Classes="h3" VerticalAlignment="Center" Text="{Binding Title}" />
                  <Button Grid.Column="2" Classes="rowaction" ToolTip.Tip="Close" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelFilterCommand}">
                    <ic:FluentIcon Icon="Dismiss" FontSize="16" />
                  </Button>
                </Grid>
                <ListBox Classes="chips" ItemsSource="{Binding Choices}" SelectedItem="{Binding Preset}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="lists:DatePreset">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsDays}">
                  <TextBox Width="90" Text="{Binding DaysText}" />
                  <TextBlock VerticalAlignment="Center" Text="days" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsRange}">
                  <CalendarDatePicker SelectedDate="{Binding From}" PlaceholderText="From" Width="170" />
                  <TextBlock VerticalAlignment="Center" Text="to" />
                  <CalendarDatePicker SelectedDate="{Binding To}" PlaceholderText="To" Width="170" />
                </StackPanel>
                <Border Classes="divider" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Button Classes="ghost" Content="Remove filter" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ClearEditorFilterCommand}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelFilterCommand}" />
                    <Button Classes="accent" Content="Apply" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ApplyFilterCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>

          <DataTemplate DataType="lists:NumberFilterEditor">
            <Border Classes="panel">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="panelicon"><ic:FluentIcon Icon="NumberSymbol" FontSize="16" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="h3" Text="{Binding Title}" />
                    <TextBlock Classes="caption" Text="Leave either box empty for no limit on that side." />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="rowaction" VerticalAlignment="Top" ToolTip.Tip="Close" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelFilterCommand}">
                    <ic:FluentIcon Icon="Dismiss" FontSize="16" />
                  </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock VerticalAlignment="Center" Text="At least" />
                  <TextBox Width="90" Text="{Binding MinText}" />
                  <TextBlock VerticalAlignment="Center" Text="and at most" />
                  <TextBox Width="90" Text="{Binding MaxText}" />
                </StackPanel>
                <Border Classes="divider" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Button Classes="ghost" Content="Remove filter" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ClearEditorFilterCommand}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelFilterCommand}" />
                    <Button Classes="accent" Content="Apply" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ApplyFilterCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <!-- Advanced filter -->
      <Border DockPanel.Dock="Top" Classes="panel wide" Margin="0,0,0,12" IsVisible="{Binding IsBuilderOpen}">
        <StackPanel Spacing="14" DataContext="{Binding Builder}" x:DataType="lists:QueryGroupViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="panelicon"><ic:FluentIcon Icon="TextBulletListSquare" FontSize="16" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="h3" Text="Advanced filter" />
              <TextBlock Classes="caption" Text="Build rules, and use a group for questions like (A or B) and C." />
            </StackPanel>
            <Button Grid.Column="2" Classes="rowaction" VerticalAlignment="Top" ToolTip.Tip="Close" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelBuilderCommand}">
              <ic:FluentIcon Icon="Dismiss" FontSize="16" />
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock VerticalAlignment="Center" Text="Show rows that match" />
            <Border Classes="segmented">
              <StackPanel Orientation="Horizontal">
                <RadioButton Theme="{StaticResource SegmentButton}" GroupName="rootJoin" IsChecked="{Binding MatchAll}" Content="All rules" />
                <RadioButton Theme="{StaticResource SegmentButton}" GroupName="rootJoin" IsChecked="{Binding MatchAny}" Content="Any rule" />
              </StackPanel>
            </Border>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Rules}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lists:QueryRuleViewModel">
                <Border Classes="levelrow">
                  <Grid ColumnDefinitions="180,200,*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}" HorizontalAlignment="Stretch" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Ops}" SelectedItem="{Binding Op}" HorizontalAlignment="Stretch" />
                    <AutoCompleteBox Grid.Column="2" Text="{Binding Value}" ItemsSource="{Binding ValueChoices}"
                                     IsVisible="{Binding NeedsValue}" PlaceholderText="{Binding ValueHint}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" />
                    <Button Grid.Column="3" Classes="rowaction" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this rule">
                      <ic:FluentIcon Icon="Dismiss" FontSize="14" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lists:QueryGroupViewModel">
                <Border Classes="groupbox">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Group: match" />
                      <Border Grid.Column="1" Classes="segmented">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Theme="{StaticResource SegmentButton}" IsChecked="{Binding MatchAll}" Content="All" />
                          <RadioButton Theme="{StaticResource SegmentButton}" IsChecked="{Binding MatchAny}" Content="Any" />
                        </StackPanel>
                      </Border>
                      <Button Grid.Column="3" Classes="link" Command="{Binding RemoveCommand}" Content="Remove group" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rules}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="lists:QueryRuleViewModel">
                          <Grid ColumnDefinitions="180,200,*,Auto" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Ops}" SelectedItem="{Binding Op}" HorizontalAlignment="Stretch" />
                            <AutoCompleteBox Grid.Column="2" Text="{Binding Value}" ItemsSource="{Binding ValueChoices}"
                                             IsVisible="{Binding NeedsValue}" PlaceholderText="{Binding ValueHint}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" />
                            <Button Grid.Column="3" Classes="rowaction" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this rule">
                              <ic:FluentIcon Icon="Dismiss" FontSize="14" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="link" HorizontalAlignment="Left" Command="{Binding AddRuleCommand}" Content="+ Add rule to group" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="divider" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Classes="link" Command="{Binding AddRuleCommand}" Content="+ Add rule" />
            <Button Grid.Column="1" Classes="link" Command="{Binding AddGroupCommand}" Content="+ Add group" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
              <Button Content="Cancel" Command="{Binding #Root.((lists:DataListViewModel)DataContext).CancelBuilderCommand}" />
              <Button Classes="accent" Content="Apply" Command="{Binding #Root.((lists:DataListViewModel)DataContext).ApplyBuilderCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Sort, like Excel's: numbered levels -->
      <Border DockPanel.Dock="Top" Classes="panel wide" Margin="0,0,0,12" IsVisible="{Binding IsSortPanelOpen}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="panelicon"><ic:FluentIcon Icon="ArrowSort" FontSize="16" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="h3" Text="Sort" />
              <TextBlock Classes="caption" Text="Rows are ordered by level 1, then level 2 where level 1 is equal, and so on." />
            </StackPanel>
            <Button Grid.Column="2" Classes="rowaction" VerticalAlignment="Top" ToolTip.Tip="Close" Command="{Binding ClosePanelsCommand}">
              <ic:FluentIcon Icon="Dismiss" FontSize="16" />
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding SortLevels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lists:SortLevelViewModel">
                <Border Classes="levelrow">
                  <Grid ColumnDefinitions="Auto,Auto,200,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                    <Border Classes="count" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Number}" />
                    </Border>
                    <TextBlock Grid.Column="1" Width="60" VerticalAlignment="Center" Classes="muted" Text="{Binding LevelText}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}" HorizontalAlignment="Stretch" />
                    <Border Grid.Column="3" Classes="segmented">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Theme="{StaticResource SegmentButton}" IsChecked="{Binding Ascending}" Content="{Binding AscendingText}" />
                        <RadioButton Theme="{StaticResource SegmentButton}" IsChecked="{Binding Descending}" Content="{Binding DescendingText}" />
                      </StackPanel>
                    </Border>
                    <Button Grid.Column="5" Classes="rowaction" ToolTip.Tip="Move up a level"
                            Command="{Binding #Root.((lists:DataListViewModel)DataContext).MoveSortLevelUpCommand}" CommandParameter="{Binding}">
                      <ic:FluentIcon Icon="ArrowUp" FontSize="14" />
                    </Button>
                    <Button Grid.Column="6" Classes="rowaction" ToolTip.Tip="Move down a level"
                            Command="{Binding #Root.((lists:DataListViewModel)DataContext).MoveSortLevelDownCommand}" CommandParameter="{Binding}">
                      <ic:FluentIcon Icon="ArrowDown" FontSize="14" />
                    </Button>
                    <Button Grid.Column="7" Classes="rowaction" ToolTip.Tip="Remove this level"
                            Command="{Binding #Root.((lists:DataListViewModel)DataContext).RemoveSortLevelCommand}" CommandParameter="{Binding}">
                      <ic:FluentIcon Icon="Dismiss" FontSize="14" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="divider" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Classes="link" Command="{Binding AddSortLevelCommand}" Content="+ Add level" />
            <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearSortCommand}" Content="Clear sorting" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
              <Button Content="Cancel" Command="{Binding ClosePanelsCommand}" />
              <Button Classes="accent" Content="Apply" Command="{Binding ApplySortCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Columns -->
      <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,12" IsVisible="{Binding IsColumnsPanelOpen}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="panelicon"><ic:FluentIcon Icon="TableSettings" FontSize="16" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="h3" Text="Columns" />
              <TextBlock Classes="caption" Text="Tick to show; arrows reorder. Widths you drag are remembered." />
            </StackPanel>
            <Button Grid.Column="2" Classes="rowaction" VerticalAlignment="Top" ToolTip.Tip="Close" Command="{Binding ClosePanelsCommand}">
              <ic:FluentIcon Icon="Dismiss" FontSize="16" />
            </Button>
          </Grid>
          <Border Classes="listbox">
            <ItemsControl ItemsSource="{Binding Columns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="lists:ColumnViewModel">
                  <Border Classes="valuerow">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <CheckBox IsChecked="{Binding IsVisible}" IsEnabled="{Binding CanHide}" Content="{Binding Header}" />
                      <Button Grid.Column="1" Classes="rowaction" ToolTip.Tip="Move left" IsEnabled="{Binding CanHide}"
                              Command="{Binding #Root.((lists:DataListViewModel)DataContext).MoveColumnUpCommand}" CommandParameter="{Binding}">
                        <ic:FluentIcon Icon="ArrowUp" FontSize="14" />
                      </Button>
                      <Button Grid.Column="2" Classes="rowaction" ToolTip.Tip="Move right" IsEnabled="{Binding CanHide}"
                              Command="{Binding #Root.((lists:DataListViewModel)DataContext).MoveColumnDownCommand}" CommandParameter="{Binding}">
                        <ic:FluentIcon Icon="ArrowDown" FontSize="14" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Border Classes="divider" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="ghost" Content="Reset to default" Command="{Binding ResetColumnsCommand}" />
            <Button Grid.Column="2" Classes="accent" Content="Done" Command="{Binding ClosePanelsCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Views -->
      <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,12" IsVisible="{Binding IsViewsPanelOpen}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="panelicon"><ic:FluentIcon Icon="BookmarkMultiple" FontSize="16" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="h3" Text="Views" />
              <TextBlock Classes="caption" Text="Built-in views can't be deleted; yours can." />
            </StackPanel>
            <Button Grid.Column="2" Classes="rowaction" VerticalAlignment="Top" ToolTip.Tip="Close" Command="{Binding ClosePanelsCommand}">
              <ic:FluentIcon Icon="Dismiss" FontSize="16" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding NewViewName}" PlaceholderText="Name for the current view" />
            <Button Grid.Column="1" Classes="accent" Command="{Binding SaveViewAsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:FluentIcon Icon="Save" FontSize="14" />
                <TextBlock Text="Save current view" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Classes="listbox">
            <ItemsControl ItemsSource="{Binding Views}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="lists:SavedViewItem">
                  <Border Classes="valuerow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                      <ic:FluentIcon Icon="Bookmark" FontSize="14" Foreground="{DynamicResource Accent}" IsVisible="{Binding !IsBuiltIn}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
                      <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Text="{Binding Count}" />
                      <Button Grid.Column="3" Classes="link" Content="Show"
                              Command="{Binding #Root.((lists:DataListViewModel)DataContext).ApplyViewCommand}" CommandParameter="{Binding}" />
                      <Button Grid.Column="4" Classes="rowaction" ToolTip.Tip="Delete this view" IsVisible="{Binding !IsBuiltIn}"
                              Command="{Binding #Root.((lists:DataListViewModel)DataContext).DeleteViewCommand}" CommandParameter="{Binding}">
                        <ic:FluentIcon Icon="Delete" FontSize="14" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock DockPanel.Dock="Top" Classes="muted" IsVisible="{Binding IsLoading}" Margin="0,0,0,8" Text="Loading…" />
      <Border DockPanel.Dock="Top" Classes="banner error" Margin="0,0,0,8" IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}">
        <SelectableTextBlock Text="{Binding LoadError}" TextWrapping="Wrap" />
      </Border>

      <!-- The table -->
      <Border Classes="card tight" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="Grid" Theme="{StaticResource TopScrollDataGrid}"
                    IsReadOnly="True" CanUserSortColumns="False" CanUserResizeColumns="True" CanUserReorderColumns="True"
                    FrozenColumnCount="2" SelectionMode="Single" />
          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ic:FluentIcon Icon="Search" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Classes="muted" HorizontalAlignment="Center" Text="Nothing matches these filters." />
            <Button HorizontalAlignment="Center" Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasFilters}" />
          </StackPanel>
        </Grid>
      </Border>
    </DockPanel>

    <!-- Preview pane: its width follows the window (see code-behind) -->
    <Border Grid.Column="1" x:Name="PreviewPane" Classes="card" Width="420" Margin="4,16,8,12" Padding="0" IsVisible="{Binding IsPreviewOpen}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="16,12,8,8">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="PREVIEW" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding ExpandPreviewCommand}" IsEnabled="{Binding HasPreviewContent}" ToolTip.Tip="Open the full record in a tab">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="ArrowMaximize" FontSize="14" />
              <TextBlock Text="Open full record" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="rowaction" Command="{Binding ClosePreviewCommand}" ToolTip.Tip="Close the preview">
            <ic:FluentIcon Icon="Dismiss" FontSize="14" />
          </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Classes="divider" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="16,24" TextWrapping="Wrap" IsVisible="{Binding !HasPreviewContent}"
                   Text="Select a row to see its details here." />
        <ScrollViewer>
          <ContentControl Content="{Binding PreviewModel}" Margin="16,12">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:UserDetailViewModel">
                <views:UserPreviewView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
